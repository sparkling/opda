{
  "name": "opda-kb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "description": "OPDA Knowledge Base — Astro shell over a static HTML/CSS/JS docs site for the Property Data Trust Framework.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:bare": "astro dev",
    "start": "node scripts/dev.mjs",
    "build": "pnpm run css && astro build --force",
    "build:data": "node scripts/build-with-data.mjs",
    "serve:data": "node scripts/build-with-data.mjs --serve",
    "api": "FUSEKI_ENDPOINT=http://localhost:3031/opda/sparql node --watch src/api/server.js",
    "jena:load": "node scripts/fuseki-load.mjs --clear",
    "ontology:model": "node scripts/ontology-model.mjs",
    "ontology:graph": "node scripts/ontology-graph.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "css": "node scripts/version-design-system.mjs && tailwindcss -i src/styles/global.css -o public/ui/tailwind.built.css --minify",
    "css:watch": "tailwindcss -i src/styles/global.css -o public/ui/tailwind.built.css --watch",
    "check:design-system": "node scripts/version-design-system.mjs --check",
    "tailwindplus:download": "bash scripts/tailwindplus-download.sh",
    "test": "node --test tests/lib/remark/*.test.mjs tests/astro-content-runtime.test.mjs tests/design-system-contract.test.mjs tests/design-system-table-contract.test.mjs tests/site-standard-naming.test.mjs tests/site-information-architecture.test.mjs tests/site-route-retirement-contract.test.mjs tests/section-navigation.test.mjs tests/semantic-modelling-docs.test.mjs tests/semantic-modelling-route-migration.test.mjs tests/dbt-smart-data-terminology.test.mjs tests/grlc-handler.test.mjs tests/mermaid-property-layers.test.mjs tests/property-pack-catalogue.test.mjs tests/property-pack-calibration.test.mjs tests/property-pack-candidate.test.mjs tests/postmark-invitation-wave.test.mjs tests/property-pack-model-docs.test.mjs tests/property-pack-route-migration.test.mjs tests/pdtf1-route-migration.test.mjs tests/pdtf-schema-input-route-migration.test.mjs tests/ia-pdtf1-source-receipts.test.mjs tests/property-pack-preservation.test.mjs tests/ontology-case-collision.test.mjs tests/working-group-interest.test.mjs tests/aws-working-group-interest-infrastructure.test.mjs tests/auth-session.test.mjs tests/working-group-signup-pages.test.mjs tests/trade-body-outreach-assets.test.mjs tests/working-group-inbox-agent.test.mjs tests/prefixed-preview.test.mjs tests/ontology-publication-assets.test.mjs",
    "preview:v3": "node scripts/build-prefixed-preview.mjs --input dist --output dist-preview/v3 --prefix /v3",
    "calibration": "node scripts/property-pack-calibration.mjs",
    "property-pack:generate": "python3 scripts/property_pack_catalogue.py generate",
    "property-pack:check": "python3 scripts/property_pack_catalogue.py check",
    "property-pack:candidate:generate": "python3 scripts/property_pack_candidate.py generate",
    "property-pack:candidate:validate": "python3 scripts/property_pack_candidate.py validate",
    "property-pack:candidate:check": "python3 scripts/property_pack_candidate.py check",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:smoke": "playwright test --config=playwright.config.mjs tests/e2e/smoke.spec.mjs",
    "test:a11y": "playwright test --config=playwright.config.mjs tests/e2e/accessibility.spec.mjs",
    "test:visual": "playwright test --config=playwright.config.mjs tests/e2e/visual.spec.mjs",
    "check:routes": "node scripts/crawl-routes.mjs",
    "check:resource-links": "node scripts/check-resource-link-coverage.mjs",
    "check:ia-preservation": "node scripts/check-ia-preservation.mjs",
    "docs:spdtf-ia": "node scripts/generate-spdtf-ia-html.mjs",
    "check:spdtf-ia": "node scripts/generate-spdtf-ia-html.mjs --check",
    "test:schema": "python3 -m unittest tests/test_schema_reproducibility.py",
    "check:schema-drift": "SOURCE_DATE_EPOCH=1783296000 node scripts/check-schema-reproducibility.mjs",
    "clean": "rm -rf dist .astro",
    "resources:manifest": "node scripts/resources-manifest.mjs",
    "notebooklm:prepare": "node scripts/build-notebooklm-prepared-sources.mjs",
    "notebooklm:prepare:complete": "node scripts/build-notebooklm-complete-corpus.mjs",
    "notebooklm:execute": "node scripts/run-notebooklm-preparation.mjs",
    "publish:resources": "bash scripts/publish-resources.sh",
    "deploy": "bash deploy.sh",
    "deploy:ci": "git push origin main"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.37.0",
    "@mermaid-js/layout-elk": "^0.2.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tailwindplus/elements": "1.0.22",
    "artalk": "^2.9.1",
    "astro": "^7.2.4",
    "express": "5.2.1",
    "mermaid": "^11.16.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "^4.3.2",
    "jiti": "^2.7.0",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.4",
    "parse5": "7.3.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
