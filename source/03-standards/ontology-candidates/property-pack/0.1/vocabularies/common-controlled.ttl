<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme>
  a skos:ConceptScheme ;
  skos:prefLabel "response status"@en ;
  skos:definition "Controlled responses used when a Property Pack source question records applicability, knowledge or a future connection state."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/common> ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme/concept/yes>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme> ;
  skos:prefLabel "Yes"@en ;
  skos:notation "Yes" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme/concept/no>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme> ;
  skos:prefLabel "No"@en ;
  skos:notation "No" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme/concept/not-known>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme> ;
  skos:prefLabel "Not known"@en ;
  skos:notation "Not known" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme/concept/not-applicable>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme> ;
  skos:prefLabel "Not applicable"@en ;
  skos:notation "Not applicable" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme/concept/to-be-connected>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme> ;
  skos:prefLabel "To be connected"@en ;
  skos:notation "To be connected" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme/concept/no-mortgage>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/common/vocabulary/ResponseStatusScheme> ;
  skos:prefLabel "No mortgage"@en ;
  skos:notation "No mortgage" .
