<https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme>
  a skos:ConceptScheme ;
  skos:prefLabel "broadband connection type"@en ;
  skos:definition "A broadband access technology stated as available at a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-technology> ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme/concept/none>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme> ;
  skos:prefLabel "None"@en ;
  skos:notation "None" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme/concept/adsl>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme> ;
  skos:prefLabel "ADSL copper wire"@en ;
  skos:notation "ADSL copper wire" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme/concept/cable>
  a skos:Concept ;
  skos:inScheme <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme> ;
  skos:prefLabel "Cable"@en ;
  skos:notation "Cable" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme/concept/fttc>
  a skos:Concept ;
