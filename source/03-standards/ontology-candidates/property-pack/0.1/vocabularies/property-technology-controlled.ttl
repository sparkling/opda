  skos:prefLabel "FTTC"@en ;
  skos:notation "FTTC (Fibre to the Cabinet)" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-technology/vocabulary/BroadbandConnectionTypeScheme/concept/fttp>
