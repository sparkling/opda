VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/Property>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasLegalStatement> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/LegalStatement> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasOwnershipInterest> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/OwnershipInterest> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasRegisteredTitle> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisteredTitle> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/Attestation>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/Attestation> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/attestationType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/attestedOutcome> ; sh:datatype <http://www.w3.org/2001/XMLSchema#boolean> ; sh:maxCount 1 ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/FixtureItem>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureItem> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/fixtureCategory> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/fixtureLocation> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/fixtureName> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/inclusionStatus> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/FixtureSchedule>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureSchedule> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasFixtureItem> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureItem> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/Lease>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/Lease> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/leaseDate> ; sh:datatype <http://www.w3.org/2001/XMLSchema#date> ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/leaseTerm> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxCount 1 ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/LegalParty>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/LegalParty> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/legalPartyName> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/LegalStatement>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/LegalStatement> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/statementOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/statementType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/OwnershipInterest>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/OwnershipInterest> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/ownershipType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/RegisterEntry>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisterEntry> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/entryNumber> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/entryText> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxCount 1 ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/RegisterExtract>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisterExtract> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/editionDate> ; sh:datatype <http://www.w3.org/2001/XMLSchema#date> ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasRegisterEntry> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisterEntry> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasRegisterIndicator> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisterIndicator> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/officialCopyDateTime> ; sh:datatype <http://www.w3.org/2001/XMLSchema#dateTime> ; sh:maxCount 1 ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/RegisterIndicator>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisterIndicator> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/indicatorPresent> ; sh:datatype <http://www.w3.org/2001/XMLSchema#boolean> ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/indicatorType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/RegisteredTitle>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisteredTitle> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasRegisterExtract> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/RegisterExtract> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasTitleAttribute> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/TitleAttributeStatement> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/titleNumber> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxCount 1 ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/conveyancing/TitleAttributeStatement>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/TitleAttributeStatement> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/titleAttributeType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/titleAttributeValue> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxCount 1 ] .
