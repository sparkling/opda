<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/PlanningApplication>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/PlanningApplication> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/applicationDate> ; sh:datatype <http://www.w3.org/2001/XMLSchema#date> ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/applicationReference> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/applicationType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/Search>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Search> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasSearchFinding> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/SearchFinding> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/SearchFinding>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/SearchFinding> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/findingDescription> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/findingOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/findingType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/UtilityServiceRecord>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/serviceCharge> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/serviceProviderName> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/supportingMap> ; sh:class <http://purl.org/dc/terms/PhysicalResource> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/utilityOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/utilityTopic> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .
