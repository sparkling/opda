VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/Property>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasAddress> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Address> ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasCouncilTaxAssessment> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/CouncilTaxAssessment> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasDesignation> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Designation> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasEnergyPerformanceCertificate> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnergyPerformanceCertificate> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasEnvironmentalAssessment> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnvironmentalAssessment> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasLocalLandCharge> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/LocalLandCharge> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasParkingCondition> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/ParkingCondition> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasPlanningApplication> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/PlanningApplication> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasUtilityServiceRecord> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/Address>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Address> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/addressLine1> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/postcode> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:minCount 1 ; sh:maxCount 1 ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/CouncilTaxAssessment>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/CouncilTaxAssessment> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/councilTaxBand> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/Designation>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Designation> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/designationOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/designationType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/EnergyPerformanceCertificate>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnergyPerformanceCertificate> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/certificateAddress> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/certificateSupplyStatus> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/certificateUprn> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/energyRating> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/EnvironmentalAssessment>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnvironmentalAssessment> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/environmentalTopic> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/riskLevel> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/LocalLandCharge>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/LocalLandCharge> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/chargeReference> ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/registrationDate> ; sh:datatype <http://www.w3.org/2001/XMLSchema#date> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-data-services/ParkingCondition>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/ParkingCondition> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/parkingOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
