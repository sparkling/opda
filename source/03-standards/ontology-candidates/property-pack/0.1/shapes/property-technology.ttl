VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-technology/Property>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/hasConnectivityService> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/ConnectivityService> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/hasDigitalPropertyLogbook> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/DigitalPropertyLogbook> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/hasSmartHomeCapability> ; sh:class <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/SmartHomeCapability> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-technology/ConnectivityService>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/ConnectivityService> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/connectivityOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/connectivityType> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-technology/DigitalPropertyLogbook>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/DigitalPropertyLogbook> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/logbookAvailable> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .

<https://w3id.org/opda/candidate/property-pack/0.1/shape/property-technology/SmartHomeCapability>
  a sh:NodeShape ;
  sh:targetClass <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/SmartHomeCapability> ;
  sh:property [ sh:path <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/smartHomeOutcome> ; sh:class <http://www.w3.org/2004/02/skos/core#Concept> ] .
