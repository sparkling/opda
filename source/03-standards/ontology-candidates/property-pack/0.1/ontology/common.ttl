VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/ontology/common>
  a owl:Ontology ;
  rdfs:label "Common boundary candidate ontology"@en ;
  dcterms:description "A deliberately small exchange boundary for stable identity and meaning genuinely shared by several property domains."@en ;
  owl:versionInfo "0.1.0-draft" ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/common/Property>
  a owl:Class ;
  rdfs:label "Property"@en ;
  skos:definition "An identifiable unit of land, buildings or both that persists independently of any particular address, transaction or domain view."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/common> ;
  opdac:sourceItemCount "202"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  opdac:identityCriterion "Candidate identity is continuity of the unit associated with the same assigned UPRN; lifecycle rules remain for working-group review."@en .

<https://w3id.org/opda/candidate/property-pack/0.1/common/uprn>
  a owl:DatatypeProperty ;
  rdfs:label "Unique Property Reference Number"@en ;
  skos:definition "The reference assigned to a property in the national address gazetteer and used as a non-arithmetic identifier."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/common> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#string> .
