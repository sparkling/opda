<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/titleNumber>
  a owl:DatatypeProperty ;
  rdfs:label "title number"@en ;
  skos:definition "The identifier assigned to a registered title by the land registration authority."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
