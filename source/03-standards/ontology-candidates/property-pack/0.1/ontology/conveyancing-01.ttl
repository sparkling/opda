  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureItem> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/fixtureLocation>
  a owl:ObjectProperty ;
  rdfs:label "fixture location"@en ;
  skos:definition "Classifies the room or area associated with a fixture or fitting item."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
  opdac:sourceItemCount "108"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureItem> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/fixtureName>
  a owl:DatatypeProperty ;
  rdfs:label "fixture name"@en ;
  skos:definition "The name stated for a fixture or fitting that is not represented by a predefined category."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
  opdac:sourceItemCount "8"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureItem> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#string> .

<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasAttestation>
  a owl:ObjectProperty ;
  rdfs:label "has attestation"@en ;
  skos:definition "Relates a Property Pack to an attestation made by an accountable party."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
  opdac:sourceItemCount "4"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/Attestation> .

<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasFixtureItem>
  a owl:ObjectProperty ;
  rdfs:label "has fixture item"@en ;
  skos:definition "Relates a fixtures and fittings schedule to an item entry."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
  opdac:sourceItemCount "108"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureSchedule> ;
