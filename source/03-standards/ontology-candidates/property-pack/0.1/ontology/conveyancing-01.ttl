<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasFixtureSchedule>
  a owl:ObjectProperty ;
  rdfs:label "has fixtures and fittings schedule"@en ;
  skos:definition "Relates a property transaction to its fixtures and fittings schedule."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
  opdac:sourceItemCount "100"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/FixtureSchedule> .

<https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/hasLease>
  a owl:ObjectProperty ;
  rdfs:label "has lease"@en ;
  skos:definition "Relates a registered title or entry to a lease that it records."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing> ;
