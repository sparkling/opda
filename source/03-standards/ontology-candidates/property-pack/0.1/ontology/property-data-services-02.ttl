@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/ontology/property-data-services>
  a owl:Ontology ;
  rdfs:label "Property data services candidate ontology (part 2 of 2)"@en ;
  dcterms:description "Authoritative and derived property information supplied through searches, registers, certificates and utility records."@en ;
  owl:versionInfo "0.1.0-draft" ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasEnvironmentalAssessment>
  a owl:ObjectProperty ;
  rdfs:label "has environmental assessment"@en ;
  skos:definition "Relates a property to an environmental assessment."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "9"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnvironmentalAssessment> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasLocalLandCharge>
  a owl:ObjectProperty ;
  rdfs:label "has local land charge"@en ;
  skos:definition "Relates a property to a local land charge that affects it."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "3"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/LocalLandCharge> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasParkingCondition>
  a owl:ObjectProperty ;
  rdfs:label "has parking condition"@en ;
  skos:definition "Relates a property to a parking condition."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "5"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/ParkingCondition> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasPlanningApplication>
  a owl:ObjectProperty ;
  rdfs:label "has planning application"@en ;
  skos:definition "Relates a property to a planning application that affects it."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "61"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/PlanningApplication> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasSearchFinding>
  a owl:ObjectProperty ;
  rdfs:label "has search finding"@en ;
  skos:definition "Relates a search to one of its typed findings."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "84"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Search> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/SearchFinding> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/hasUtilityServiceRecord>
  a owl:ObjectProperty ;
  rdfs:label "has utility service record"@en ;
  skos:definition "Relates a property to a utility service record."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/parkingOutcome>
  a owl:ObjectProperty ;
  rdfs:label "parking outcome"@en ;
  skos:definition "Records the controlled response or status for a parking topic."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "5"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/ParkingCondition> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/parkingTopic>
  a owl:ObjectProperty ;
  rdfs:label "parking topic"@en ;
  skos:definition "Classifies the parking facility or restriction described."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "5"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/ParkingCondition> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/postcode>
  a owl:DatatypeProperty ;
  rdfs:label "postcode"@en ;
  skos:definition "The postal code recorded as part of an address."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Address> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#string> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/registrationDate>
  a owl:DatatypeProperty ;
  rdfs:label "registration date"@en ;
  skos:definition "The date on which a local land charge was registered."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "3"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/LocalLandCharge> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#date> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/riskLevel>
  a owl:ObjectProperty ;
  rdfs:label "risk level"@en ;
  skos:definition "Records a controlled risk level assigned by an assessment."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "9"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnvironmentalAssessment> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/serviceCharge>
  a owl:DatatypeProperty ;
  rdfs:label "service charge"@en ;
  skos:definition "A charge or charging basis stated for a utility service."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#string> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/serviceProviderName>
  a owl:DatatypeProperty ;
  rdfs:label "service provider name"@en ;
  skos:definition "The name stated for a utility service provider."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#string> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/supportingMap>
  a owl:ObjectProperty ;
  rdfs:label "supporting map"@en ;
  skos:definition "Relates a utility service record to an attached map or map extract."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> ;
  rdfs:range <http://purl.org/dc/terms/PhysicalResource> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/utilityOutcome>
  a owl:ObjectProperty ;
  rdfs:label "utility outcome"@en ;
  skos:definition "Records the controlled response or status stated for a utility topic."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/utilityTopic>
  a owl:ObjectProperty ;
  rdfs:label "utility topic"@en ;
  skos:definition "Classifies the service or utility question addressed by a record."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
