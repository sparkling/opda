<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/addressLine1>
  a owl:DatatypeProperty ;
  rdfs:label "address line 1"@en ;
  skos:definition "The first textual line of a structured address."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Address> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#string> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/applicationDate>
  a owl:DatatypeProperty ;
  rdfs:label "application date"@en ;
  skos:definition "The date associated with submission or registration of a planning application."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "61"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/PlanningApplication> ;
