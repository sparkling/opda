<https://w3id.org/opda/candidate/property-pack/0.1/ontology/property-data-services>
  a owl:Ontology ;
  rdfs:label "Property data services candidate ontology (part 1 of 2)"@en ;
  dcterms:description "Authoritative and derived property information supplied through searches, registers, certificates and utility records."@en ;
  owl:versionInfo "0.1.0-draft" ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Address>
  a owl:Class ;
  rdfs:label "address"@en ;
  skos:definition "A structured, mutable address description associated with a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "2"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  opdac:identityCriterion "This candidate gives Address structural identity from its components; an authoritative address identifier remains unresolved."@en .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/CouncilTaxAssessment>
  a owl:Class ;
  rdfs:label "council tax assessment"@en ;
  skos:definition "A local-tax banding and related status recorded for a domestic property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "2"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Designation>
  a owl:Class ;
  rdfs:label "designation"@en ;
  skos:definition "A statutory listing, conservation or protection designation affecting a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "3"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnergyPerformanceCertificate>
  a owl:Class ;
  rdfs:label "energy performance certificate"@en ;
  skos:definition "A certificate recording an assessed energy performance rating for a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "4"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/EnvironmentalAssessment>
  a owl:Class ;
  rdfs:label "environmental assessment"@en ;
  skos:definition "A typed assessment of an environmental condition or risk affecting a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "9"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord>
  a owl:Class ;
  rdfs:label "property information record"@en ;
  skos:definition "An evidence-bearing record supplied by a property-data service about a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "195"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/LocalLandCharge>
  a owl:Class ;
  rdfs:label "local land charge"@en ;
  skos:definition "A charge or restriction registered as a local land charge against land."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "3"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  opdac:identityCriterion "Identified by the competent authority and its charge reference."@en ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/ParkingCondition>
  a owl:Class ;
  rdfs:label "parking condition"@en ;
  skos:definition "A typed parking control, facility or restriction associated with a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "5"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/PlanningApplication>
  a owl:Class ;
  rdfs:label "planning application"@en ;
  skos:definition "An application for planning permission or another planning decision recorded by a competent authority."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "61"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  opdac:identityCriterion "Identified by the issuing authority and its application reference number."@en ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/Search>
  a owl:Class ;
  rdfs:label "search"@en ;
  skos:definition "A search performed by or through an information authority for matters affecting a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "84"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/InformationRecord> .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/SearchFinding>
  a owl:Class ;
  rdfs:label "search finding"@en ;
  skos:definition "A typed finding returned by a property or local-authority search."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "98"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/UtilityServiceRecord>
  a owl:Class ;
  rdfs:label "utility service record"@en ;
  skos:definition "A record describing provision, infrastructure, charging or evidence for a utility service at a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services> ;
  opdac:sourceItemCount "24"^^xsd:integer ;
