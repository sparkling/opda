VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/ontology/surveying-and-valuation>
  a owl:Ontology ;
  rdfs:label "Surveying and valuation candidate ontology"@en ;
  dcterms:description "Physical construction, condition, alteration and installed-feature meanings used to inspect and value property."@en ;
  owl:versionInfo "0.1.0-draft" ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/AlterationStatement>
  a owl:Class ;
  rdfs:label "alteration statement"@en ;
  skos:definition "A statement about physical works, alteration, conversion or change of use."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "7"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/ConditionStatement>
  a owl:Class ;
  rdfs:label "condition statement"@en ;
  skos:definition "A statement about damage, defect, hazard, treatment or another property condition."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "5"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/ConstructionStatement>
  a owl:Class ;
  rdfs:label "construction statement"@en ;
  skos:definition "A statement about construction form, material, safety or access."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "4"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/ElectricalStatement>
  a owl:Class ;
  rdfs:label "electrical statement"@en ;
  skos:definition "A statement about electrical works, testing or electricity installations."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "2"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/EnergyInstallationStatement>
  a owl:Class ;
  rdfs:label "energy installation statement"@en ;
  skos:definition "A statement about heating, energy-generation or energy-efficiency installations at a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "5"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:subClassOf <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement>
  a owl:Class ;
  rdfs:label "physical feature statement"@en ;
  skos:definition "A typed observation or disclosure about construction, condition, alterations or installed features."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "23"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PropertyDescription>
  a owl:Class ;
  rdfs:label "property description"@en ;
  skos:definition "A surveying view describing the physical form and type of a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "3"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/builtForm>
  a owl:ObjectProperty ;
  rdfs:label "built form"@en ;
  skos:definition "Classifies how the principal building adjoins or stands relative to neighbouring buildings."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PropertyDescription> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/featureOutcome>
  a owl:ObjectProperty ;
  rdfs:label "feature outcome"@en ;
  skos:definition "Records the controlled response or status asserted for a physical feature."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "22"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/featureType>
  a owl:ObjectProperty ;
  rdfs:label "feature type"@en ;
  skos:definition "Classifies the construction, condition, alteration or installed feature addressed by a statement."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "22"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/floorplanAvailable>
  a owl:DatatypeProperty ;
  rdfs:label "floorplan available"@en ;
  skos:definition "States whether a floorplan is supplied for the property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PropertyDescription> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#boolean> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/hasPhysicalFeatureStatement>
  a owl:ObjectProperty ;
  rdfs:label "has physical feature statement"@en ;
  skos:definition "Relates a property to a statement about one of its physical features or conditions."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "23"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PhysicalFeatureStatement> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/hasPropertyDescription>
  a owl:ObjectProperty ;
  rdfs:label "has property description"@en ;
  skos:definition "Relates a property to a physical description used in surveying and valuation."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "3"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/common/Property> ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PropertyDescription> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/heatingType>
  a owl:ObjectProperty ;
  rdfs:label "heating type"@en ;
  skos:definition "Classifies the principal heating arrangement at a property."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/EnergyInstallationStatement> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .

<https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/propertyType>
  a owl:ObjectProperty ;
  rdfs:label "property type"@en ;
  skos:definition "Classifies the physical residential property type."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/PropertyDescription> ;
  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .
