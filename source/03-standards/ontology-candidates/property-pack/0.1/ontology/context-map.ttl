VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

opdac:semanticHome
  a owl:AnnotationProperty ;
  rdfs:label "semantic home"@en .

opdac:sourceItemCount
  a owl:AnnotationProperty ;
  rdfs:label "source item count"@en .

opdac:candidateStatus
  a owl:AnnotationProperty ;
  rdfs:label "candidate status"@en .

opdac:identityCriterion
  a owl:AnnotationProperty ;
  rdfs:label "identity criterion"@en .

<https://w3id.org/opda/candidate/property-pack/0.1/context/common>
  a skos:Concept ;
  skos:prefLabel "Common boundary"@en ;
  skos:definition "A deliberately small exchange boundary for stable identity and meaning genuinely shared by several property domains."@en ;
  opdac:contextKind "common-boundary" .

<https://w3id.org/opda/candidate/property-pack/0.1/context/conveyancing>
  a skos:Concept ;
  skos:prefLabel "Conveyancing"@en ;
  skos:definition "Legal title, ownership, rights, disclosure, completion and transfer meanings used in conveyancing."@en ;
  opdac:contextKind "bounded-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .

<https://w3id.org/opda/candidate/property-pack/0.1/context/dbt-smart-data>
  a skos:Concept ;
  skos:prefLabel "DBT Smart Data"@en ;
  skos:definition "Scheme-level authorisation and controlled sharing meanings that apply across participating sectors."@en ;
  opdac:contextKind "scheme-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .

<https://w3id.org/opda/candidate/property-pack/0.1/context/estate-agency>
  a skos:Concept ;
  skos:prefLabel "Estate agency"@en ;
  skos:definition "Marketing, pricing, letting, media and consumer disclosure meanings used in estate agency."@en ;
  opdac:contextKind "bounded-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .

<https://w3id.org/opda/candidate/property-pack/0.1/context/finance-and-banking>
  a skos:Concept ;
  skos:prefLabel "Finance and banking"@en ;
  skos:definition "Mortgage, repayment, insurance and financial-obligation meanings used by lenders and advisers."@en ;
  opdac:contextKind "bounded-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .

<https://w3id.org/opda/candidate/property-pack/0.1/context/property-data-services>
  a skos:Concept ;
  skos:prefLabel "Property data services"@en ;
  skos:definition "Authoritative and derived property information supplied through searches, registers, certificates and utility records."@en ;
  opdac:contextKind "bounded-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .

<https://w3id.org/opda/candidate/property-pack/0.1/context/property-technology>
  a skos:Concept ;
  skos:prefLabel "Property technology"@en ;
  skos:definition "Digital property records, smart-home capabilities and connectivity meanings used by property technology."@en ;
  opdac:contextKind "bounded-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .

<https://w3id.org/opda/candidate/property-pack/0.1/context/surveying-and-valuation>
  a skos:Concept ;
  skos:prefLabel "Surveying and valuation"@en ;
  skos:definition "Physical construction, condition, alteration and installed-feature meanings used to inspect and value property."@en ;
  opdac:contextKind "bounded-context" ;
  opdac:interoperatesThrough <https://w3id.org/opda/candidate/property-pack/0.1/context/common> .
