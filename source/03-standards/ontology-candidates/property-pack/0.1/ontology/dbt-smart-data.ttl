VERSION "1.2-basic"

@prefix common: <https://w3id.org/opda/candidate/property-pack/0.1/common/> .
@prefix conv: <https://w3id.org/opda/candidate/property-pack/0.1/conveyancing/> .
@prefix dbt: <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ea: <https://w3id.org/opda/candidate/property-pack/0.1/estate-agency/> .
@prefix fb: <https://w3id.org/opda/candidate/property-pack/0.1/finance-and-banking/> .
@prefix opdac: <https://w3id.org/opda/candidate/property-pack/0.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pds: <https://w3id.org/opda/candidate/property-pack/0.1/property-data-services/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pt: <https://w3id.org/opda/candidate/property-pack/0.1/property-technology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sv: <https://w3id.org/opda/candidate/property-pack/0.1/surveying-and-valuation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opda/candidate/property-pack/0.1/ontology/dbt-smart-data>
  a owl:Ontology ;
  rdfs:label "DBT Smart Data candidate ontology"@en ;
  dcterms:description "Scheme-level authorisation and controlled sharing meanings that apply across participating sectors."@en ;
  owl:versionInfo "0.1.0-draft" ;
  opdac:candidateStatus "machine-proposed" .

<https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/DataSharingAuthorisation>
  a owl:Class ;
  rdfs:label "data sharing authorisation"@en ;
  skos:definition "A scheme-level authorisation to share specified property information for an agreed purpose."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/dbt-smart-data> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  opdac:identityCriterion "Identified by accountable party, scope, purpose and authorisation event; these details remain outside the initial boolean source field."@en .

<https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/authorisedToShare>
  a owl:DatatypeProperty ;
  rdfs:label "authorised to share"@en ;
  skos:definition "States that the accountable party has authorised the scoped information to be shared."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/dbt-smart-data> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:domain <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/DataSharingAuthorisation> ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#boolean> .

<https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/hasDataSharingAuthorisation>
  a owl:ObjectProperty ;
  rdfs:label "has data sharing authorisation"@en ;
  skos:definition "Relates a Property Pack submission to its scheme-level sharing authorisation."@en ;
  opdac:semanticHome <https://w3id.org/opda/candidate/property-pack/0.1/context/dbt-smart-data> ;
  opdac:sourceItemCount "1"^^xsd:integer ;
  opdac:candidateStatus "machine-proposed" ;
  rdfs:range <https://w3id.org/opda/candidate/property-pack/0.1/dbt-smart-data/DataSharingAuthorisation> .
