{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Open Property Data Association",
    "websiteUrl": "https://opda.org.uk/",
    "privacyUrl": "https://opda.org.uk/join/privacy/",
    "termsOfUseUrl": "https://opda.org.uk/governance/opda-rules/"
  },
  "name": {
    "short": "OPDA Signups",
    "full": "OPDA working-group signups and approvals"
  },
  "description": {
    "short": "New working-group signups, with per-group approval.",
    "full": "Posts one card per new working-group signup from opda.org.uk into the Signups channel of the OPDA management team, with Approve and Reject for each requested group. Decisions are recorded against the verified Teams identity of the approver and mirrored to the CRM (ADR-0088)."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#1C2B45",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["team"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity"],
  "validDomains": []
}
