---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="The requested OPDA Knowledge Base page could not be found."
  hideSidebar={true}
  hideBreadcrumbs={true}
  hideFooter={true}
  hideComments={true}
  wrapArticle={false}
  mainClass="not-found-page"
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="overline">Error 404</p>
    <h1 id="not-found-title">Page not found</h1>
    <p>The page may have moved, changed name or never existed.</p>
    <nav class="actions" aria-label="Continue browsing">
      <a class="btn" href="/home">Back to home</a>
      <a class="btn btn--ghost" href="/governance">Governance</a>
      <a class="btn btn--ghost" href="/pdtf-1/extracted-ontology/lineage-provenance-and-verification/historical-modelling">Modelling</a>
    </nav>
  </section>
</Layout>
