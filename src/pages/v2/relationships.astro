---
import V2Contents from '@/components/v2/V2Contents.astro';
import V2Filter from '@/components/v2/V2Filter.astro';
import V2Page from '@/components/v2/V2Page.astro';
import {
  compactIri,
  contexts,
  contextById,
  counts,
  resourceByIri,
  resourceRoute,
  resources,
} from '@/lib/v2-model.mjs';

const objectProperties = resources.filter((resource) => resource.kind === 'object-property');
const datatypeProperties = resources.filter((resource) => resource.kind === 'datatype-property');
const subclasses = resources.filter((resource) => resource.subclass_of);
const domainless = objectProperties.filter((resource) => !resource.domain);
const contextOptions = contexts.map((context) => ({ value: context.id, label: context.label }));

function endpoint(iri) {
  return iri ? resourceByIri.get(iri) : undefined;
}
---
<V2Page
  title="Relationships"
  description="Complete structured relationship reference for object properties, datatype properties and subclass assertions in the V2 candidate."
  category="Meaning & constraints"
  crumbs={[{ label: 'Relationships' }]}
>
  <h1>Relationships</h1>
  <p class="lead">
    The graph structure in a precise, accessible form: {counts.objectProperties} object
    properties, {counts.datatypeProperties} datatype properties and {counts.subclassEdges}
    asserted subclass links.
  </p>

  <V2Contents items={[
    { id: 'object-properties', label: 'Object properties' },
    { id: 'unresolved-domains', label: 'Domains not yet specified' },
    { id: 'datatype-properties', label: 'Datatype properties' },
    { id: 'class-hierarchy', label: 'Class hierarchy' },
    { id: 'cross-context', label: 'Cross-context status' },
  ]} />

  <h2 id="object-properties">Object properties ({objectProperties.length})</h2>
  <V2Filter targetId="v2-object-properties" placeholder="Search relationship labels and identifiers…" contextOptions={contextOptions} />
  <div class="v2-table-wrap" id="v2-object-properties">
    <table>
      <thead><tr><th>Domain</th><th>Object property</th><th>Range</th><th>Semantic home</th></tr></thead>
      <tbody>{objectProperties.map((property) => { const domain = endpoint(property.domain); const range = endpoint(property.range); return <tr data-search={`${property.label} ${property.key} ${domain?.label ?? ''} ${range?.label ?? compactIri(property.range)}`.toLocaleLowerCase()} data-context={property.semantic_home} data-kind=""><td>{domain ? <a href={resourceRoute(domain)}>{domain.label}</a> : <span class="v2-domain-missing">Not specified</span>}</td><td><a href={resourceRoute(property)}><strong>{property.label}</strong></a><br/><code>{property.key}</code></td><td>{range ? <a href={resourceRoute(range)}>{range.label}</a> : <code>{compactIri(property.range)}</code>}</td><td><a href={`/v2/contexts/${property.semantic_home}`}>{contextById.get(property.semantic_home)?.label}</a></td></tr>; })}</tbody>
    </table>
  </div>

  <h2 id="unresolved-domains">Domains not yet specified ({domainless.length})</h2>
  <div class="callout callout--warn"><p class="callout__label">Visible candidate gap</p><p>These properties have an asserted range but no asserted domain. The documentation does not guess one; working-group review must resolve or accept the omission.</p></div>
  <ul>{domainless.map((property) => <li><a href={resourceRoute(property)}>{property.label}</a> — range <code>{compactIri(property.range)}</code></li>)}</ul>

  <h2 id="datatype-properties">Datatype properties ({datatypeProperties.length})</h2>
  <V2Filter targetId="v2-datatype-properties" placeholder="Search attribute labels and identifiers…" contextOptions={contextOptions} />
  <div class="v2-table-wrap" id="v2-datatype-properties">
    <table>
      <thead><tr><th>Domain</th><th>Datatype property</th><th>Datatype</th><th>Semantic home</th></tr></thead>
      <tbody>{datatypeProperties.map((property) => { const domain = endpoint(property.domain); return <tr data-search={`${property.label} ${property.key} ${domain?.label ?? ''} ${compactIri(property.range)}`.toLocaleLowerCase()} data-context={property.semantic_home} data-kind=""><td>{domain ? <a href={resourceRoute(domain)}>{domain.label}</a> : <span class="v2-domain-missing">Not specified</span>}</td><td><a href={resourceRoute(property)}><strong>{property.label}</strong></a><br/><code>{property.key}</code></td><td><code>{compactIri(property.range)}</code></td><td><a href={`/v2/contexts/${property.semantic_home}`}>{contextById.get(property.semantic_home)?.label}</a></td></tr>; })}</tbody>
    </table>
  </div>

  <h2 id="class-hierarchy">Class hierarchy ({subclasses.length})</h2>
  <div class="v2-table-wrap">
    <table>
      <thead><tr><th>Subclass</th><th>Superclass</th><th>Semantic home</th></tr></thead>
      <tbody>{subclasses.map((resource) => { const parent = endpoint(resource.subclass_of); return <tr><td><a href={resourceRoute(resource)}>{resource.label}</a></td><td>{parent ? <a href={resourceRoute(parent)}>{parent.label}</a> : <code>{compactIri(resource.subclass_of)}</code>}</td><td><a href={`/v2/contexts/${resource.semantic_home}`}>{contextById.get(resource.semantic_home)?.label}</a></td></tr>; })}</tbody>
    </table>
  </div>

  <h2 id="cross-context">Cross-context status</h2>
  <p>No reviewed cross-domain mappings are asserted in this candidate. The context map records architectural connections through the common boundary; it does not assert that one context controls another context’s internal meaning.</p>
</V2Page>
