---
import GraphDiagram from '@/components/GraphDiagram.astro';
import V2Contents from '@/components/v2/V2Contents.astro';
import V2DiagramLegend from '@/components/v2/V2DiagramLegend.astro';
import V2Page from '@/components/v2/V2Page.astro';
import {
  compactIri,
  completeModelDiagram,
  contexts,
  contextRoute,
  contextStats,
  counts,
  kindLabels,
  resourceRoute,
  resources,
  structuralRows,
} from '@/lib/v2-model.mjs';

const rows = structuralRows();
const domainless = resources.filter((resource) => resource.kind === 'object-property' && !resource.domain);
function targetLabel(row) {
  return row.target?.label ?? compactIri(row.targetIri);
}
---
<V2Page
  title="Complete model"
  description="The complete model atlas for the SPDTF 2.0 development input Property Pack seed: all 159 OWL resources, 229 asserted structural links and a synchronized structured text representation."
  category="Model atlas"
  crumbs={[{ label: 'Complete model' }]}
>
  <h1>Complete model</h1>
  <p class="lead">
    An exploratory, whole-candidate view of all {counts.resources} OWL resources and
    {counts.subclassEdges + counts.domainEdges + counts.rangeEdges} asserted subclass,
    domain and range links, grouped by semantic home.
  </p>

  <div class="callout callout--warn">
    <p class="callout__label">Use the atlas before the wall-sized graph</p>
    <p>
      The diagram is complete but necessarily dense. Use fullscreen, pan/zoom and Explore
      mode for topology; use the context pages and structured tables for precise reading.
      No source row, SKOS instance or generator metadata is drawn as an ontology-resource node.
    </p>
  </div>

  <V2Contents items={[
    { id: 'composition', label: 'Model composition' },
    { id: 'diagram', label: 'Complete Mermaid model' },
    { id: 'atlas', label: 'Context atlas' },
    { id: 'resources', label: 'Complete resource list' },
    { id: 'edges', label: 'Complete structured relationship view' },
    { id: 'unresolved-domains', label: 'Domain not yet specified' },
  ]} />

  <h2 id="composition">Model composition</h2>
  <div class="v2-metrics">
    <div class="v2-metric"><strong>{counts.classes}</strong><span>classes</span></div>
    <div class="v2-metric"><strong>{counts.objectProperties}</strong><span>object properties</span></div>
    <div class="v2-metric"><strong>{counts.datatypeProperties}</strong><span>datatype properties</span></div>
    <div class="v2-metric"><strong>{counts.subclassEdges}</strong><span>subclass links</span></div>
    <div class="v2-metric"><strong>{counts.domainEdges}</strong><span>asserted domains</span></div>
    <div class="v2-metric"><strong>{counts.rangeEdges}</strong><span>asserted ranges or datatypes</span></div>
  </div>

  <h2 id="diagram">Complete Mermaid model</h2>
  <V2DiagramLegend />
  <GraphDiagram
    source={completeModelDiagram()}
    minHeight="920px"
    caption="Complete ontology-term topology: 159 local candidate resources plus eight referenced standard terms and 229 asserted structural links. Click a local node for its reference page."
  />

  <h2 id="atlas">Context atlas</h2>
  <div class="v2-table-wrap">
    <table>
      <thead><tr><th>Semantic home</th><th>Classes</th><th>Object properties</th><th>Datatype properties</th><th>Source data points</th></tr></thead>
      <tbody>
        {contexts.map((context) => {
          const stats = contextStats(context.id);
          return <tr><td><a href={contextRoute(context)}><strong>{context.label}</strong></a></td><td>{stats.classes}</td><td>{stats.objectProperties}</td><td>{stats.datatypeProperties}</td><td>{stats.sourceItems}</td></tr>;
        })}
      </tbody>
    </table>
  </div>

  <h2 id="resources">Complete resource list</h2>
  <details>
    <summary>Show all {resources.length} OWL resources</summary>
    <div class="v2-table-wrap">
      <table>
        <thead><tr><th>Human label</th><th>Kind</th><th>Semantic home</th><th>Definition</th></tr></thead>
        <tbody>{resources.map((resource) => <tr><td><a href={resourceRoute(resource)}><strong>{resource.label}</strong></a><br/><code>{resource.key}</code></td><td>{kindLabels[resource.kind]}</td><td>{resource.semantic_home}</td><td>{resource.definition}</td></tr>)}</tbody>
      </table>
    </div>
  </details>

  <h2 id="edges">Complete structured relationship view</h2>
  <p>This server-rendered table carries the same OWL structure as the diagram and remains available without JavaScript.</p>
  <details>
    <summary>Show all {rows.length} class/property rows</summary>
    <div class="v2-table-wrap">
      <table>
        <thead><tr><th>Source / domain</th><th>Relationship</th><th>Target / range</th><th>Kind</th></tr></thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td>{row.edgeKind === 'subclass' ? <a href={resourceRoute(row.source)}>{row.source.label}</a> : row.source ? <a href={resourceRoute(row.source)}>{row.source.label}</a> : <span class="v2-domain-missing">Domain not specified</span>}</td>
              <td>{row.edgeKind === 'subclass' ? 'subclass of' : <a href={resourceRoute(row.relationship)}>{row.relationship.label}</a>}</td>
              <td>{row.target ? <a href={resourceRoute(row.target)}>{targetLabel(row)}</a> : <code>{targetLabel(row)}</code>}</td>
              <td>{row.edgeKind === 'subclass' ? 'Class hierarchy' : kindLabels[row.edgeKind]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  <h2 id="unresolved-domains">Domain not yet specified</h2>
  <p>These six object properties have an asserted range but no asserted domain. The reference exposes that gap and does not infer or guess one.</p>
  <div class="v2-table-wrap">
    <table><thead><tr><th>Property</th><th>Range</th><th>Semantic home</th></tr></thead><tbody>
      {domainless.map((resource) => <tr><td><a href={resourceRoute(resource)}>{resource.label}</a><br/><code>{resource.key}</code></td><td>{compactIri(resource.range)}</td><td>{resource.semantic_home}</td></tr>)}
    </tbody></table>
  </div>
</V2Page>
