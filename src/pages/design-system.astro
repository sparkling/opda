---
import Layout from '@/layouts/Layout.astro';
import BrandHeading from '@/components/BrandHeading.astro';

const brandColours = [
  { name: 'Deep ink', value: '#131224', role: 'Header, hero, footer and code' },
  { name: 'Night', value: '#231F2F', role: 'Body ink and raised dark surfaces' },
  { name: 'Brand ink', value: '#2C273B', role: 'Strong text and raised dark surfaces' },
  { name: 'Primary action text', value: '#000000', role: 'Text on amber primary actions' },
  { name: 'Amber', value: '#FEC92B', role: 'Primary action and signature rule' },
  { name: 'Amber active', value: '#FAC238', role: 'Yellow hover and pressed state' },
  { name: 'Off-white', value: '#F9F9F9', role: 'Quiet surface and zebra rows' },
];

const dataColours = ['#6C5BD4', '#C77F00', '#0E8478', '#A5317F', '#4E6E93', '#58810B', '#C24E1A', '#6E6580'];
const tokenSample = `:root {
  --brand-deep: #131224;
  --brand-yellow: #fec92b;
  --brand-heading: 600 clamp(2.25rem, 4vw, 4rem) / 1 var(--font-sans);
  --color-link: #5b51d8;
  --target-min: 2.75rem;
}`;
---
<Layout
  title="Design system"
  description="The evidence-grounded brand, interaction and accessibility contract for the OPDA knowledge base."
  hideComments={true}
>
  <div class="page-meta">
    <span>Version 1.0 · updated 30 August 2026</span>
  </div>

  <h1>OPDA design system</h1>
  <p class="lead">
    An ink-and-amber data publication for trusted evidence, standards, semantic
    models and implementation. This page is the compact production projection;
    <code>DESIGN.md</code> is the complete normative contract and the separate local
    review site carries the expanded presentation.
  </p>

  <div class="design-signoff">
    <span>Delegated visual authority · operator-adopted</span>
    <strong>DESIGN AUTHORITY SIGN-OFF — Fable 5 · max effort</strong>
  </div>

  <h2 id="authority">Evidence and authority</h2>
  <div class="evidence-grid">
    <article>
      <span>01 · Authoritative</span>
      <h3>Supplied guide and vectors</h3>
      <p>Typography, brand palette, logo geometry and photography direction from Ben Kansy's Q3 2026 resources.</p>
    </article>
    <article>
      <span>02 · Observed</span>
      <h3>Sites and current application</h3>
      <p>Useful content and interaction patterns, with defects retained as findings rather than promoted into policy.</p>
    </article>
    <article>
      <span>03 · Derived</span>
      <h3>Complete web system</h3>
      <p>Accessible semantic roles, component states, responsive layouts, data display, motion and governance.</p>
    </article>
  </div>

  <h2 id="brand">Brand assets</h2>
  <div class="brand-assets">
    <figure class="brand-asset brand-asset--light">
      <img src="/ui/brand/opda-wordmark-dark.svg" alt="Open Property Data Association dark wordmark" width="330" height="94" />
      <figcaption>Dark wordmark · white and off-white surfaces</figcaption>
    </figure>
    <figure class="brand-asset brand-asset--dark">
      <img src="/ui/brand/opda-wordmark-white.svg" alt="Open Property Data Association white wordmark" width="330" height="94" />
      <figcaption>White wordmark · deep-ink surfaces</figcaption>
    </figure>
  </div>
  <div class="callout callout--key">
    <h3 class="callout__label"><span aria-hidden="true">◇</span> Asset rule</h3>
    <p>Use the supplied SVGs unchanged. Logo-specific fills stay inside the files; interface colours stay in tokens.</p>
  </div>
  <h3>Icon-and-name heading</h3>
  <p>
    Use the official icon with the organisation name as live text. The icon is
    decorative; DM Sans supplies the unbroken name. The shared brand-lock-up rule
    controls its relative icon scale, icon-to-text gap, baseline alignment and surface colour.
  </p>
  <div class="brand-heading-specimens">
    <div class="brand-heading-specimen brand-heading-specimen--light">
      <BrandHeading surface="light" />
    </div>
    <div class="brand-heading-specimen brand-heading-specimen--dark">
      <BrandHeading surface="dark" />
    </div>
  </div>
  <div class="brand-heading-compact-specimen">
    <BrandHeading surface="light" scale="compact" />
    <p>The compact identity variant keeps the complete organisation name visible at supporting scale, including in the shared footer.</p>
  </div>

  <h2 id="colour">Colour</h2>
  <div class="colour-grid">
    {brandColours.map((colour) => (
      <article>
        <i style={`--sample:${colour.value}`} aria-hidden="true"></i>
        <strong>{colour.name}</strong>
        <code>{colour.value}</code>
        <small>{colour.role}</small>
      </article>
    ))}
  </div>
  <p>
    Amber directs attention and always carries dark ink. It is not body copy, a
    status colour or a sole functional boundary. Prose links use <code>#5B51D8</code>.
  </p>

  <h2 id="type">Typography</h2>
  <div class="type-board">
    <article class="type-display"><span>Roboto Slab · 600</span>One shared language.</article>
    <article class="type-body"><span>DM Sans · 400–700</span>Definitions stay clear at every density.</article>
    <article class="type-code"><span>Roboto Mono · 400–700</span>propertyPack.tenure.type</article>
  </div>
  <table>
    <caption>Core type scale</caption>
    <thead><tr><th scope="col">Role</th><th scope="col">Desktop</th><th scope="col">Mobile</th></tr></thead>
    <tbody>
      <tr><th scope="row">Display</th><td>44 / 52</td><td>34 / 42</td></tr>
      <tr><th scope="row">H1</th><td>36 / 44</td><td>30 / 38</td></tr>
      <tr><th scope="row">H2</th><td>28 / 36</td><td>28 / 36</td></tr>
      <tr><th scope="row">Body</th><td>16 / 26</td><td>16 / 26</td></tr>
      <tr><th scope="row">Code</th><td>14 / 22</td><td>14 / 22</td></tr>
    </tbody>
  </table>

  <h2 id="document-flow">Document flow</h2>
  <p>
    The article controls vertical separation between its direct children. The following
    block owns its block-start gap; the preceding block does not add a trailing margin
    for an unknown next sibling. Cards, tables, diagrams and callouts therefore work
    consistently whether they occur in the middle or at the end of a section.
  </p>
  <table>
    <caption>Shared documentation flow responsibilities</caption>
    <thead><tr><th scope="col">Layer</th><th scope="col">Owns</th><th scope="col">Does not own</th></tr></thead>
    <tbody>
      <tr><th scope="row">Article flow</th><td>12px before each following direct block</td><td>Component-specific trailing gaps</td></tr>
      <tr><th scope="row">H2 divider</th><td>16px before its rule; 8px CSS padding plus the heading line box after it</td><td>Spacing after the previous component</td></tr>
      <tr><th scope="row">Previous/next divider</th><td>4px after the final line box; 12px before the navigation panel</td><td>Trailing space already present inside the final text line box</td></tr>
      <tr><th scope="row">Cards, tables and diagrams</th><td>Internal layout and containment</td><td>External space after themselves</td></tr>
      <tr><th scope="row">Semantic section</th><td>The same direct-child rule for its local content stack</td><td>Accumulated table and subheading margins</td></tr>
    </tbody>
  </table>

  <h2 id="components">Components and states</h2>
  <p>Every interactive component provides hover, active, focus and disabled states, plus loading, error and success where work is asynchronous.</p>
  <div class="component-board">
    <article>
      <span>Primary action</span>
      <a class="btn" href="#implementation">Use the contract</a>
    </article>
    <article>
      <span>Secondary action</span>
      <a class="btn btn--ghost" href="#accessibility">Review the gates</a>
    </article>
    <article>
      <span>Disabled</span>
      <button class="btn" type="button" disabled>Unavailable</button>
    </article>
  </div>
  <div class="card-grid" aria-label="Linked card pattern">
    <a class="card" href="#data">
      <span class="card__eyebrow">Evidence and assurance</span>
      <h3>Work-package coverage</h3>
      <p>Use a concise explanation and an explicit scope note before comparable facts.</p>
      <p class="card__scope"><strong>Scope:</strong> source catalogue review</p>
      <dl class="card__stats">
        <div><dt>Items</dt><dd>74</dd></div>
        <div><dt>Boundaries</dt><dd>3</dd></div>
        <div><dt>Resources</dt><dd>18</dd></div>
      </dl>
      <span class="card__action" aria-hidden="true">Explore the view <span>→</span></span>
    </a>
  </div>
  <div class="status-board">
    <span class="pill pill--success">✓ Current baseline</span>
    <span class="pill pill--warn">◇ Review candidate</span>
    <span class="pill pill--info">i Evidence attached</span>
  </div>
  <div class="callout callout--note"><h3 class="callout__label"><span aria-hidden="true">i</span> Information</h3><p>Context that changes how evidence should be read.</p></div>
  <div class="callout callout--success"><h3 class="callout__label"><span aria-hidden="true">✓</span> Success</h3><p>The validation contract has passed.</p></div>
  <div class="callout callout--warn"><h3 class="callout__label"><span aria-hidden="true">◇</span> Warning</h3><p>This candidate has not been adopted.</p></div>
  <div class="callout callout--danger"><h3 class="callout__label"><span aria-hidden="true">!</span> Critical</h3><p>A required provenance field is missing.</p></div>
  <div class="callout callout--note">
    <h3 class="callout__label"><span aria-hidden="true">↻</span> Generated process infographic</h3>
    <p>
      Generate stable explanatory graphics as checked-in light and dark SVGs, with no
      client runtime or external resources. Keep the complete process in semantic HTML,
      show cycles as cycles, place conditional outcomes outside them and state AI
      assistance separately from human decision authority.
    </p>
  </div>

  <h2 id="standalone-public">Public-service family</h2>
  <p><code>/join</code> remains a standalone recruitment composition. <code>/join/privacy</code> and <code>/accessibility</code> use the same global <code>Header</code> as the Knowledge Base, with both side menus, breadcrumbs, comments and previous/next navigation omitted. Every route consumes the official assets, semantic tokens, typography, buttons, fields, focus treatment and shared <code>SiteFooter</code> from this system.</p>
  <div class="evidence-grid">
    <article><span>Shell</span><h3>One global header for public statements</h3><p>Privacy and accessibility match the Knowledge Base header while omitting documentation side menus. Recruitment keeps its focused campaign header.</p></article>
    <article><span>Recruitment</span><h3>Purpose before process</h3><p>Plain working-group cards name the audience, practical scope and next action. Programme purpose and professional influence come before technical method.</p></article>
    <article><span>Form</span><h3>Theme-aware destination</h3><p>The complete form ends the campaign on the current light or dark semantic surfaces, with governed controls and unchanged validation states.</p></article>
  </div>
  <div class="callout callout--note"><h3 class="callout__label"><span aria-hidden="true">i</span> Motion boundary</h3><p>No parallax, pinned scrolling or interaction-gated meaning. Reduced motion exposes the complete final state immediately.</p></div>

  <h2 id="data">Data display</h2>
  <div class="data-palette" aria-label="Ordered categorical data colours">
    {dataColours.map((colour, index) => <span style={`--data:${colour}`}><b>{index + 1}</b><code>{colour}</code></span>)}
  </div>
  <p>Colour is reinforced by order, labels and markers. Tables use scoped headers, visible sorting, visually hidden semantic captions and automatic, content-proportional columns that wrap within the content track. Deep-ink column headers, regular-weight warm-neutral first-column body cells and neutral zebra rows keep the three structural roles distinct. Every table highlights its first body column, and zebra striping begins at column two. Repeated label-and-explanation records use a two-column table; ordinary bullets and steps remain lists.</p>
  <p>Standalone identifiers use unboxed monospace text, for example <code class="standalone-identifier">urn:opda:example:Property</code>. Ordinary inline code such as <code>aria-sort</code> retains its quiet code surface.</p>
  <div class="table-region">
    <table>
      <caption>Standards-status pattern</caption>
      <thead><tr><th scope="col" aria-sort="ascending">Term ↑</th><th scope="col">Context</th><th scope="col">Status</th><th scope="col">Source</th></tr></thead>
      <tbody>
        <tr><th scope="row"><code class="standalone-identifier">Property</code></th><td>Common boundary</td><td><span class="pill pill--success">✓ Current</span></td><td><code>Committed corpus</code></td></tr>
        <tr><th scope="row"><code class="standalone-identifier">RegisteredTitle</code></th><td>Conveyancing</td><td><span class="pill pill--warn">◇ Candidate</span></td><td><code>Review evidence</code></td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="accessibility">Accessibility gates</h2>
  <div class="gate-grid">
    <article><strong>4.5:1</strong><span>Normal text contrast</span></article>
    <article><strong>44px</strong><span>Minimum control target</span></article>
    <article><strong>320px</strong><span>Lossless reflow width</span></article>
    <article><strong>200ms</strong><span>Maximum motion duration</span></article>
  </div>
  <ul>
    <li>Two-colour amber-and-ink focus treatment on every interactive control.</li>
    <li>Complete keyboard paths, Escape and focus return for drawers and dialogs.</li>
    <li>Status combines an icon, full text label and colour.</li>
    <li>Reduced-motion and forced-colour equivalents are required.</li>
    <li>No generative identity imagery; photography requires recorded rights and an alt-text decision.</li>
  </ul>

  <h2 id="implementation">Implementation contract</h2>
  <div class="implementation-grid">
    <article><span>Normative</span><strong>DESIGN.md</strong><p>Evidence, rules, patterns and release gates.</p></article>
    <article><span>Tokens</span><strong>design-tokens.css</strong><p>Colour, typography, space, geometry and motion.</p></article>
    <article><span>Components</span><strong>public/ui/design/</strong><p>Reviewable CSS modules behind one live facade.</p></article>
    <article><span>Decision</span><strong>ADR-0073</strong><p>Adoption, supersession, scope and publication boundary.</p></article>
  </div>
  <pre><code set:text={tokenSample} /></pre>
  <p class="closing-rule">The system may evolve. Its evidence and consequences must remain visible.</p>

  <style>
    .design-signoff { margin: var(--space-7) 0; padding: var(--space-5); display: flex; flex-direction: column; color: var(--brand-white); background: var(--brand-deep); border-bottom: 4px solid var(--brand-yellow); }
    .design-signoff span { color: var(--neutral-400); }
    .design-signoff strong { color: var(--brand-white); }
    .design-signoff span, .evidence-grid > article > span, .implementation-grid article > span { font: 600 var(--text-xs)/1.4 var(--font-mono); text-transform: uppercase; }
    .evidence-grid > article > span, .implementation-grid article > span { color: var(--color-text-muted); }
    .evidence-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--space-5); border: 1px solid var(--color-border); }
    .evidence-grid article { padding: var(--space-6); border-right: 1px solid var(--color-border); }
    .evidence-grid article:last-child { border-right: 0; }
    .evidence-grid h3 { margin: var(--space-6) 0 var(--space-3); }
    .brand-assets { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--color-border); }
    .brand-asset { min-height: 15rem; margin: 0; padding: var(--space-7); display: grid; place-items: center; border-right: 1px solid var(--color-border); }
    .brand-asset:last-child { border-right: 0; }
    .brand-asset img { width: min(100%, 20rem); height: auto; }
    .brand-asset figcaption { align-self: end; color: var(--color-text-muted); font-size: var(--text-sm); }
    .brand-asset--light { color: var(--brand-night); background: var(--brand-white); }
    .brand-asset--light figcaption { color: var(--neutral-600); }
    .brand-asset--dark { color: var(--brand-white); background: var(--brand-deep); }
    .brand-asset--dark figcaption { color: var(--neutral-400); }
    .brand-heading-specimens { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--color-border); }
    .brand-heading-specimen { min-width: 0; padding: var(--space-7); }
    .brand-heading-specimen + .brand-heading-specimen { border-left: 1px solid var(--color-border); }
    .brand-heading-specimen :global(.brand-heading) { --brand-heading: 600 clamp(1.5rem, 2.5vw, 2.25rem) / 1.1 var(--font-sans); }
    .brand-heading-specimen :global(.brand-heading__icon) { width: clamp(3rem, 5vw, 4.25rem); }
    .brand-heading-specimen--light { background: var(--brand-white); }
    .brand-heading-specimen--dark { background: var(--brand-deep); }
    .brand-heading-compact-specimen { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--color-border); }
    .brand-heading-compact-specimen p { margin: 0; }
    .colour-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--color-border); }
    .colour-grid article { min-height: 13rem; padding: var(--space-5); display: flex; flex-direction: column; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
    .colour-grid i { height: 5rem; margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) var(--space-5); background: var(--sample); border-bottom: 1px solid var(--color-border); }
    .colour-grid code, .colour-grid small { color: var(--color-text-muted); }
    .colour-grid small { margin-top: auto; }
    .type-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--color-border); }
    .type-board article { min-height: 10rem; padding: var(--space-6); border-right: 1px solid var(--color-border); }
    .type-board span { display: block; margin-bottom: var(--space-5); color: var(--color-text-muted); font: 500 var(--text-xs)/1.4 var(--font-mono); }
    .type-display { font: 600 var(--text-2xl)/1.3 var(--font-display); }
    .type-body { font: 500 var(--text-lg)/1.5 var(--font-sans); }
    .type-code { font: var(--code); }
    .component-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--color-border); }
    .component-board article { min-height: 8rem; padding: var(--space-5); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); border-right: 1px solid var(--color-border); }
    .component-board span { color: var(--color-text-muted); font: 500 var(--text-xs)/1.4 var(--font-mono); }
    .status-board { margin: var(--space-5) 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
    .data-palette { display: grid; grid-template-columns: repeat(8, 1fr); margin-top: var(--space-5); }
    .data-palette span { min-height: 6rem; padding: var(--space-3); display: flex; flex-direction: column; justify-content: space-between; color: var(--brand-white); background: var(--data); }
    .data-palette span:nth-child(2) { color: var(--brand-night); }
    .data-palette code { padding: 0; border-radius: 0; color: inherit; background: transparent; font-size: var(--text-xs); }
    .table-region { overflow-x: visible; }
    .table-region table { width: 100%; max-width: 100%; min-width: 0; table-layout: auto; }
    .table-region :is(th, td) { overflow-wrap: anywhere; word-break: normal; white-space: normal; }
    .gate-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--color-border); }
    .gate-grid article { min-height: 8rem; padding: var(--space-5); border-right: 1px solid var(--color-border); }
    .gate-grid strong { display: block; color: var(--color-text-strong); font: 700 var(--text-2xl)/1.2 var(--font-sans); }
    .gate-grid span { display: block; margin-top: var(--space-3); color: var(--color-text-muted); }
    .implementation-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
    .implementation-grid article { padding: var(--space-6); border: 1px solid var(--color-border); }
    .implementation-grid strong { display: block; margin-top: var(--space-5); font: var(--h3); }
    .closing-rule { margin-top: var(--space-8); padding-left: var(--space-5); border-left: 4px solid var(--brand-yellow); font: 600 var(--text-lg)/1.5 var(--font-sans); }
    @media (max-width: 60rem) {
      .evidence-grid, .colour-grid, .type-board, .component-board { grid-template-columns: 1fr 1fr; }
      .data-palette { grid-template-columns: repeat(4, 1fr); }
      .gate-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 40rem) {
      .evidence-grid, .brand-assets, .brand-heading-specimens, .colour-grid, .type-board, .component-board, .implementation-grid, .gate-grid { grid-template-columns: 1fr; }
      .evidence-grid article, .brand-asset, .type-board article, .component-board article, .gate-grid article { border-right: 0; border-bottom: 1px solid var(--color-border); }
      .brand-heading-specimen + .brand-heading-specimen { border-left: 0; border-top: 1px solid var(--color-border); }
    }
  </style>
</Layout>
