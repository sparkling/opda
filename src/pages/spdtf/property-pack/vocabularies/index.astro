---
import PropertyPackFilter from '@/components/property-pack/PropertyPackFilter.astro';
import PropertyPackPage from '@/components/property-pack/PropertyPackPage.astro';
import {
  contexts,
  contextById,
  contextStats,
  counts,
  vocabularies,
  vocabularyRoute,
} from '@/lib/property-pack-model.mjs';

const contextOptions = contexts.map((context) => ({ value: context.id, label: context.label }));
---
<PropertyPackPage
  title="Controlled vocabularies"
  description="All 14 candidate SKOS controlled vocabularies, their 85 value concepts, and the separate 413-topic concept layer."
  category="Meaning & constraints"
  crumbs={[{ label: 'Controlled vocabularies' }]}
>
  <h1>Controlled vocabularies</h1>
  <p class="lead">
    Fourteen candidate SKOS schemes publish 85 controlled values. A separate topic
    layer gives 413 consolidated source questions a stable concept IRI without treating
    those questions as selectable values.
  </p>


  <h2 id="schemes">Controlled-value schemes</h2>
  <PropertyPackFilter
    targetId="v2-vocabulary-register"
    placeholder="Search scheme labels, identifiers and definitions…"
    contextOptions={contextOptions}
  />
  <div class="v2-table-wrap" id="v2-vocabulary-register">
    <table>
      <thead><tr><th>Scheme</th><th>Semantic home</th><th>Definition</th><th>Concepts</th><th>Source traces</th></tr></thead>
      <tbody>
        {vocabularies.map((scheme) => (
          <tr
            data-search={`${scheme.label} ${scheme.key} ${scheme.definition}`.toLocaleLowerCase()}
            data-context={scheme.semantic_home}
            data-kind=""
          >
            <td><a href={vocabularyRoute(scheme)}><strong>{scheme.label}</strong></a><br/><code class="standalone-identifier">{scheme.key}</code></td>
            <td><a href={`/spdtf/property-pack/contexts/${scheme.semantic_home}`}>{contextById.get(scheme.semantic_home)?.label}</a></td>
            <td>{scheme.definition}</td>
            <td>{scheme.concepts.length}</td>
            <td>{scheme.source_item_ids.length}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="topics">Topic concept layer</h2>
  <p>{counts.topicConcepts} of the 451 source data points are represented as topic concepts. The remaining 38 source items are modelled without a consolidated topic concept.</p>
  <div class="v2-table-wrap">
    <table>
      <thead><tr><th>Semantic home</th><th>Topic concepts</th><th>Source data points</th></tr></thead>
      <tbody>{contexts.map((context) => { const stats = contextStats(context.id); return <tr><td><a href={`/spdtf/property-pack/contexts/${context.id}`}>{context.label}</a></td><td>{stats.topicConcepts}</td><td>{stats.sourceItems}</td></tr>; })}</tbody>
    </table>
  </div>
  <p><a href="/spdtf/property-pack/data-dictionary">Browse topic IRIs with their source data points</a>.</p>

  <h2 id="distinction">Why the layers are separate</h2>
  <div class="v2-note-grid">
    <section><h3>Controlled values</h3><p>A scheme such as class of title or energy rating defines values that a data point may use. Its concepts are enumerated on the scheme page.</p></section>
    <section><h3>Topics</h3><p>A topic concept identifies the subject of a consolidated question. It supports taxonomy and discussion; it is not automatically a permitted value.</p></section>
  </div>
</PropertyPackPage>
