  Construct["What construct does it require?"]:::process
  Class["OWL class: reusable kind"]:::service
  Resource["Identified resource: instance"]:::external
  Concept["SKOS concept"]:::success
  Value["Typed literal value"]:::infra
  Link["Does the relationship carry its own information?"]:::security
  Direct["Direct object property"]:::data
  Qualified["Qualified relationship resource"]:::external
