---
import Layout from '@/layouts/Layout.astro';
import PageMeta from '@/components/PageMeta.astro';
import { SEMANTIC_PACKAGE_MANIFEST } from '@/lib/spdtf-workspace.mjs';
---

<Layout title="SPDTF outputs and validation" description="Versioned semantic-package outputs, projection boundaries and validation status.">
  <PageMeta category="Generated outputs" variant="warn" updated="Workspace contract · no released SPDTF package" />
  <h1>Generated outputs and validation evidence</h1>
  <p class="lead">This register prevents a generated representation from becoming an independent source of meaning.</p>
  <h2 id="manifest">Canonical package manifest</h2>
  <dl>
    <dt>Identifier</dt><dd><code class="standalone-identifier">{SEMANTIC_PACKAGE_MANIFEST.id}</code></dd>
    <dt>Version</dt><dd><code>{SEMANTIC_PACKAGE_MANIFEST.version}</code></dd>
    <dt>Status</dt><dd>{SEMANTIC_PACKAGE_MANIFEST.status}</dd>
    <dt>Authority</dt><dd>{SEMANTIC_PACKAGE_MANIFEST.authority}</dd>
    <dt>Standards profile</dt><dd><code>{SEMANTIC_PACKAGE_MANIFEST.standardsProfileVersion}</code></dd>
  </dl>

  <h2 id="semantic-outputs">Six semantic outputs</h2>
  <ul>{SEMANTIC_PACKAGE_MANIFEST.outputs.map((output) => <li>{output} — no released group package</li>)}</ul>

  <h2 id="projections">Technical projections</h2>
  <ul>{SEMANTIC_PACKAGE_MANIFEST.projections.map((projection) => <li>{projection} — not generated from an approved SPDTF package</li>)}</ul>
  <p>{SEMANTIC_PACKAGE_MANIFEST.synchronizationRule}</p>
  <p>Parser, SHACL or generator success proves only the encoded checks. It does not prove business truth or semantic approval.</p>
</Layout>
