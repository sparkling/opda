---
/**
 * Canonical rich-results search. The GET form and its facet controls work as
 * a shareable URL contract; the controller in src/scripts/site-search-page.ts
 * enhances them against the shared index. Filter vocabulary comes from the
 * shared model so this page cannot invent a facet the index does not carry.
 */
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { FACETS, QUERY_PARAM, SEARCH_TABS } from '@/lib/site-search-model.mjs';

const optionId = (facet: string, option: string) => `site-search-${facet}-${option}`;
---

<Layout
  title="Search"
  description="Search every published OPDA page: ontology resources, decision records, working groups, guides and programme material."
  proseClass="prose wide site-search-page"
  hideComments
  hideTableOfContents
  reserveTableOfContentsRail
>
  <Sidebar slot="sidebar" label="Filters" ariaLabel="Search filters">
    <div class="site-search__filters" data-search-filters>
      {FACETS.map((facet) => (
        <details class="db-filter-section site-search__facet" data-search-facet={facet.key} data-search-scopes={facet.scopes.join(' ')}>
          <summary class="db-filter-heading">{facet.label}</summary>
          <fieldset class="site-search__facet-options">
            <legend class="visually-hidden">{facet.label}</legend>
            {facet.options.map((option) => (
              <label class="db-filter-option" for={optionId(facet.key, option.key)}>
                <input type="checkbox" id={optionId(facet.key, option.key)} name={facet.param} value={option.key} form="site-search-form" />
                <span class="site-search__option-label">{option.label}</span>
                <span class="db-filter-option-count" data-count hidden></span>
              </label>
            ))}
          </fieldset>
        </details>
      ))}
      <button class="db-reset" type="reset" form="site-search-form" data-search-reset>Clear search and filters</button>
    </div>
  </Sidebar>

  <h1>Search</h1>

  <form id="site-search-form" class="site-search" role="search" action="/search" method="get" data-site-search-form>
    <div class="site-search__query">
      <div class="db-field db-field--grow">
        <label class="visually-hidden" for="site-search">Search documentation</label>
        <input
          class="db-input"
          id="site-search"
          name={QUERY_PARAM}
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Try lease, UPRN, valuation or ADR-0082"
        />
      </div>
      <button class="btn site-search__submit" type="submit">Search</button>
    </div>
  </form>
  <noscript>
    <p class="callout callout--note">Filtering needs JavaScript. Without it, use your browser's find command on a section index or open the quick links in the site navigation.</p>
  </noscript>

  <div class="site-search__scope-row">
    <nav class="site-search__scope" aria-label="Search sections" data-search-tabs>
      {SEARCH_TABS.map((tab, index) => (
        <button class="site-search__scope-tab" type="button" data-search-tab={tab.key} aria-pressed={String(index === 0)}>{tab.label}</button>
      ))}
    </nav>
    <p class="site-search__summary"><span id="search-summary" data-search-summary aria-label="Loading search results">…</span></p>
  </div>

  <div class="site-search-layout">
    <input type="hidden" name="tab" value="all" form="site-search-form" data-search-tab-input />

    <section class="site-search__results" aria-label="Search results">
      <div class="site-search__status" data-search-status hidden>
        <ul class="site-search__applied" aria-label="Applied filters" data-search-applied hidden></ul>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-search-announcement></p>
      <ol class="site-search-results" data-search-results></ol>
      <button class="db-reset site-search__more" type="button" data-search-more hidden>Show more results</button>
      <div class="db-empty site-search-empty" data-no-results hidden>
        <p data-no-results-message></p>
        <p>Try fewer or different words, check the spelling, or widen the scope.</p>
        <div class="site-search-empty__actions">
          <button class="btn" type="button" data-search-widen hidden>Search all results</button>
          <button class="db-reset" type="reset" form="site-search-form" data-search-reset>Clear search and filters</button>
        </div>
      </div>
    </section>
  </div>

  <template data-search-card>
    <li class="card site-search-result">
      <div class="site-search-result__header">
        <p class="card__eyebrow site-search-result__eyebrow" data-slot="eyebrow"></p>
        <span class="pill site-search-result__badge" data-slot="badge"></span>
      </div>
      <h3 class="site-search-result__title"><a data-slot="link"></a></h3>
      <p class="site-search-result__summary" data-slot="summary"></p>
      <dl class="site-search-result__facts" data-slot="facts"></dl>
    </li>
  </template>

  <script>
    import '@/scripts/site-search-page';
  </script>
</Layout>
