---
import Layout from '@/layouts/Layout.astro';
import PageMeta from '@/components/PageMeta.astro';
import DestinationCards from '@/components/ia/DestinationCards.astro';
import { SECTION_NAVIGATION } from '@/lib/site-navigation';

const programmeSectionDescriptions: Record<string, string> = {
  Strategy: 'Read the programme direction, roadmap and policy context that frame the work.',
  'DBT Smart Data': 'Follow the government Smart Data context and OPDA’s related evidence and activity.',
  'Programme activity': 'Find the programme’s working-group and engagement activity.',
};
const programmeNavigationCards = SECTION_NAVIGATION.programme.groups
  .filter((group) => group.heading !== 'Overview')
  .map((group) => ({
    audience: 'Programme section',
    description: programmeSectionDescriptions[group.heading] ?? SECTION_NAVIGATION.programme.summary,
    title: group.heading,
    url: group.url,
  }));
---

<Layout
  title="Programme"
  description="The Smart Property Data Trust Framework programme: its purpose, schema-to-scheme progression, policy context and current direction."
>
  <PageMeta category="Programme" variant="brand" updated="Current programme view · 2026-08-18" />
  <h1>Programme</h1>
  <p class="lead">
    The PDTF schema is the existing Digital Property Pack schema. SPDTF is the first
    scheme draft authored collaboratively across the property industry and its stakeholders.
    This page explains the progression from schema to scheme.
  </p>

  <div class="callout callout--key">
    <p class="callout__label">The short version</p>
    <p>
      <strong>SPDTF is in development, not adopted.</strong> The PDTF schema remains the
      existing Digital Property Pack schema. The ontology extracted from it is a separate,
      schema-derived evidence source, not part of the PDTF schema and not an approved SPDTF draft.
    </p>
  </div>

  <h2 id="progression">From schema to scheme</h2>
  <p>
    The PDTF schema provides JSON Schemas, overlays, a data dictionary, a business glossary
    and implementation evidence. A separate ontology was extracted from those materials to
    make their concepts, relationships and constraints inspectable. SPDTF development uses
    both bodies of evidence alongside participant evidence, recognised sources and competency
    questions. Domain working groups test meaning in bounded contexts before governance can
    promote any candidate into the collaboratively authored scheme draft.
  </p>
  <table>
    <caption>How the three bodies of work relate</caption>
    <thead><tr><th scope="col">PDTF schema</th><th scope="col">Schema-derived ontology</th><th scope="col">SPDTF</th></tr></thead>
    <tbody>
      <tr><td>The existing Digital Property Pack JSON Schema, overlays, dictionary and glossary.</td><td>A separate extraction that exposes concepts, relationships, constraints and provenance for review.</td><td>The first scheme draft authored collaboratively across industry and stakeholders.</td></tr>
      <tr><td>Provides implementation, compatibility and migration evidence.</td><td>Provides semantic and coverage evidence; it does not acquire the schema's authority.</td><td>Uses both evidence sets alongside participant sources and working-group decisions.</td></tr>
      <tr><td>Remains available for existing implementations.</td><td>Keeps its own maturity and provenance labels.</td><td>Working groups own domain meaning; governance controls candidate promotion.</td></tr>
    </tbody>
  </table>

  <h2 id="policy">UK Smart Data context</h2>
  <p>
    DBT Smart Data is external government policy and prospective scheme context. Property
    remains subject to feasibility, governance, legal assessment and consultation. OPDA
    contributes evidence and tested approaches; SPDTF is not an approved statutory
    property Smart Data scheme, and OPDA participation in government forums does not
    confer government authority.
  </p>
  <p>
    Read the official context in the <a href="https://www.gov.uk/government/publications/smart-data-strategy" rel="noreferrer">Smart Data 2035 strategy</a>,
    the <a href="https://www.gov.uk/government/calls-for-evidence/smart-data-multi-sector-call-for-evidence" rel="noreferrer">multi-sector call for evidence</a>
    and the <a href="https://www.gov.uk/government/consultations/home-buying-and-selling-reform/outcome/home-buying-and-selling-reform-roadmap" rel="noreferrer">Home Buying and Selling Reform Roadmap</a>.
  </p>

  <h2 id="start">Choose a starting point</h2>
  <DestinationCards />

  <h2 id="programme-sections">Explore the programme</h2>
  <DestinationCards cards={programmeNavigationCards} />
</Layout>
