---
import {
  IA_STATUS_REGISTRY_VERSION,
  getRouteStatus,
} from '@/lib/site-ia.mjs';
import DestinationCards from '@/components/ia/DestinationCards.astro';
import KickoffFeature from '@/components/home/KickoffFeature.astro';
import MethodFlowFigure from '@/components/home/MethodFlowFigure.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import '@/styles/working-group-campaign.css';
import '@/styles/working-group-campaign-responsive.css';

const title = 'OPDA Knowledge Base';
const description =
  'Explore the OPDA programme, governance, semantic modelling, SPDTF development, working groups and evidence behind a shared language for property data.';
const routeStatus = getRouteStatus('/');

---
<!doctype html>
<html lang="en" data-ia-status-version={IA_STATUS_REGISTRY_VERSION} data-work-area={routeStatus.workArea} data-authority={routeStatus.authority} data-maturity={routeStatus.maturity} data-content-version={routeStatus.version} data-provenance={routeStatus.provenance}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="opda:work-area" content={routeStatus.workArea} />
  <meta name="opda:authority" content={routeStatus.authority} />
  <meta name="opda:maturity" content={routeStatus.maturity} />
  <meta name="opda:version" content={routeStatus.version} />
  <meta name="opda:provenance" content={routeStatus.provenance} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    (function () {
      try {
        var t = new URLSearchParams(location.search).get('theme');
        if (t !== 'light' && t !== 'dark') t = localStorage.getItem('opda-theme');
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <link rel="stylesheet" href="/ui/design-system.css" />
</head>
<body class="public-site">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <main id="main-content" tabindex="-1">
    <section class="public-hero wg-campaign-hero" aria-labelledby="public-title">
      <div class="public-hero__copy wg-campaign-hero__copy">
        <div class="public-hero__brand">
          <img src="/ui/brand/opda-icon-yellow.svg" alt="" aria-hidden="true" width="84" height="100" />
          <span>Open Property Data Association</span>
        </div>
        <p class="eyebrow wg-eyebrow">The OPDA Knowledge Base</p>
        <h1 id="public-title">A shared language for property data, <em>drafted in the open.</em></h1>
        <p class="public-hero__lede wg-lead">
          SPDTF — the Smart Property Data Trust Framework — is the first
          collaboratively authored scheme draft. Working groups across industry are
          agreeing what property information means, under open governance. It is in
          development: not yet adopted, and not a government-approved standard.
        </p>
        <div class="public-hero__actions wg-hero-actions">
          <a class="btn wg-btn--large" href="/spdtf">Explore SPDTF development</a>
          <a class="btn btn--outline-dark wg-btn--large" href="/programme">Understand the programme</a>
        </div>
      </div>

      <aside class="public-hero__status wg-hero-journey" aria-labelledby="public-status-title">
        <p class="eyebrow wg-eyebrow">Programme status</p>
        <h2 id="public-status-title">At a glance</h2>
        <dl class="public-hero__facts">
          <div>
            <dt>Work area</dt>
            <dd>SPDTF</dd>
          </div>
          <div>
            <dt>Maturity</dt>
            <dd>In development — not an adopted standard</dd>
          </div>
          <div>
            <dt>Authority</dt>
            <dd>Working groups own meaning; governance controls promotion</dd>
          </div>
        </dl>
      </aside>
    </section>
    <MethodFlowFigure />
    <KickoffFeature />
    <nav class="public-overview" aria-labelledby="inside-title">
      <header>
        <p class="overline">Choose your route</p>
        <h2 id="inside-title">Explore the programme and how SPDTF is developed</h2>
      </header>
      <DestinationCards />
    </nav>
    <section class="public-join" aria-labelledby="join-title">
      <div class="public-join__inner">
        <p class="public-join__overline">Contribute</p>
        <h2 id="join-title">Bring your expertise to the draft.</h2>
        <p>
          Working groups need people who know how property really transacts — agents,
          lenders, conveyancers, surveyors and data specialists. No modelling background
          is required.
        </p>
        <a class="btn" href="/join">Join a working group</a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script is:inline src="/ui/client.js"></script>
</body>
</html>

<style>
  .public-hero.wg-campaign-hero { --campaign-max: 92rem; }
  .public-hero__copy { min-width: 0; }
  .public-hero.wg-campaign-hero .public-hero__brand {
    align-items: flex-end;
    gap: var(--space-5);
    margin: 0 0 var(--space-8);
    font-size: clamp(1.75rem, 3vw, 3rem);
  }
  .public-hero.wg-campaign-hero .public-hero__brand img { width: clamp(4rem, 6vw, 5.5rem); }
  .public-hero.wg-campaign-hero h1::after { content: none; }
  .public-hero.wg-campaign-hero h1 {
    margin: 0;
    color: var(--brand-white);
    font: 600 clamp(3.1rem, 6.5vw, 7rem) / 0.96 var(--font-display);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .public-hero.wg-campaign-hero h1 em {
    color: var(--brand-yellow);
    font-style: normal;
  }
  .public-hero.wg-campaign-hero .wg-lead {
    margin: var(--space-7) 0 0;
    color: var(--on-dark-muted);
    font: 400 clamp(1.125rem, 1.8vw, 1.5rem) / 1.55 var(--font-sans);
  }
  .public-hero.wg-campaign-hero .wg-hero-actions { margin-top: var(--space-7); }
  .public-hero__facts {
    display: grid;
    margin: var(--space-6) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--color-surface-dark-tint);
    counter-reset: public-status;
  }
  .public-hero__facts > div {
    min-width: 0;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    align-items: start;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-surface-dark-tint);
    counter-increment: public-status;
  }
  .public-hero__facts > div::before {
    content: counter(public-status, decimal-leading-zero);
    grid-row: 1 / span 2;
    color: var(--brand-yellow);
    font: 700 var(--text-sm) / 1.35 var(--font-mono);
  }
  .public-hero__facts dt {
    color: var(--brand-white);
    font: 600 clamp(1.125rem, 1.45vw, 1.4rem) / 1.25 var(--font-display);
  }
  .public-hero__facts dd {
    margin: 0;
    color: var(--on-dark-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .public-join {
    width: min(100%, var(--content-max));
    margin: 0 auto;
    padding: 0 var(--space-7) var(--space-10);
    background: var(--color-surface);
  }
  .public-join__inner {
    width: 100%;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--brand-yellow);
    background: var(--color-surface-card);
  }
  .public-join__overline {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font: 700 var(--text-xs) / 1.3 var(--font-sans);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }
  .public-join h2 { margin: 0; font: var(--h2); }
  .public-join__inner > p:not(.public-join__overline) {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font: var(--lead);
  }
  .public-join .btn { margin-top: var(--space-6); }

  @media (max-width: 40rem) {
    .public-hero.wg-campaign-hero .public-hero__brand {
      align-items: flex-start;
      margin-bottom: var(--space-8);
    }
    .public-join { padding: 0 var(--space-5) var(--space-8); }
    .public-join__inner { width: 100%; padding: var(--space-6); }
  }

  @media (forced-colors: active) {
    .public-hero__status,
    .public-hero__facts > div,
    .public-join__inner { border-color: CanvasText; }
  }

  @media print {
    .public-hero.wg-campaign-hero {
      color: black;
      background: white;
      border-bottom-color: black;
    }
    .public-hero.wg-campaign-hero h1,
    .public-hero.wg-campaign-hero h1 em,
    .public-hero.wg-campaign-hero .eyebrow,
    .public-hero.wg-campaign-hero .public-hero__brand span,
    .public-hero.wg-campaign-hero .public-hero__lede,
    .public-hero__status h2,
    .public-hero__facts dt,
    .public-hero__facts dd,
    .public-hero__facts > div::before { color: black; }
    .public-hero__status,
    .public-hero__facts,
    .public-hero__facts > div { border-color: black; }
    .public-hero__actions .btn {
      color: black;
      background: white;
      border: 1px solid black;
    }
    .public-join__inner { break-inside: avoid; }
  }
</style>
