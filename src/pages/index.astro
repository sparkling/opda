---
import {
  IA_STATUS_REGISTRY_VERSION,
  getRouteStatus,
} from '@/lib/site-ia.mjs';
import DestinationCards from '@/components/ia/DestinationCards.astro';
import BrandHeading from '@/components/BrandHeading.astro';
import KickoffFeature from '@/components/home/KickoffFeature.astro';
import MethodFlowFigure from '@/components/home/MethodFlowFigure.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import '@/styles/working-group-campaign.css';
import '@/styles/working-group-campaign-responsive.css';

const title = 'OPDA Knowledge Base';
const description =
  'Explore the OPDA programme, governance, semantic modelling, SPDTF development, working groups and evidence behind a shared language for property data.';
const routeStatus = getRouteStatus('/');
const domains = [
  { name: 'Conveyancing', description: 'Legal title, ownership, disclosure, completion and transfer.' },
  { name: 'Estate agency', description: 'Marketing, pricing, letting, media and consumer disclosure.' },
  { name: 'Finance and banking', description: 'Mortgages, repayment, insurance and financial obligations.' },
  { name: 'Property data services', description: 'Searches, registers, certificates and utility records.' },
  { name: 'Property technology', description: 'Digital property records, smart home capabilities and connectivity.' },
  { name: 'Surveying and valuation', description: 'Construction, condition, alterations and installed features.' },
];

---
<!doctype html>
<html lang="en" data-ia-status-version={IA_STATUS_REGISTRY_VERSION} data-work-area={routeStatus.workArea} data-authority={routeStatus.authority} data-maturity={routeStatus.maturity} data-content-version={routeStatus.version} data-provenance={routeStatus.provenance}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="opda:work-area" content={routeStatus.workArea} />
  <meta name="opda:authority" content={routeStatus.authority} />
  <meta name="opda:maturity" content={routeStatus.maturity} />
  <meta name="opda:version" content={routeStatus.version} />
  <meta name="opda:provenance" content={routeStatus.provenance} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    (function () {
      try {
        var t = new URLSearchParams(location.search).get('theme');
        if (t !== 'light' && t !== 'dark') t = localStorage.getItem('opda-theme');
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <link rel="stylesheet" href="/ui/design-system.css" />
</head>
<body class="public-site">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <main id="main-content" tabindex="-1">
    <section class="home-campaign-hero wg-campaign-hero" aria-labelledby="public-title">
      <div class="wg-campaign-hero__copy">
        <BrandHeading surface="dark" campaign />
        <p class="wg-eyebrow">Smart Property Data Trust Framework</p>
        <h1 id="public-title">A shared language for property data, <em>drafted in the open.</em></h1>
        <p class="wg-lead">
          The Open Property Data Association and organisations across the property industry
          are developing the Smart Property Data Trust Framework to support the Government’s
          Smart Data programme, making property information easier to share, understand and
          trust throughout every transaction.
        </p>
        <div class="wg-hero-actions">
          <a class="btn wg-btn--large" href="/spdtf">Explore SPDTF development</a>
          <a class="btn btn--outline-dark wg-btn--large" href="/programme">Understand the programme</a>
          <a class="btn btn--outline-dark wg-btn--large" href="/join">Join a working group</a>
        </div>
      </div>

      <div class="wg-hero-journey" aria-labelledby="public-domains-title">
        <p class="wg-eyebrow">Working Group</p>
        <h2 id="public-domains-title">Domains</h2>
        <ol class="wg-process home-domain-process">
          {domains.map((domain) => (
            <li><strong>{domain.name}</strong><span>{domain.description}</span></li>
          ))}
        </ol>
      </div>
    </section>
    <div class="home-content-surface">
      <MethodFlowFigure />
      <KickoffFeature />
      <nav class="public-overview" aria-labelledby="inside-title">
        <header>
          <p class="overline">Choose your route</p>
          <h2 id="inside-title">Explore the programme and how SPDTF is developed</h2>
        </header>
        <DestinationCards />
      </nav>
      <section class="public-join" aria-labelledby="join-title">
        <div class="public-join__inner">
          <p class="public-join__overline">Contribute</p>
          <h2 id="join-title">Bring your expertise to the draft.</h2>
          <p>
            Working groups need people who know how property really transacts — agents,
            lenders, conveyancers, surveyors and data specialists. No modelling background
            is required.
          </p>
          <a class="btn" href="/join">Join a working group</a>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
  <script is:inline src="/ui/client.js"></script>
</body>
</html>

<style>
  .home-campaign-hero {
    --campaign-max: var(--content-max);
    grid-template-columns: minmax(0, 1.05fr) minmax(36rem, 0.95fr);
    padding-top: var(--space-6);
  }
  .home-content-surface {
    --home-frame-gutter: max(
      clamp(var(--space-5), 5vw, var(--space-10)),
      calc((100vw - var(--content-max)) / 2)
    );
  }
  .home-campaign-hero .wg-campaign-hero__copy > .wg-eyebrow {
    font-size: clamp(1rem, 1.25vw, 1.25rem);
  }
  .home-campaign-hero .wg-hero-journey {
    margin-top: 0;
    transform: translateY(clamp(2.5rem, 4vw, 4rem));
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process li) {
    row-gap: var(--space-2);
    padding: var(--space-4) 0;
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process strong) {
    font: 600 clamp(1.125rem, 1.3vw, 1.3rem) / 1.25 var(--font-display);
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process span) {
    font-size: clamp(0.9375rem, 1vw, 1rem);
    line-height: 1.55;
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process) {
    border-bottom: 0;
  }
  .home-campaign-hero .wg-hero-actions {
    flex-wrap: nowrap;
    gap: var(--space-5);
  }
  .home-campaign-hero .wg-btn--large {
    min-height: 3rem;
    padding-inline: var(--space-4);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .home-content-surface {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .home-content-surface :global(.method-flow__inner),
  .home-content-surface :global(.kickoff-feature__inner),
  .home-content-surface :global(.public-overview),
  .home-content-surface .public-join {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--home-frame-gutter);
  }
  .home-content-surface :global(.method-flow),
  .home-content-surface :global(.kickoff-feature) {
    color: var(--color-text);
    background: transparent;
    border-bottom: 1px solid var(--color-border);
  }
  .home-content-surface :global(.kickoff-feature h2) { color: var(--color-text-strong); }
  .home-content-surface :global(.kickoff-feature__overline),
  .home-content-surface :global(.kickoff-feature__copy > p:not(.kickoff-feature__overline)) {
    color: var(--color-text-muted);
  }

  .public-join {
    width: min(100%, var(--content-max));
    margin: 0 auto;
    padding: 0 var(--space-7) var(--space-10);
    background: var(--color-surface);
  }
  .public-join__inner {
    width: 100%;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--brand-yellow);
    background: var(--color-surface-card);
  }
  .public-join__overline {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font: 700 var(--text-xs) / 1.3 var(--font-sans);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }
  .public-join h2 { margin: 0; font: var(--h2); }
  .public-join__inner > p:not(.public-join__overline) {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font: var(--lead);
  }
  .public-join .btn { margin-top: var(--space-6); }

  @media (max-width: 72rem) {
    .home-campaign-hero {
      grid-template-columns: 1fr;
    }
    .home-campaign-hero .wg-hero-journey { transform: none; }
    .home-campaign-hero .wg-hero-actions {
      flex-wrap: wrap;
      gap: var(--space-4);
    }
    .home-campaign-hero .wg-btn--large {
      min-height: 3.25rem;
      padding-inline: var(--space-6);
      font-size: var(--text-base);
    }
  }

  @media (max-width: 40rem) {
    .home-content-surface :global(.method-flow__inner),
    .home-content-surface :global(.kickoff-feature__inner),
    .home-content-surface :global(.public-overview),
    .home-content-surface .public-join { padding-inline: var(--space-5); }
    .public-join { padding-block: 0 var(--space-8); }
    .public-join__inner { width: 100%; padding: var(--space-6); }
  }

  @media (forced-colors: active) {
    .wg-hero-journey,
    .wg-hero-journey .wg-process li,
    .public-join__inner { border-color: CanvasText; }
  }

  @media print {
    .home-campaign-hero {
      color: black;
      background: white;
      border-bottom-color: black;
    }
    .home-campaign-hero h1,
    .home-campaign-hero h1 em,
    .home-campaign-hero .wg-eyebrow,
    .home-campaign-hero .wg-lead,
    .home-campaign-hero .wg-hero-journey h2,
    .home-campaign-hero .wg-process strong,
    .home-campaign-hero .wg-process span,
    .home-campaign-hero .wg-process li::before { color: black; }
    .home-campaign-hero .wg-hero-journey,
    .home-campaign-hero .wg-process,
    .home-campaign-hero .wg-process li { border-color: black; }
    .home-campaign-hero .wg-hero-actions .btn {
      color: black;
      background: white;
      border: 1px solid black;
    }
    .public-join__inner { break-inside: avoid; }
  }
</style>
