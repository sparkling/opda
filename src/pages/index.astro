---
import {
  GLOBAL_DESTINATIONS,
  IA_STATUS_REGISTRY_VERSION,
  getRouteStatus,
} from '@/lib/site-ia.mjs';

const title = 'OPDA Knowledge Base';
const description =
  'Explore the OPDA programme, governance, semantic modelling, SPDTF development, working groups and evidence behind a shared language for property data.';
const routeStatus = getRouteStatus('/');

const destinationDetails = {
  programme: {
    audience: 'For programme leaders and new readers',
    description: 'Understand the purpose, current direction, roadmap and policy context for a shared property-data scheme.',
    action: 'Understand the programme',
  },
  governance: {
    audience: 'For decision-makers and reviewers',
    description: 'See who can decide, what is under review, and how authority, maturity and lifecycle are recorded.',
    action: 'Check governance',
  },
  'semantic-modelling': {
    audience: 'For domain experts and ontology learners',
    description: 'Learn why ontologies are used, then follow the evidence-up method, contextual boundaries and mapping approach.',
    action: 'Explore semantic modelling',
  },
  spdtf: {
    audience: 'For implementers, stewards and interoperability leads',
    description: 'Review collaborative work products, candidates, open questions, outputs and attributed third-party inputs.',
    action: 'Review SPDTF development',
  },
  'working-groups': {
    audience: 'For contributors and facilitators',
    description: 'Find group scopes, member guidance, contribution routes and the workspaces where domain meaning is reviewed.',
    action: 'Visit the working groups',
  },
  resources: {
    audience: 'For researchers and auditors',
    description: 'Trace terms, source records, standards, recordings and historical material with their provenance and maturity.',
    action: 'Find evidence and resources',
  },
};

const destinationCards = GLOBAL_DESTINATIONS.map((destination) => ({
  ...destination,
  ...destinationDetails[destination.key],
}));
---
<!doctype html>
<html lang="en" data-ia-status-version={IA_STATUS_REGISTRY_VERSION} data-work-area={routeStatus.workArea} data-authority={routeStatus.authority} data-maturity={routeStatus.maturity} data-content-version={routeStatus.version} data-provenance={routeStatus.provenance}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="opda:work-area" content={routeStatus.workArea} />
  <meta name="opda:authority" content={routeStatus.authority} />
  <meta name="opda:maturity" content={routeStatus.maturity} />
  <meta name="opda:version" content={routeStatus.version} />
  <meta name="opda:provenance" content={routeStatus.provenance} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    (function () {
      try {
        var t = new URLSearchParams(location.search).get('theme');
        if (t !== 'light' && t !== 'dark') t = localStorage.getItem('opda-theme');
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <link rel="stylesheet" href="/ui/design-system.css" />
</head>
<body class="public-site">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="public-header">
    <a href="/" aria-label="Open Property Data Association home">
      <img src="/ui/brand/opda-wordmark-white.svg" alt="Open Property Data Association" width="149" height="42" />
    </a>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66l1.42-1.42M4.92 19.08l1.42-1.42m11.32 0l1.42 1.42M4.92 4.92l1.42 1.42M12 7a5 5 0 100 10 5 5 0 000-10z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
      </svg>
    </button>
    <a class="public-header__signin" href="/home">
      <span class="public-header__signin-full">Members enter the knowledge base</span>
      <span class="public-header__signin-short">Enter</span>
    </a>
  </header>
  <main id="main-content" tabindex="-1">
    <section class="public-hero" aria-labelledby="public-title">
      <div class="public-hero__inner">
        <p class="eyebrow">OPDA Knowledge Base</p>
        <h1 id="public-title">One shared language for property data.</h1>
        <p>
          This is the shared workspace for people shaping SPDTF: a property-data
          scheme being developed collaboratively across industry and with stakeholders.
          Understand the programme, follow how meaning and decisions are governed,
          review the developing work, or take part.
        </p>
        <div class="public-hero__actions">
          <a class="btn" href="/home">Enter the knowledge base</a>
          <a class="btn btn--outline-dark" href="/working-groups/join">Join a working group</a>
        </div>
      </div>
    </section>
    <dl class="public-status" aria-label="SPDTF programme status and authority">
      <div><dt>Status</dt><dd>SPDTF is in development</dd></div>
      <div><dt>Authority</dt><dd>Human working groups own domain meaning</dd></div>
      <div><dt>Evidence</dt><dd>Sources, candidates and decisions stay distinct</dd></div>
    </dl>
    <nav class="public-overview" aria-labelledby="inside-title">
      <header>
        <p class="overline">Choose your route</p>
        <h2 id="inside-title">Start with the work you need to do</h2>
      </header>
      <div class="card-grid">
        {destinationCards.map((destination) => (
          <a class="card" href={destination.url}>
            <span class="card__eyebrow">{destination.audience}</span>
            <h3>{destination.title}</h3>
            <p>{destination.description}</p>
            <span class="card__action">
              {destination.action}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </nav>
  </main>
  <footer class="public-footer">
    <img src="/ui/brand/opda-wordmark-white.svg" alt="Open Property Data Association" width="149" height="42" />
    <span>Property data that people and systems can understand together.</span>
    <a href="https://openpropdata.org.uk/" rel="noopener">Visit the association website</a>
  </footer>
  <script is:inline src="/ui/client.js"></script>
</body>
</html>
