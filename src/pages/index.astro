---
import {
  IA_STATUS_REGISTRY_VERSION,
  getRouteStatus,
} from '@/lib/site-ia.mjs';
import DestinationCards from '@/components/ia/DestinationCards.astro';
import BrandHeading from '@/components/BrandHeading.astro';
import FrameworkHeading from '@/components/FrameworkHeading.astro';
import HeaderPreviewControls from '@/components/HeaderPreviewControls.astro';
import { HEADER_ICON_IDS } from '@/lib/header-icons';
import { HEADER_PALETTE_IDS } from '@/lib/header-palettes';
import { assetVersion } from '@/lib/asset-version.mjs';
import KickoffFeature from '@/components/home/KickoffFeature.astro';
import MethodFlowFigure from '@/components/home/MethodFlowFigure.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { Database, HousePlug, Landmark, Megaphone, RulerDimensionLine, Scale } from '@lucide/astro';
import '@/styles/working-group-campaign.css';
import '@/styles/working-group-campaign-responsive.css';

const title = 'OPDA Knowledge Base';
const description =
  'Explore the OPDA programme, governance, semantic modelling, SPDTF development, working groups and evidence behind a shared language for property data.';
const routeStatus = getRouteStatus('/');
const clientV = assetVersion('/ui/client.js');
const homeHeaderIcon = 'common-boundary';
const homeHeaderPalette = 'clay-indigo';
const homeHeaderScale = 32;
const homeHeaderOpdaScale = 100;
const homeHeaderSpaceAbove = 59;
const homeHeaderLineGap = 0;
const homeHeaderSpaceBelow = 16;
const homeHeaderStyle = [
  `--identity-heading-size:${homeHeaderScale}px`,
  `--identity-opda-scale:${homeHeaderOpdaScale / 100}`,
  `--identity-space-before:${homeHeaderSpaceAbove}px`,
  `--identity-line-gap:${homeHeaderLineGap}px`,
  `--identity-space-after:${homeHeaderSpaceBelow}px`,
].join(';');
const domains = [
  { name: 'Conveyancing', description: 'Legal title, ownership, disclosure, completion and transfer.', icon: Scale },
  { name: 'Estate agency', description: 'Marketing, pricing, letting, media and consumer disclosure.', icon: Megaphone },
  { name: 'Finance and banking', description: 'Mortgages, repayment, insurance and financial obligations.', icon: Landmark },
  { name: 'Property data services', description: 'Searches, registers, certificates and utility records.', icon: Database },
  { name: 'Property technology', description: 'Digital property records, smart home capabilities and connectivity.', icon: HousePlug },
  { name: 'Surveying and valuation', description: 'Construction, condition, alterations and installed features.', icon: RulerDimensionLine },
];

---
<!doctype html>
<html lang="en" data-ia-status-version={IA_STATUS_REGISTRY_VERSION} data-work-area={routeStatus.workArea} data-authority={routeStatus.authority} data-maturity={routeStatus.maturity} data-content-version={routeStatus.version} data-provenance={routeStatus.provenance}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="opda:work-area" content={routeStatus.workArea} />
  <meta name="opda:authority" content={routeStatus.authority} />
  <meta name="opda:maturity" content={routeStatus.maturity} />
  <meta name="opda:version" content={routeStatus.version} />
  <meta name="opda:provenance" content={routeStatus.provenance} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <script
    is:inline
    data-astro-rerun
    define:vars={{
      defaultHeaderPalette: homeHeaderPalette,
      headerPaletteIds: HEADER_PALETTE_IDS,
      defaultHeaderIcon: homeHeaderIcon,
      headerIconIds: HEADER_ICON_IDS,
    }}
  >
    (function () {
      try {
        var t = new URLSearchParams(location.search).get('theme');
        if (t !== 'light' && t !== 'dark') t = localStorage.getItem('opda-theme');
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);

        var p = localStorage.getItem('opda-header-palette');
        if (!headerPaletteIds.includes(p)) p = defaultHeaderPalette;
        document.documentElement.setAttribute('data-header-palette', p);

        var i = localStorage.getItem('opda-header-icon');
        if (!headerIconIds.includes(i)) i = defaultHeaderIcon;
        document.documentElement.setAttribute('data-header-icon', i);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
        document.documentElement.setAttribute('data-header-palette', defaultHeaderPalette);
        document.documentElement.setAttribute('data-header-icon', defaultHeaderIcon);
      }
    })();
  </script>
  <link rel="stylesheet" href="/ui/design-system.css" />
</head>
<body class="public-site">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <main id="main-content" tabindex="-1">
    <section class="home-campaign-hero wg-campaign-hero wg-campaign-hero--panel-aligned" aria-labelledby="public-title">
      <header class="wg-campaign-hero__header">
        <div class="wg-campaign-identity" id="home-campaign-identity" style={homeHeaderStyle}>
          <BrandHeading variant="paired" />
          <FrameworkHeading scale="display" />
        </div>
        <ThemeToggle />
      </header>

      <div class="wg-campaign-hero__copy">
        <h1 id="public-title">A shared language for property data, <em>drafted in the open.</em></h1>
        <p class="wg-lead">
          The Open Property Data Association and organisations across the property industry
          are developing the Smart Property Data Trust Framework to support the Government’s
          Smart Data programme, making property information easier to share, understand and
          trust throughout every transaction.
        </p>
        <div class="wg-hero-actions">
          <a class="btn wg-btn--large" href="/development">Explore SPDTF development</a>
          <a class="btn btn--outline-dark wg-btn--large" href="/programme">Understand the programme</a>
          <a class="btn btn--outline-dark wg-btn--large" href="/join">Join a working group</a>
        </div>
      </div>

      <div class="home-campaign-side">
        <HeaderPreviewControls
          showScaleControl
          controlId="home-header-preview-selectors"
          identityId="home-campaign-identity"
          initialScale={homeHeaderScale}
          initialOpdaScale={homeHeaderOpdaScale}
          initialSpaceAbove={homeHeaderSpaceAbove}
          initialLineGap={homeHeaderLineGap}
          initialSpaceBelow={homeHeaderSpaceBelow}
          initialIcon={homeHeaderIcon}
          initialPalette={homeHeaderPalette}
        />
        <div class="wg-hero-journey" aria-labelledby="public-domains-title">
          <p class="wg-eyebrow">Working Group</p>
          <h2 id="public-domains-title">Domains</h2>
          <ul class="wg-process home-domain-process" role="list">
            {domains.map(({ name, description, icon: DomainIcon }) => (
              <li>
                <span class="wg-process__icon" aria-hidden="true"><DomainIcon /></span>
                <strong>{name}</strong>
                <span>{description}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
    <div class="home-content-surface">
      <MethodFlowFigure />
      <KickoffFeature />
      <nav class="public-overview" aria-labelledby="inside-title">
        <header class="section-heading">
          <p class="section-heading__eyebrow">Choose your route</p>
          <h2 id="inside-title">Explore the programme and how SPDTF is developed</h2>
        </header>
        <DestinationCards />
      </nav>
      <section class="public-join" aria-labelledby="join-title">
        <div class="public-join__inner">
          <header class="section-heading">
            <p class="section-heading__eyebrow">Contribute</p>
            <h2 id="join-title">Bring your expertise to the draft.</h2>
          </header>
          <p class="public-join__description">
            Working groups need people who know how property really transacts — agents,
            lenders, conveyancers, surveyors and data specialists. No modelling background
            is required.
          </p>
          <a class="btn" href="/join">Join a working group</a>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
  <script is:inline src={`/ui/client.js?v=${clientV}`}></script>
</body>
</html>

<style>
  .home-campaign-hero {
    --campaign-max: var(--content-max);
  }
  :global(:root[data-theme='light']) .home-campaign-hero {
    color: var(--brand-deep);
    background:
      radial-gradient(circle at 15% 20%, rgb(91 81 216 / 12%), transparent 31rem),
      linear-gradient(135deg, var(--brand-white) 0 62%, var(--neutral-100) 62% 100%);
  }
  :global(:root[data-theme='light']) .home-campaign-hero h1,
  :global(:root[data-theme='light']) .home-campaign-hero .wg-hero-journey h2,
  :global(:root[data-theme='light']) .home-campaign-hero .wg-process strong {
    color: var(--brand-deep);
  }
  :global(:root[data-theme='light']) .home-campaign-hero h1 em {
    color: var(--color-link);
  }
  :global(:root[data-theme='light']) .home-campaign-hero .wg-eyebrow,
  :global(:root[data-theme='light']) .home-campaign-hero .wg-lead,
  :global(:root[data-theme='light']) .home-campaign-hero .wg-process span {
    color: var(--color-text-muted);
  }
  :global(:root[data-theme='light']) .home-campaign-hero .wg-hero-journey {
    background: rgb(255 255 255 / 88%);
    border-color: var(--color-border);
    border-top-color: var(--brand-yellow);
    box-shadow: var(--shadow-sm);
  }
  :global(:root[data-theme='light']) .home-campaign-hero .wg-process li {
    border-color: var(--color-border);
  }
  :global(:root[data-theme='light']) .home-campaign-hero .wg-process .wg-process__icon {
    color: var(--color-status-warning);
  }
  :global(:root[data-theme='light']) .home-campaign-hero .btn--outline-dark {
    color: var(--brand-deep);
    background: rgb(255 255 255 / 56%);
    border-color: var(--brand-deep);
  }
  :global(:root[data-theme='light']) .home-campaign-hero .btn--outline-dark:hover {
    color: var(--brand-deep);
    background: var(--neutral-100);
  }
  .home-content-surface {
    --home-frame-gutter: max(
      clamp(var(--space-5), 5vw, var(--space-10)),
      calc((100vw - var(--content-max)) / 2)
    );
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process li) {
    row-gap: var(--space-2);
    padding: var(--space-6) 0;
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process li:last-child) {
    padding-bottom: var(--space-3);
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process .wg-process__icon svg) {
    width: 2.25rem;
    height: 2.25rem;
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process strong) {
    white-space: nowrap;
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process li > span:not(.wg-process__icon)) {
    font-size: clamp(0.875rem, 1vw, 1rem);
    white-space: nowrap;
  }
  .home-campaign-hero .wg-hero-journey :global(.home-domain-process) {
    border-bottom: 0;
  }
  .home-content-surface {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .home-content-surface :global(.method-flow__inner),
  .home-content-surface :global(.kickoff-feature__inner),
  .home-content-surface :global(.public-overview),
  .home-content-surface .public-join {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--home-frame-gutter);
  }
  .home-content-surface :global(.method-flow) {
    color: var(--color-text);
    background: transparent;
    border-bottom: 1px solid var(--color-border);
  }

  .public-join {
    width: min(100%, var(--content-max));
    margin: 0 auto;
    padding: 0 var(--space-7) var(--space-10);
    background: var(--color-surface);
  }
  .public-join__inner {
    width: 100%;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--brand-yellow);
    background: var(--color-surface-card);
  }
  .public-join .section-heading { margin-bottom: 0; }
  .public-join__description {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font: var(--lead);
  }
  .public-join .btn { margin-top: var(--space-6); }

  @media (max-width: 72rem) {
    .home-campaign-hero {
      grid-template-columns: 1fr;
    }
    .home-campaign-hero .wg-hero-journey { transform: none; }
  }

  @media (max-width: 40rem) {
    .home-content-surface :global(.method-flow__inner),
    .home-content-surface :global(.kickoff-feature__inner),
    .home-content-surface :global(.public-overview),
    .home-content-surface .public-join { padding-inline: var(--space-5); }
    .public-join { padding-block: 0 var(--space-8); }
    .public-join__inner { width: 100%; padding: var(--space-6); }
  }

  @media (forced-colors: active) {
    .wg-hero-journey,
    .wg-hero-journey .wg-process li,
    .public-join__inner { border-color: CanvasText; }
  }

  @media print {
    .home-campaign-hero .theme-toggle { display: none; }
    .home-campaign-hero {
      color: black;
      background: white;
      border-bottom-color: black;
    }
    .home-campaign-hero h1,
    .home-campaign-hero h1 em,
    .home-campaign-hero .wg-eyebrow,
    .home-campaign-hero .wg-lead,
    .home-campaign-hero .wg-hero-journey h2,
    .home-campaign-hero .wg-process strong,
    .home-campaign-hero .wg-process span,
    .home-campaign-hero .wg-process__icon { color: black; }
    .home-campaign-hero .wg-hero-journey,
    .home-campaign-hero .wg-process,
    .home-campaign-hero .wg-process li { border-color: black; }
    .home-campaign-hero .wg-hero-actions .btn {
      color: black;
      background: white;
      border: 1px solid black;
    }
    .public-join__inner { break-inside: avoid; }
  }
</style>
