---
import Layout from '@/layouts/Layout.astro';
---
<Layout
  title="Check your subscription details"
  description="Some required newsletter subscription details were missing or invalid."
  hideSidebar
  hideBreadcrumbs
  hideFooter
  hideComments
  suppressActiveDestination
>
  <h1>Check your subscription details</h1>
  <p class="lead">Some required information was missing or could not be accepted.</p>
  <p><a class="btn" href="/subscribe">Return to the subscription form</a></p>
</Layout>
