---
import Layout from '@/layouts/Layout.astro';
import PageMeta from '@/components/PageMeta.astro';
import GatewayCard from '@/components/ia/GatewayCard.astro';
import { model } from '@/lib/ontology-model';

const contexts = Object.values(model.contexts).sort((a, b) => a.localName.localeCompare(b.localName));
const resourceCount = (context: (typeof contexts)[number]) =>
  context.classes.length
  + context.objectProperties.length
  + context.datatypeProperties.length
  + context.shapes.length
  + context.schemes.length;
---

<Layout
  title="Ontology contexts"
  description="Browse the graph-derived bounded-context modules of the PDTF 1.0-derived ontology and the classes, properties, shapes and schemes assigned to each."
>
  <PageMeta category="PDTF 1.0 · extracted ontology" variant="brand" updated="Draft · under review" />
  <h1>Ontology contexts</h1>
  <p class="lead">
    Contexts provide a domain-oriented way to enter the extracted corpus. Each page gathers
    the classes, object properties, datatype properties, SHACL shapes and SKOS schemes assigned
    to one graph-derived module, while keeping links to resources owned by neighbouring modules.
  </p>

  <div class="callout callout--warn">
    <p class="callout__label">PDTF 1.0 contexts, not SPDTF 2.0 authority</p>
    <p>
      These are module groupings in the draft PDTF 1.0-derived ontology. They are not approved
      SPDTF 2.0 bounded-context models and do not confer working-group ownership. Read the
      <a href="/spdtf-2/ontologies/bounded-contexts">SPDTF 2.0 context method</a> for the current
      evidence-up approach.
    </p>
  </div>

  <h2 id="how-to-read">How to read a context page</h2>
  <table>
    <thead><tr><th scope="col">Layer</th><th scope="col">What membership tells you</th></tr></thead>
    <tbody>
      <tr><th scope="row">Classes</th><td>The primary kinds, roles, relators and information objects documented in the module.</td></tr>
      <tr><th scope="row">Properties</th><td>The relationships and literal attributes assigned to the module; their targets may cross a context boundary.</td></tr>
      <tr><th scope="row">Shapes</th><td>The constraints grouped with the module. Shape membership does not turn a closed-world check into OWL semantics.</td></tr>
      <tr><th scope="row">Schemes</th><td>The controlled value spaces associated with the module, represented separately from OWL class hierarchies.</td></tr>
    </tbody>
  </table>

  <h2 id="index">Browse contexts</h2>
  <div class="card-grid">
    {contexts.map((context) => (
      <GatewayCard
        href={`/ontology/context/${context.id}`}
        title={context.localName}
        eyebrow="Ontology module"
        description={`${resourceCount(context)} indexed resources: ${context.classes.length} classes, ${context.objectProperties.length + context.datatypeProperties.length} properties, ${context.shapes.length} shapes and ${context.schemes.length} schemes.`}
      />
    ))}
  </div>

  <h2 id="boundary">Context membership is a navigation lens</h2>
  <p>
    The pages expose how the committed model is partitioned; they do not assert that every
    relationship is local or that every resource has only one professional interpretation.
    Cross-context links are expected. The <a href="/modelling/bounded-contexts">historical PDTF modelling record</a>
    explains the earlier DDD framing, while SPDTF 2.0 working groups must review meaning from
    attributed domain evidence rather than inherit this partition uncritically.
  </p>
</Layout>
