---
import GraphDiagram from '@/components/GraphDiagram.astro';
import PropertyPackDiagramLegend from '@/components/property-pack/PropertyPackDiagramLegend.astro';
import PropertyPackPage from '@/components/property-pack/PropertyPackPage.astro';
import {
  contextById,
  dataPointRoute,
  resourceRoute,
  workPackageDiagram,
  workPackageDiagramProjection,
  workPackages,
} from '@/lib/property-pack-model.mjs';

export function getStaticPaths() {
  return workPackages.map((workPackage) => ({ params: { workPackage: workPackage.id }, props: { workPackage } }));
}

const { workPackage } = Astro.props;
const graph = workPackageDiagramProjection(workPackage.id);
---
<PropertyPackPage
  title={workPackage.label}
  description={`Source coverage and candidate model view for the ${workPackage.label} Property Pack work package.`}
  category="Work-package coverage"
  crumbs={[
    { label: 'Work-package coverage', href: '/development/property-pack/work-packages' },
    { label: workPackage.label },
  ]}
>
  <h1>{workPackage.label}</h1>
  <p class="lead">This source work package contains {workPackage.items.length} related Property Pack data points. It is a review lens over the source catalogue; it does not define a bounded context or approve the candidate interpretation.</p>

  <h2 id="diagram">Candidate model view</h2>
  <p>Classes are nodes and object properties are labelled relationships. Solid lines connect classes reached within this work package. Dotted lines show incoming and outgoing properties that attach those classes to one-hop classes outside the work package. Datatype, coded-value, external-target and domainless properties remain in the structured register.</p>
  <PropertyPackDiagramLegend variant="work-package" />
  <GraphDiagram
    source={workPackageDiagram(workPackage.id)}
    minHeight={graph.displayedResources.length > 15 ? '760px' : '560px'}
    caption={`${workPackage.label}: ${workPackage.items.length} source data points, ${graph.reachedClasses.length} reached classes, ${graph.attachedClasses.length} attached classes, ${graph.relationships.length} internal relationships, ${graph.incomingProperties.length} dotted incoming relationships and ${graph.outgoingProperties.length} dotted outgoing relationships. Click a class to open its resource reference.`}
  />

  <h2 id="source-items">Source data points</h2>
  <div class="v2-table-wrap">
    <table>
      <thead><tr><th>Data point</th><th>Semantic home</th><th>Modelling disposition</th><th>Candidate constructs</th></tr></thead>
      <tbody>{workPackage.items.map((item) => <tr><td><a href={dataPointRoute(item)}>{item.preferred_label}</a></td><td>{contextById.get(item.semantic_home)?.label ?? item.semantic_home}</td><td>{item.disposition}</td><td>{item.construct_refs.length}</td></tr>)}</tbody>
    </table>
  </div>

  <h2 id="resources">Directly reached candidate resources</h2>
  <div class="v2-table-wrap">
    <table>
      <thead><tr><th>Resource</th><th>Kind</th><th>Semantic home</th><th>Evidence traces</th></tr></thead>
      <tbody>{workPackage.resources.map((resource) => <tr><td><a href={resourceRoute(resource)}>{resource.label}</a></td><td>{resource.kind}</td><td>{contextById.get(resource.semantic_home)?.label ?? resource.semantic_home}</td><td>{resource.source_item_ids.length}</td></tr>)}</tbody>
    </table>
  </div>
</PropertyPackPage>
