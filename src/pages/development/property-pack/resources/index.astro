---
import OntologyBrowser from '@/components/ontology/OntologyBrowser.astro';
import PropertyPackPage from '@/components/property-pack/PropertyPackPage.astro';
import { projectCandidateResources } from '@/lib/ontology-browser/projection.mjs';
import {
  contexts,
  contextRoute,
  resourceRoute,
  resources,
} from '@/lib/property-pack-model.mjs';

const entries = projectCandidateResources(resources, contexts, resourceRoute, contextRoute);
---
<PropertyPackPage
  title="Ontology resources"
  description="Complete reference for all 159 classes, object properties and datatype properties in the machine-generated Property Pack pre-draft."
  category="Meaning & constraints"
  crumbs={[{ label: 'Ontology resources' }]}
>
  <h1>Ontology resources</h1>
  <p class="lead">
    The complete human-readable register of the candidate’s 159 OWL resources. Each
    resource has one semantic home and a trace to the Property Pack source data points
    that motivated it directly or structurally.
  </p>


  <h2 id="register">Resource register</h2>
  <p>Search and combine filters, then inspect a resource to follow its superclass, subclasses,
    domains and ranges. Open its complete reference for constraints, vocabularies and source evidence.</p>
  <OntologyBrowser id="v2-resource-register" entries={entries} contextLabel="Semantic home" />

  <h2 id="reading">How to read the register</h2>
  <div class="v2-note-grid">
    <section>
      <h3>Semantic home</h3>
      <p>Every resource belongs to exactly one bounded, common or scheme context. A context owns its internal meaning; the common boundary is deliberately exceptional and small.</p>
    </section>
    <section>
      <h3>Direct and structural traces</h3>
      <p>Direct traces motivated the term itself. Structural traces reach an organising superclass through its descendants. They are shown separately so inherited evidence is never mistaken for direct evidence.</p>
    </section>
    <section>
      <h3>Candidate definitions</h3>
      <p>Definitions are machine-proposed modelling statements for working-group review. They do not replace the original source wording shown in the data dictionary.</p>
    </section>
  </div>
</PropertyPackPage>
