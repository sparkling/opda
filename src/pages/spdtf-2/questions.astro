---
import Layout from '@/layouts/Layout.astro';
import PageMeta from '@/components/PageMeta.astro';
import AuthorityPanel from '@/components/ia/AuthorityPanel.astro';
import { WORKING_GROUPS } from '@/components/ia/working-groups';
import { getWorkspaceRecord } from '@/lib/spdtf-workspace.mjs';
---

<Layout title="SPDTF 2.0 open questions" description="Canonical index of initial competency questions across the SPDTF 2.0 working groups.">
  <PageMeta category="Open questions" variant="warn" updated="Initial prompts · participant challenge required" />
  <h1>Open questions and changes</h1>
  <p class="lead">These are initial competency questions, not approved requirements. Each question is owned and reviewed in one canonical group workspace.</p>
  <AuthorityPanel destination="spdtf-2" />
  {WORKING_GROUPS.map((group) => {
    const workspace = getWorkspaceRecord(group.slug);
    return (
      <section aria-labelledby={`group-${group.slug}`}>
        <h2 id={`group-${group.slug}`}>{group.name}</h2>
        <ol>{workspace.competencyQuestions.map((question) => <li>{question}</li>)}</ol>
        <p><a href={`/spdtf-2/working-groups/${group.slug}/questions`}>Review this group’s question records →</a></p>
      </section>
    );
  })}
</Layout>

