---
import GraphDiagram from '@/components/GraphDiagram.astro';
import PropertyPackContents from '@/components/property-pack/PropertyPackContents.astro';
import PropertyPackDiagramLegend from '@/components/property-pack/PropertyPackDiagramLegend.astro';
import PropertyPackPage from '@/components/property-pack/PropertyPackPage.astro';
import {
  compactIri,
  contextById,
  contextDiagram,
  contextDiagramProjection,
  contextKindLabels,
  contextRoute,
  contexts,
  contextStats,
  generatedFilesForContext,
  kindLabels,
  resourceByIri,
  resourceRoute,
  resourcesByContext,
  shapeRoute,
  shapesByContext,
  structuralRows,
  vocabulariesByContext,
  vocabularyRoute,
} from '@/lib/property-pack-model.mjs';

export function getStaticPaths() {
  return contexts.map((context) => ({ params: { context: context.id }, props: { context } }));
}

const { context } = Astro.props;
const contextDisplayLabel = context.id === 'dbt-smart-data'
  ? 'DBT Smart Data candidate semantic context'
  : context.label;
const stats = contextStats(context.id);
const ownedResources = resourcesByContext.get(context.id) ?? [];
const ownedShapes = shapesByContext.get(context.id) ?? [];
const ownedSchemes = vocabulariesByContext.get(context.id) ?? [];
const graph = contextDiagramProjection(context.id);
const rows = structuralRows(graph.carriers);
const files = {
  ontology: generatedFilesForContext(context.id, 'ontology'),
  shapes: generatedFilesForContext(context.id, 'shapes'),
  vocabularies: generatedFilesForContext(context.id, 'vocabularies'),
};

function targetLabel(row) {
  return row.target?.label ?? compactIri(row.targetIri);
}

function semanticHomeLabel(row) {
  const resource = row.edgeKind === 'subclass' ? row.source : row.relationship;
  return contextById.get(resource.semantic_home)?.label ?? resource.semantic_home;
}
---
<PropertyPackPage
  title={contextDisplayLabel}
  description={`${contextDisplayLabel} in the machine-generated Property Pack ontology candidate: definitions, resources, relationships, SHACL constraints, vocabularies and source scope.`}
  category={contextKindLabels[context.kind]}
  crumbs={[
    { label: 'Contextual boundaries', href: '/spdtf-2/property-pack/contexts' },
    { label: contextDisplayLabel },
  ]}
>
  <h1>{contextDisplayLabel}</h1>
  <p class="lead">{context.definition}</p>

  {context.kind === 'common-boundary' && (
    <div class="callout callout--key"><p class="callout__label">Deliberately small</p><p>The Common boundary supports exchange; it does not control each domain’s internal meaning.</p></div>
  )}
  {context.kind === 'scheme-context' && (
    <div class="callout callout--warn"><p class="callout__label">Machine-proposed scheme context</p><p>This is the Property Pack candidate's proposed semantic home for cross-sector authorisation and sharing meaning. It is not one of the six property-domain bounded contexts, the external DBT programme or an OPDA working-group decision.</p></div>
  )}

  <PropertyPackContents items={[
    { id: 'summary', label: 'Context summary' },
    { id: 'diagram', label: 'Complete context diagram' },
    { id: 'resources', label: 'Owned resources' },
    { id: 'relationships', label: 'Structured relationship view' },
    { id: 'constraints', label: 'SHACL constraints' },
    { id: 'vocabularies', label: 'Controlled vocabularies' },
    { id: 'artefacts', label: 'Generated artefacts' },
  ]} />

  <h2 id="summary">Context summary</h2>
  <div class="v2-metrics">
    <div class="v2-metric"><strong>{stats.resources}</strong><span>owned OWL resources</span></div>
    <div class="v2-metric"><strong>{stats.classes}</strong><span>classes</span></div>
    <div class="v2-metric"><strong>{stats.objectProperties}</strong><span>object properties</span></div>
    <div class="v2-metric"><strong>{stats.datatypeProperties}</strong><span>datatype properties</span></div>
    <div class="v2-metric"><strong>{stats.sourceItems}</strong><span>source data points with this semantic home</span></div>
    <div class="v2-metric"><strong>{stats.constraints}</strong><span>SHACL property constraints</span></div>
  </div>

  <h2 id="diagram">Complete context diagram</h2>
  <p>Every resource owned by this semantic home is included, together with one-hop incoming and outgoing properties and their attached resources. Dotted nodes and links identify resources owned by another semantic home; the owning boundary appears beneath each foreign resource. Referenced standards remain visually distinct. These are asserted OWL relationships, not reviewed cross-domain mappings.</p>
  <PropertyPackDiagramLegend variant="context" />
  <GraphDiagram
    source={contextDiagram(context.id)}
    minHeight={graph.displayedNodeCount > 30 ? '820px' : '620px'}
    caption={`${stats.resources} resources owned by ${contextDisplayLabel}, ${graph.foreignResources.length} from other semantic homes, and ${graph.standardIris.length} referenced standard ${graph.standardIris.length === 1 ? 'term' : 'terms'}. Click any candidate resource node to open its detailed reference page.`}
  />

  <h2 id="resources">Owned resources</h2>
  {['class', 'object-property', 'datatype-property'].map((kind) => {
    const selected = ownedResources.filter((resource) => resource.kind === kind);
    if (!selected.length) return null;
    return (
      <section>
        <h3>{kindLabels[kind]}s ({selected.length})</h3>
        <div class="v2-table-wrap">
          <table>
            <thead><tr><th>Label</th><th>Definition</th><th>Domain</th><th>Range</th><th>Evidence traces</th></tr></thead>
            <tbody>
              {selected.map((resource) => (
                <tr>
                  <td><a href={resourceRoute(resource)}><strong>{resource.label}</strong></a><br/><code>{resource.key}</code></td>
                  <td>{resource.definition}</td>
                  <td>{resource.domain ? (resourceByIri.get(resource.domain)?.label ?? compactIri(resource.domain)) : <span class="v2-domain-missing">Not specified</span>}</td>
                  <td>{resource.range ? (resourceByIri.get(resource.range)?.label ?? compactIri(resource.range)) : '—'}</td>
                  <td>{resource.source_item_ids.length}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    );
  })}

  <h2 id="relationships">Structured relationship view</h2>
  <p>This text table covers the same one-hop relationships as the context diagram, including properties that enter or leave this semantic home. Domainless properties are reported as unresolved; no domain is guessed.</p>
  <div class="v2-table-wrap">
    <table>
      <thead><tr><th>Source / domain</th><th>Relationship</th><th>Target / range</th><th>Kind</th><th>Semantic home</th></tr></thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{row.edgeKind === 'subclass' ? <a href={resourceRoute(row.source)}>{row.source.label}</a> : row.source ? <a href={resourceRoute(row.source)}>{row.source.label}</a> : <span class="v2-domain-missing">Domain not specified</span>}</td>
            <td>{row.edgeKind === 'subclass' ? 'subclass of' : <a href={resourceRoute(row.relationship)}>{row.relationship.label}</a>}</td>
            <td>{row.target ? <a href={resourceRoute(row.target)}>{targetLabel(row)}</a> : <code>{targetLabel(row)}</code>}</td>
            <td>{row.edgeKind === 'subclass' ? 'Class hierarchy' : kindLabels[row.edgeKind]}</td>
            <td>{semanticHomeLabel(row)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="constraints">SHACL constraints</h2>
  {ownedShapes.length ? (
    <div class="v2-card-grid">
      {ownedShapes.map((shape) => (
        <a class="v2-card" href={shapeRoute(shape)}>
          <span class="pill pill--info">Node shape</span>
          <h3>{shape.target_label}</h3>
          <p>{shape.properties.length} property constraint{shape.properties.length === 1 ? '' : 's'}.</p>
          <p class="v2-card__meta"><code>{compactIri(shape.target_class)}</code></p>
        </a>
      ))}
    </div>
  ) : <p>No node shapes are emitted for this context.</p>}

  <h2 id="vocabularies">Controlled vocabularies</h2>
  {ownedSchemes.length ? (
    <div class="v2-card-grid">
      {ownedSchemes.map((scheme) => (
        <a class="v2-card" href={vocabularyRoute(scheme)}>
          <span class="pill pill--info">SKOS scheme</span>
          <h3>{scheme.label}</h3>
          <p>{scheme.definition}</p>
          <p class="v2-card__meta">{scheme.concepts.length} curated concepts</p>
        </a>
      ))}
    </div>
  ) : <p>No curated value-vocabulary scheme is owned here. Source-topic concepts may still classify consolidated questions.</p>}

  <h2 id="artefacts">Generated artefacts</h2>
  <div class="v2-note-grid">
    {Object.entries(files).map(([family, paths]) => (
      <section>
        <h3>{family[0].toUpperCase() + family.slice(1)}</h3>
        {paths.length ? <ul>{paths.map((file) => <li><a href={`/resource?path=source/03-standards/ontology-candidates/property-pack/0.1/${file}`}><code>{file}</code></a></li>)}</ul> : <p>No generated files.</p>}
      </section>
    ))}
  </div>
  <p><a href={contextRoute(context)}>Permanent link to this semantic home</a>.</p>
</PropertyPackPage>
