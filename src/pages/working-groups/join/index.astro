---
import PublicWorkingGroupLayout from '@/layouts/PublicWorkingGroupLayout.astro';
import '@/styles/working-group-join.css';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const privacyNoticeVersion = '2026-08-12';

const contexts = [
  ['conveyancing', 'Conveyancing', 'The legal transfer of property, including title, searches, enquiries and completion.'],
  ['estate-agency', 'Estate Agency', 'Marketing, listing, negotiation and the progression of a sale.'],
  ['surveying-and-valuation', 'Surveying and Valuation', 'Property condition, measurement, inspection, valuation and professional opinion.'],
  ['property-data-services', 'Property Data Services', 'The sourcing, assurance, exchange and interpretation of property information.'],
  ['property-technology', 'Property Technology', 'Products, platforms and integrations that support the property journey.'],
] as const;

const contributions = [
  ['share-source-material', 'Share authorised source material', 'Existing glossaries, schemas, forms, guidance or other evidence that your organisation is entitled to share.'],
  ['explain-domain-language-and-rules', 'Explain domain language and rules', 'Help us understand what terms mean in practice and where context changes their meaning.'],
  ['review-model-candidates', 'Review model candidates', 'Challenge definitions, relationships and assumptions in clear, human-readable drafts.'],
  ['test-schemas-and-integrations', 'Test schemas and integrations', 'Try familiar generated outputs and tell us whether they work in real implementations.'],
  ['contribute-consumer-accessibility-regulatory-public-interest-experience', 'Contribute consumer, accessibility, regulatory or public-interest experience', 'Help identify exclusions, harms, obligations and needs that a technical model might otherwise miss.'],
] as const;
---

<PublicWorkingGroupLayout
  title="Join a working group"
  description="Register your interest in helping OPDA shape the Smart Property Data Trust Framework."
  current="join"
>
  <div class="wg-page">
    <section class="wg-hero" aria-labelledby="join-title">
      <div>
        <p class="wg-eyebrow">Working-group recruitment</p>
        <h1 id="join-title">Help property data work across the whole journey</h1>
        <p class="wg-lead">
          OPDA is creating the Smart Property Data Trust Framework as a governed family of
          connected domain models. We need the people who know each part of the property journey
          to help shape the language, rules and practical outputs.
        </p>
      </div>
      <p class="wg-assurance">
        <strong>Your domain knowledge is what matters.</strong>
        <span>You are not being asked to understand ontologies, adopt AI, or have technical knowledge.</span>
      </p>
    </section>

    <section class="wg-section" aria-labelledby="contexts-title">
      <div class="wg-section__heading">
        <h2 id="contexts-title">Five perspectives, connected</h2>
        <p>
          Each group develops meaning within its own bounded context. An interoperability group
          will align shared boundaries and mappings without forcing every domain to use one definition.
        </p>
      </div>
      <ul class="wg-contexts">
        {contexts.map(([, label, description]) => (
          <li><strong>{label}</strong><span>{description}</span></li>
        ))}
      </ul>
    </section>

    <section class="wg-section" aria-labelledby="process-title">
      <div class="wg-section__heading">
        <h2 id="process-title">What happens after you register</h2>
        <p>
          Registration is an expression of interest. It does not automatically create membership,
          access, voting rights or authority to represent your employer.
        </p>
      </div>
      <ol class="wg-process">
        <li><strong>Register interest</strong><span>Tell us where your experience is most relevant.</span></li>
        <li><strong>Verify your email</strong><span>Use the one-time link we send to the address you provide.</span></li>
        <li><strong>OPDA reviews it</strong><span>A person reviews every verified registration.</span></li>
        <li><strong>Onboarding follows</strong><span>If accepted, we send working-group access separately.</span></li>
      </ol>
    </section>

    <section class="wg-section wg-form-shell" aria-labelledby="register-title">
      <div class="wg-form-intro">
        <p class="wg-eyebrow">Register your interest</p>
        <h2 id="register-title">Where can you help?</h2>
        <p>
          Choose one or more groups and the kinds of contribution you could make. The form usually
          takes two or three minutes.
        </p>
        <div class="callout callout--note">
          <div class="callout__label">How we use these details</div>
          <p>
            We use them only to verify, review and administer your working-group interest. This is
            not newsletter or marketing consent. Read the
            <a href="/working-groups/join/privacy">working-group privacy notice</a>.
          </p>
        </div>
      </div>

      <form
        id="working-group-interest-form"
        class="wg-form"
        novalidate
        data-turnstile-enabled={turnstileSiteKey ? 'true' : 'false'}
        data-privacy-notice-version={privacyNoticeVersion}
      >
        <div id="form-errors" class="wg-error-summary" role="alert" tabindex="-1" hidden>
          <h2>Check the information you entered</h2>
          <ul></ul>
        </div>

        <fieldset class="wg-form-section">
          <legend>About you</legend>
          <p>Fields marked <span class="wg-required">*</span> are required.</p>
          <div class="wg-fields">
            <div class="wg-field">
              <label for="full-name">Full name <span class="wg-required">*</span></label>
              <input id="full-name" name="fullName" type="text" autocomplete="name" minlength="2" maxlength="100" required />
              <p id="full-name-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="email">Email address <span class="wg-required">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="254" inputmode="email" required />
              <p id="email-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="organisation">Organisation <span class="wg-required">*</span></label>
              <input id="organisation" name="organisation" type="text" autocomplete="organization" minlength="2" maxlength="150" required />
              <p id="organisation-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="role">Role or area of expertise <span class="wg-required">*</span></label>
              <input id="role" name="role" type="text" autocomplete="organization-title" minlength="2" maxlength="120" required />
              <p id="role-error" class="wg-field-error"></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="wg-form-section" data-group="workingGroups">
          <legend>Which working groups interest you?</legend>
          <p>Select one or more, or choose “Not sure”. <span class="wg-required">*</span></p>
          <div class="wg-choice-grid">
            {contexts.map(([value, label, description]) => (
              <label class="wg-choice">
                <input type="checkbox" name="workingGroups" value={value} />
                <span><strong>{label}</strong><span>{description}</span></span>
              </label>
            ))}
            <label class="wg-choice wg-choice--wide">
              <input type="checkbox" name="workingGroups" value="not-sure" data-exclusive />
              <span><strong>Not sure — help me choose</strong><span>OPDA can suggest the best fit when reviewing your registration.</span></span>
            </label>
          </div>
          <p id="working-groups-error" class="wg-field-error"></p>
        </fieldset>

        <fieldset class="wg-form-section" data-group="contributions">
          <legend>How might you contribute?</legend>
          <p>Select one or more. <span class="wg-required">*</span></p>
          <div class="wg-choice-grid">
            {contributions.map(([value, label, description]) => (
              <label class="wg-choice">
                <input type="checkbox" name="contributions" value={value} />
                <span><strong>{label}</strong><span>{description}</span></span>
              </label>
            ))}
          </div>
          <p id="contributions-error" class="wg-field-error"></p>
        </fieldset>

        <section class="wg-form-section" aria-labelledby="perspective-title">
          <h2 id="perspective-title">Anything useful to know?</h2>
          <p>
            This is optional. Briefly describe relevant experience or perspective. Do not include
            confidential, personal, customer, property-transaction or special-category information.
          </p>
          <div class="wg-field">
            <label for="relevant-perspective">Relevant experience or perspective</label>
            <textarea id="relevant-perspective" name="relevantPerspective" maxlength="600" aria-describedby="perspective-hint perspective-count"></textarea>
            <span id="perspective-hint" class="wg-field-hint">Up to 600 characters. Do not paste evidence or links here.</span>
            <span id="perspective-count" class="wg-character-count" aria-live="polite">0 of 600 characters</span>
            <p id="relevant-perspective-error" class="wg-field-error"></p>
          </div>
        </section>

        <div class="wg-honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input id="started-at" name="startedAt" type="hidden" />
        <input name="privacyNoticeVersion" type="hidden" value={privacyNoticeVersion} />

        <label class="wg-acknowledgement">
          <input id="acknowledgement" name="acknowledgement" type="checkbox" value="true" required />
          <span>
            I understand this is an expression of interest, not automatic membership or access,
            and OPDA may contact me about the working groups I selected. <span class="wg-required">*</span>
          </span>
        </label>
        <p id="acknowledgement-error" class="wg-field-error"></p>

        {turnstileSiteKey ? (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-action="working-group-interest"
            data-theme="auto"
          ></div>
        ) : (
          <p class="callout callout--warn" data-turnstile-unavailable>
            Verification is not configured in this environment. The form cannot be submitted.
          </p>
        )}

        <div class="wg-form-actions">
          <button class="btn" type="submit" disabled={!turnstileSiteKey}>Register my interest</button>
          <a class="btn btn--ghost" href="/working-groups/join/privacy">Read the privacy notice</a>
        </div>
        <p id="form-status" class="wg-form-status" aria-live="polite"></p>
      </form>

      <section id="registration-success" class="wg-success" tabindex="-1" hidden>
        <p class="wg-eyebrow">One more step</p>
        <h2>Check your email</h2>
        <p>
          If your registration can be progressed, we will send a verification message to the
          address you supplied. Open it and confirm your address so that OPDA can review your
          registration.
        </p>
        <p>
          The message may take a few minutes. Check your junk folder if it does not appear. The
          link is personal to your registration and should not be forwarded.
        </p>
      </section>
    </section>
  </div>

  {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    import '@/scripts/working-group-join';
  </script>
</PublicWorkingGroupLayout>
