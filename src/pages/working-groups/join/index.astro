---
import Layout from '@/layouts/Layout.astro';
import '@/styles/working-group-join.css';

const privacyNoticeVersion = '2026-08-13';
const title = 'Join a working group';
const description = 'Help shape the Smart Property Data Trust Framework so property information keeps its meaning across the whole journey.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL('/images/working-group-recruitment-social.png', Astro.site ?? Astro.url.origin);

const contexts = [
  ['finance-and-banking', 'Finance and Banking', 'Mortgage advice, lending decisions, security, affordability and the systems that support them.'],
  ['conveyancing', 'Conveyancing', 'The legal transfer of property, including title, searches, enquiries and completion.'],
  ['estate-agency', 'Estate Agency', 'Marketing, listing, negotiation and the progression of a sale.'],
  ['surveying-and-valuation', 'Surveying and Valuation', 'Property condition, measurement, inspection, valuation and professional opinion.'],
  ['property-data-services', 'Property Data Services', 'The sourcing, assurance, exchange and interpretation of property information.'],
  ['property-technology', 'Property Technology', 'Products, platforms and integrations that support the property journey.'],
] as const;

const contributions = [
  ['share-source-material', 'Share authorised source material', 'Existing glossaries, schemas, forms, guidance or other evidence that your organisation is entitled to share.'],
  ['explain-domain-language-and-rules', 'Explain domain language and rules', 'Help us understand what terms mean in practice and where context changes their meaning.'],
  ['review-model-candidates', 'Review model candidates', 'Challenge definitions, relationships and assumptions in clear, human-readable drafts.'],
  ['test-schemas-and-integrations', 'Test schemas and integrations', 'Try familiar generated outputs and tell us whether they work in real implementations.'],
  ['contribute-consumer-accessibility-regulatory-public-interest-experience', 'Contribute consumer, accessibility, regulatory or public-interest experience', 'Help identify exclusions, harms, obligations and needs that a technical model might otherwise miss.'],
] as const;
---

<Layout
  title={title}
  description={description}
  hideSidebar={true}
  hideBreadcrumbs={true}
  hideFooter={true}
  hideComments={true}
  wrapArticle={false}
  mainClass="working-group-main"
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · OPDA Knowledge Base`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · OPDA Knowledge Base`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </Fragment>
  <div class="wg-page">
    <section class="wg-hero" aria-labelledby="join-title">
      <p class="wg-eyebrow">OPDA working groups · Smart Property Data Trust Framework</p>
      <h1 id="join-title">Help property data keep its meaning.</h1>
      <p class="wg-lead">
        A home is a listing, a lending decision, a legal title, a valuation and a data record—often
        all at once. OPDA working groups are agreeing the shared language that lets meaning travel
        across those handoffs. Bring your domain expertise; no technical or AI knowledge is needed.
      </p>
      <div class="wg-hero-actions">
        <a class="btn wg-btn--large" href="#register">Register your interest <span aria-hidden="true">↓</span></a>
        <a class="wg-text-link" href="#how-it-works">See how the work happens</a>
      </div>
    </section>

    <section id="how-it-works" class="wg-section" aria-labelledby="contexts-title">
      <div class="wg-section__heading">
        <div>
          <p class="wg-eyebrow">The work</p>
          <h2 id="contexts-title">Six domains. One connected journey.</h2>
        </div>
        <p>
          Each group develops precise meaning for its own domain. The Interoperability Working
          Group aligns a small shared boundary and mappings between them—without forcing one
          definition to fit every situation.
        </p>
      </div>
      <ul class="wg-contexts">
        {contexts.map(([, label, contextDescription], index) => (
          <li>
            <span class="wg-contexts__number">0{index + 1}</span>
            <strong>{label}</strong><span>{contextDescription}</span>
          </li>
        ))}
      </ul>
      <div class="wg-method-note">
        <h3>How candidates are made</h3>
        <div class="wg-method-note__copy">
          <p>
            You supply evidence—glossaries, schemas, forms, guidance and lived experience.
            AI-assisted modelling drafts candidate definitions; the group challenges, corrects and
            approves them. People decide: nothing becomes part of the scheme through AI alone.
          </p>
          <p>
            Approved meaning can then be published as business glossaries, data dictionaries,
            taxonomies, JSON Schemas, validation rules and integration mappings.
          </p>
        </div>
      </div>
    </section>

    <section class="wg-section wg-participation" aria-labelledby="process-title">
      <div class="wg-section__heading">
        <div>
          <p class="wg-eyebrow">Your next step</p>
          <h2 id="process-title">From interest to participation</h2>
        </div>
        <p>
          Registration is an expression of interest. It does not automatically create membership,
          access, voting rights or authority to represent your employer.
        </p>
      </div>
      <ol class="wg-process">
        <li><strong>Register interest</strong><span>Tell us where your experience is most relevant.</span></li>
        <li><strong>OPDA reviews it</strong><span>A person reviews every expression of interest.</span></li>
        <li><strong>Onboarding follows</strong><span>If accepted, we send working-group access separately.</span></li>
      </ol>
      <ul class="wg-governance-list">
        <li>Registration does not create membership, access, voting rights or authority to represent your employer.</li>
        <li>A person reviews every expression of interest; onboarding and working-group access are sent separately.</li>
        <li>Share only material that you and your organisation are authorised to share.</li>
      </ul>
    </section>

    <section id="register" class="wg-section wg-form-shell" aria-labelledby="register-title">
      <div class="wg-form-intro">
        <p class="wg-eyebrow">Register your interest</p>
        <h2 id="register-title">Where can you help?</h2>
        <p>
          Choose one or more groups and the kinds of contribution you could make. The form usually
          takes two or three minutes.
        </p>
        <div class="callout callout--note">
          <div class="callout__label">How we use these details</div>
          <p>
            We use them only to review and administer your working-group interest. This is
            not newsletter or marketing consent. Read the
            <a href="/working-groups/join/privacy">working-group privacy notice</a>.
          </p>
        </div>
        <noscript>
          <div class="callout callout--warning">
            <div class="callout__label">JavaScript is needed to send this form</div>
            <p>
              You can still register by emailing
              <a href="mailto:smartdata@openpropdata.org.uk">smartdata@openpropdata.org.uk</a>.
              Do not send confidential, personal, customer or property-transaction information.
            </p>
          </div>
        </noscript>
      </div>

      <form
        id="working-group-interest-form"
        class="wg-form"
        novalidate
        data-privacy-notice-version={privacyNoticeVersion}
      >
        <div id="form-errors" class="wg-error-summary" role="alert" tabindex="-1" hidden>
          <h2>Check the information you entered</h2>
          <ul></ul>
        </div>

        <fieldset class="wg-form-section">
          <legend>About you</legend>
          <p>Fields marked <span class="wg-required">*</span> are required.</p>
          <div class="wg-fields">
            <div class="wg-field">
              <label for="full-name">Full name <span class="wg-required">*</span></label>
              <input id="full-name" name="fullName" type="text" autocomplete="name" minlength="2" maxlength="100" aria-describedby="full-name-error" required />
              <p id="full-name-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="email">Email address <span class="wg-required">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="254" inputmode="email" aria-describedby="email-error" required />
              <p id="email-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="organisation">Organisation <span class="wg-required">*</span></label>
              <input id="organisation" name="organisation" type="text" autocomplete="organization" minlength="2" maxlength="150" aria-describedby="organisation-error" required />
              <p id="organisation-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="role">Role or area of expertise <span class="wg-required">*</span></label>
              <input id="role" name="role" type="text" autocomplete="organization-title" minlength="2" maxlength="120" aria-describedby="role-error" required />
              <p id="role-error" class="wg-field-error"></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="wg-form-section" data-group="workingGroups" aria-describedby="working-groups-error">
          <legend>Which working groups interest you?</legend>
          <p>Select one or more, or choose “Not sure”. <span class="wg-required">*</span></p>
          <div class="wg-choice-grid">
            {contexts.map(([value, label, description]) => (
              <label class="wg-choice">
                <input type="checkbox" name="workingGroups" value={value} />
                <span><strong>{label}</strong><span>{description}</span></span>
              </label>
            ))}
            <label class="wg-choice wg-choice--wide">
              <input type="checkbox" name="workingGroups" value="not-sure" data-exclusive />
              <span><strong>Not sure — help me choose</strong><span>OPDA can suggest the best fit when reviewing your registration.</span></span>
            </label>
          </div>
          <p id="working-groups-error" class="wg-field-error"></p>
        </fieldset>

        <fieldset class="wg-form-section" data-group="contributions" aria-describedby="contributions-error">
          <legend>How might you contribute?</legend>
          <p>Select one or more. <span class="wg-required">*</span></p>
          <div class="wg-choice-grid">
            {contributions.map(([value, label, description]) => (
              <label class="wg-choice">
                <input type="checkbox" name="contributions" value={value} />
                <span><strong>{label}</strong><span>{description}</span></span>
              </label>
            ))}
          </div>
          <p id="contributions-error" class="wg-field-error"></p>
        </fieldset>

        <section class="wg-form-section" aria-labelledby="perspective-title">
          <h2 id="perspective-title">Anything useful to know?</h2>
          <p>
            This is optional. Briefly describe relevant experience or perspective. Do not include
            confidential, personal, customer, property-transaction or special-category information.
          </p>
          <div class="wg-field">
            <label for="relevant-perspective">Relevant experience or perspective</label>
            <textarea id="relevant-perspective" name="relevantPerspective" maxlength="600" aria-describedby="perspective-hint perspective-count relevant-perspective-error"></textarea>
            <span id="perspective-hint" class="wg-field-hint">Up to 600 characters. Do not paste evidence or links here.</span>
            <span id="perspective-count" class="wg-character-count" aria-live="polite">0 of 600 characters</span>
            <p id="relevant-perspective-error" class="wg-field-error"></p>
          </div>
        </section>

        <div class="wg-honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input id="started-at" name="startedAt" type="hidden" />
        <input name="privacyNoticeVersion" type="hidden" value={privacyNoticeVersion} />

        <label class="wg-acknowledgement">
          <input id="acknowledgement" name="acknowledgement" type="checkbox" value="true" aria-describedby="acknowledgement-error" required />
          <span>
            I understand this is an expression of interest, not automatic membership or access,
            and OPDA may contact me about the working groups I selected. <span class="wg-required">*</span>
          </span>
        </label>
        <p id="acknowledgement-error" class="wg-field-error"></p>

        <div class="wg-form-actions">
          <button class="btn" type="submit">Register my interest</button>
          <a class="btn btn--ghost" href="/working-groups/join/privacy">Read the privacy notice</a>
        </div>
        <p id="form-status" class="wg-form-status" aria-live="polite"></p>
      </form>

      <section id="registration-success" class="wg-success" tabindex="-1" hidden>
        <p class="wg-eyebrow">Registration received</p>
        <h2>Thank you for registering</h2>
        <p>
          OPDA will review your expression of interest. If we can progress it, we will contact you
          about the relevant working group and send onboarding information separately.
        </p>
      </section>
    </section>
  </div>
  <script>
    import '@/scripts/working-group-join';
  </script>
</Layout>
