---
import Layout from '@/layouts/Layout.astro';
import '@/styles/working-group-join.css';
import '@/styles/working-group-campaign.css';
import '@/styles/working-group-campaign-responsive.css';
import '@/styles/working-group-campaign-sections.css';

const privacyNoticeVersion = '2026-08-13';
const title = 'Join a working group';
const description = 'Help shape the Smart Property Data Trust Framework so property information keeps its meaning across the whole journey.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL('/images/working-group-recruitment-social.png', Astro.site ?? Astro.url.origin);

const contexts = [
  [
    'finance-and-banking',
    'Finance and Banking',
    'Mortgage advice, lending decisions, security, affordability and the systems that support them.',
    'Mortgage security',
    'An asset assessed for lending, affordability and risk.',
    'Property becomes security for lending',
    'Value, affordability, eligibility and risk determine how the property supports a mortgage.',
  ],
  [
    'conveyancing',
    'Conveyancing',
    'The legal transfer of property, including title, searches, enquiries and completion.',
    'Legal title',
    'Rights, restrictions and the asset being transferred.',
    'Property becomes a legal interest',
    'Title, parties, searches, enquiries and completion need their own precise meaning.',
  ],
  [
    'estate-agency',
    'Estate Agency',
    'Marketing, listing, negotiation and the progression of a sale.',
    'Listing',
    'A place to market, price and negotiate.',
    '“Property” means something marketable',
    'Descriptions, asking price, tenure and readiness for sale shape the view.',
  ],
  [
    'surveying-and-valuation',
    'Surveying and Valuation',
    'Property condition, measurement, inspection, valuation and professional opinion.',
    'Subject asset',
    'Condition, measurement and professional opinion.',
    'Property becomes an object of inspection and value',
    'The facts that matter shift again when condition, risk and valuation enter the journey.',
  ],
  [
    'property-data-services',
    'Property Data Services',
    'The sourcing, assurance, exchange and interpretation of property information.',
    'Evidence',
    'Sourced information with provenance and assurance.',
    'Property becomes a body of sourced evidence',
    'Coverage, provenance, quality and permissions determine whether information can be trusted.',
  ],
  [
    'property-technology',
    'Property Technology',
    'Products, platforms and integrations that support the property journey.',
    'Resource',
    'Structured meaning ready for products and integrations.',
    'Property becomes something systems must exchange',
    'Products need stable identifiers, schemas, validation and mappings to make the journey work.',
  ],
] as const;

const contributions = [
  ['share-source-material', 'Share authorised source material', 'Existing glossaries, schemas, forms, guidance or other evidence that your organisation is entitled to share.'],
  ['explain-domain-language-and-rules', 'Explain domain language and rules', 'Help us understand what terms mean in practice and where context changes their meaning.'],
  ['review-model-candidates', 'Review model candidates', 'Challenge definitions, relationships and assumptions in clear, human-readable drafts.'],
  ['test-schemas-and-integrations', 'Test schemas and integrations', 'Try familiar generated outputs and tell us whether they work in real implementations.'],
  ['contribute-consumer-accessibility-regulatory-public-interest-experience', 'Contribute consumer, accessibility, regulatory or public-interest experience', 'Help identify exclusions, harms, obligations and needs that a technical model might otherwise miss.'],
] as const;
---

<Layout
  title={title}
  description={description}
  hideSidebar={true}
  hideComments={true}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · OPDA Knowledge Base`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · OPDA Knowledge Base`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </Fragment>
  <div class="wg-page">
    <section class="wg-campaign-hero" aria-labelledby="join-title">
      <div class="wg-campaign-hero__copy">
        <p class="wg-eyebrow">Smart Property Data Trust Framework</p>
        <h1 id="join-title">One property.<br /><em>Many meanings.</em><br />One connected journey.</h1>
        <p class="wg-lead">
          Property information crosses legal, commercial, professional and technical boundaries.
          OPDA is bringing the people who understand those boundaries together to make the meaning
          travel with the data.
        </p>
        <div class="wg-hero-actions">
          <a class="btn wg-btn--large" href="#register">Register your interest <span aria-hidden="true">↓</span></a>
          <a class="wg-text-link" href="#how-it-works">See how the work happens</a>
        </div>
      </div>

      <aside class="wg-hero-summary" aria-label="How participation works">
        <p>Meaning travels across every handoff.</p>
        <ul>
          <li><strong>Domain expertise in.</strong> Connected models, schemas and usable outputs out.</li>
          <li>Human review at every iteration</li>
          <li>No technical knowledge required</li>
        </ul>
      </aside>
    </section>

    <section class="wg-section" aria-labelledby="process-title">
      <div class="wg-section__heading">
        <div>
          <p class="wg-eyebrow">Your next step</p>
          <h2 id="process-title">From interest to participation</h2>
        </div>
        <p>
          Registration is an expression of interest. It does not automatically create membership,
          access, voting rights or authority to represent your employer.
        </p>
      </div>
      <ol class="wg-process">
        <li><strong>Register interest</strong><span>Tell us where your experience is most relevant.</span></li>
        <li><strong>OPDA reviews it</strong><span>A person reviews every expression of interest.</span></li>
        <li><strong>Onboarding follows</strong><span>If accepted, we send working-group access separately.</span></li>
      </ol>
    </section>

    <section id="register" class="wg-section wg-form-shell" aria-labelledby="register-title">
      <div class="wg-form-intro">
        <p class="wg-eyebrow">Register your interest</p>
        <h2 id="register-title">Where can you help?</h2>
        <p>
          Choose one or more groups and the kinds of contribution you could make. The form usually
          takes two or three minutes.
        </p>
        <div class="callout callout--note">
          <div class="callout__label">How we use these details</div>
          <p>
            We use them only to review and administer your working-group interest. This is
            not newsletter or marketing consent. Read the
            <a href="/working-groups/join/privacy">working-group privacy notice</a>.
          </p>
        </div>
      </div>

      <p id="form-availability" class="wg-form-availability">
        Preparing secure online registration. If the form remains unavailable, email
        <a href="mailto:smartdata@openpropdata.org.uk">smartdata@openpropdata.org.uk</a>.
      </p>
      <noscript>
        <style>.wg-form { display: none !important; } .wg-form-availability { display: none !important; }</style>
        <div class="callout callout--note wg-noscript">
          <div class="callout__label">Register without JavaScript</div>
          <p>
            This form needs JavaScript to submit securely. You can instead email
            <a href="mailto:smartdata@openpropdata.org.uk">smartdata@openpropdata.org.uk</a> to
            register your interest. Do not include confidential, customer, property-transaction
            or special-category information.
          </p>
        </div>
      </noscript>

      <form
        id="working-group-interest-form"
        class="wg-form"
        method="post"
        action="/api/working-group-interest"
        novalidate
        data-privacy-notice-version={privacyNoticeVersion}
      >
        <div id="form-errors" class="wg-error-summary" role="alert" tabindex="-1" hidden>
          <h2>Check the information you entered</h2>
          <ul></ul>
        </div>

        <fieldset class="wg-form-section">
          <legend>About you</legend>
          <p>Fields marked <span class="wg-required">*</span> are required.</p>
          <div class="wg-fields">
            <div class="wg-field">
              <label for="full-name">Full name <span class="wg-required">*</span></label>
              <input id="full-name" name="fullName" type="text" autocomplete="name" minlength="2" maxlength="100" aria-describedby="full-name-error" required />
              <p id="full-name-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="email">Email address <span class="wg-required">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="254" inputmode="email" aria-describedby="email-error" required />
              <p id="email-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="organisation">Organisation <span class="wg-required">*</span></label>
              <input id="organisation" name="organisation" type="text" autocomplete="organization" minlength="2" maxlength="150" aria-describedby="organisation-error" required />
              <p id="organisation-error" class="wg-field-error"></p>
            </div>
            <div class="wg-field">
              <label for="role">Role or area of expertise <span class="wg-required">*</span></label>
              <input id="role" name="role" type="text" autocomplete="organization-title" minlength="2" maxlength="120" aria-describedby="role-error" required />
              <p id="role-error" class="wg-field-error"></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="wg-form-section" data-group="workingGroups" aria-describedby="working-groups-hint working-groups-error">
          <legend>Which working groups interest you?</legend>
          <p id="working-groups-hint">Select one or more, or choose “Not sure”. <span class="wg-required">*</span></p>
          <div class="wg-choice-grid">
            {contexts.map(([value, label, description]) => (
              <label class="wg-choice">
                <input id={`working-group-${value}`} type="checkbox" name="workingGroups" value={value} />
                <span><strong>{label}</strong><span>{description}</span></span>
              </label>
            ))}
            <label class="wg-choice wg-choice--wide">
              <input id="working-group-not-sure" type="checkbox" name="workingGroups" value="not-sure" data-exclusive />
              <span><strong>Not sure — help me choose</strong><span>OPDA can suggest the best fit when reviewing your registration.</span></span>
            </label>
          </div>
          <p id="working-groups-error" class="wg-field-error"></p>
        </fieldset>

        <fieldset class="wg-form-section" data-group="contributions" aria-describedby="contributions-hint contributions-error">
          <legend>How might you contribute?</legend>
          <p id="contributions-hint">Select one or more. <span class="wg-required">*</span></p>
          <div class="wg-choice-grid">
            {contributions.map(([value, label, description]) => (
              <label class="wg-choice">
                <input id={`contribution-${value}`} type="checkbox" name="contributions" value={value} />
                <span><strong>{label}</strong><span>{description}</span></span>
              </label>
            ))}
          </div>
          <p id="contributions-error" class="wg-field-error"></p>
        </fieldset>

        <section class="wg-form-section" aria-labelledby="perspective-title">
          <h2 id="perspective-title">Anything useful to know?</h2>
          <p>
            This is optional. Briefly describe relevant experience or perspective. Do not include
            confidential, personal, customer, property-transaction or special-category information.
          </p>
          <div class="wg-field">
            <label for="relevant-perspective">Relevant experience or perspective</label>
            <textarea id="relevant-perspective" name="relevantPerspective" maxlength="600" aria-describedby="perspective-hint perspective-count relevant-perspective-error"></textarea>
            <span id="perspective-hint" class="wg-field-hint">Up to 600 characters. Do not paste evidence or links here.</span>
            <span id="perspective-count" class="wg-character-count" aria-live="polite">0 of 600 characters</span>
            <p id="relevant-perspective-error" class="wg-field-error"></p>
          </div>
        </section>

        <div class="wg-honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input id="started-at" name="startedAt" type="hidden" />
        <input name="privacyNoticeVersion" type="hidden" value={privacyNoticeVersion} />

        <label class="wg-acknowledgement">
          <input id="acknowledgement" name="acknowledgement" type="checkbox" value="true" aria-describedby="acknowledgement-error" required />
          <span>
            I understand this is an expression of interest, not automatic membership or access,
            and OPDA may contact me about the working groups I selected. <span class="wg-required">*</span>
          </span>
        </label>
        <p id="acknowledgement-error" class="wg-field-error"></p>

        <div class="wg-form-actions">
          <button class="btn" type="submit" disabled>Register my interest</button>
          <a class="btn btn--ghost" href="/working-groups/join/privacy">Read the privacy notice</a>
        </div>
        <p id="form-status" class="wg-form-status" aria-live="polite"></p>
      </form>

      <section id="registration-success" class="wg-success" tabindex="-1" hidden>
        <p class="wg-eyebrow">Registration received</p>
        <h2>Thank you for registering</h2>
        <p>
          OPDA will review your expression of interest. If we can progress it, we will contact you
          about the relevant working group and send onboarding information separately.
        </p>
      </section>
    </section>

    <section class="wg-section wg-context-section" aria-labelledby="handoffs-title">
      <div class="wg-section__heading">
        <div>
          <p class="wg-eyebrow">The problem is in the handoffs</p>
          <h2 id="handoffs-title">The same thing changes meaning as work moves on</h2>
        </div>
        <p>
          Each group develops precise meaning for its own domain. These are different views of the
          same property, not a single fixed sequence.
        </p>
      </div>
      <div class="wg-domain-baseline">
        <span>The property</span>
        <strong>Home</strong>
        <p>A place someone lives.</p>
      </div>
      <ol class="wg-domain-grid" data-reveal-group>
        {contexts.map(([, label, scope, term, definition, heading, explanation], index) => (
          <li data-reveal style={`--reveal-delay:${index * 60}ms`}>
            <article class="wg-domain-card">
              <p class="wg-domain-card__context">{String(index + 1).padStart(2, '0')} · {label}</p>
              <h3>{term}</h3>
              <p class="wg-domain-card__definition">{definition}</p>
              <h4>{heading}</h4>
              <p>{explanation}</p>
              <p class="wg-domain-card__scope"><strong>Group scope:</strong> {scope}</p>
            </article>
          </li>
        ))}
      </ol>
      <div class="wg-context-map__bridge">
        <span>Interoperability</span>
        <strong>Shared boundary · mappings · conventions</strong>
        <p>
          The Interoperability Working Group aligns a small common boundary and mappings between
          domains without forcing one definition to fit every situation.
        </p>
      </div>
    </section>

    <section id="how-it-works" class="wg-model-story" aria-labelledby="model-title">
      <div class="wg-model-story__intro">
        <p class="wg-eyebrow">A faster, evidence-led way to build</p>
        <h2 id="model-title">You bring the evidence.<br />We turn it into something everyone can use.</h2>
        <p>
          Source material, discussion and feedback feed an AI-assisted modelling process. AI speeds
          up synthesis; people remain responsible for meaning, challenge and approval.
        </p>
      </div>
      <ol class="wg-model-flow" data-reveal-group>
        <li data-reveal>
          <span class="wg-model-flow__icon" aria-hidden="true">≋</span>
          <strong>Evidence</strong>
          <p>Forms, schemas, glossaries, guidance, examples and lived expertise.</p>
        </li>
        <li data-reveal>
          <span class="wg-model-flow__icon" aria-hidden="true">✦</span>
          <strong>AI-assisted modelling</strong>
          <p>Specialist agents compare sources, surface ambiguity and propose a candidate.</p>
        </li>
        <li data-reveal>
          <span class="wg-model-flow__icon" aria-hidden="true">◎</span>
          <strong>Human review</strong>
          <p>Working groups challenge the meaning, supply evidence and resolve what is wrong.</p>
        </li>
        <li data-reveal>
          <span class="wg-model-flow__icon" aria-hidden="true">↻</span>
          <strong>Iterate</strong>
          <p>Feedback returns to the model until the group has a stable candidate.</p>
        </li>
      </ol>

      <div class="wg-output-ribbon" aria-labelledby="outputs-title">
        <p class="wg-eyebrow">One governed source of meaning</p>
        <h3 id="outputs-title">Familiar outputs for the tools people already use</h3>
        <ul>
          <li>Business glossary</li>
          <li>Data dictionary</li>
          <li>Taxonomies</li>
          <li>Controlled vocabularies</li>
          <li>JSON Schemas</li>
          <li>Validation</li>
          <li>Website and documents</li>
          <li>Integration mappings</li>
        </ul>
      </div>
    </section>

    <section class="wg-section wg-why" aria-labelledby="why-title">
      <div class="wg-why__statement">
        <p class="wg-eyebrow">Why your participation matters</p>
        <h2 id="why-title">A model cannot learn the exceptions nobody shares.</h2>
        <p>
          The standard will influence how property information is described, checked and exchanged.
          It needs the language of daily work—not just the assumptions visible in existing schemas.
        </p>
        <a class="btn wg-btn--large" href="#register">Bring your perspective <span aria-hidden="true">↑</span></a>
      </div>
      <ul class="wg-why__reasons" data-reveal-group>
        <li data-reveal><strong>Make meaning explicit</strong><span>Explain the terms, rules and edge cases only practitioners know.</span></li>
        <li data-reveal><strong>Expose gaps early</strong><span>Challenge what is missing, misleading or too narrow before it becomes a standard.</span></li>
        <li data-reveal><strong>Test practical outputs</strong><span>Check whether schemas, validation and mappings work with real systems and forms.</span></li>
        <li data-reveal><strong>Represent affected people</strong><span>Bring consumer, accessibility, regulatory and public-interest experience into review.</span></li>
      </ul>
    </section>

    <section class="wg-trust" aria-labelledby="trust-title">
      <div>
        <p class="wg-eyebrow">Clever technology. Clear human authority.</p>
        <h2 id="trust-title">You do not need to understand ontologies or adopt AI.</h2>
      </div>
      <div class="wg-trust__content">
        <p>
          Participate in the language of your work. Share what you are authorised to share, discuss
          candidates in plain English, and tell us what the model gets wrong.
        </p>
        <ul>
          <li><strong>AI proposes;</strong> people review.</li>
          <li><strong>Evidence shapes;</strong> source material is not automatically published.</li>
          <li><strong>Working groups iterate;</strong> registration is not a vote or automatic access.</li>
          <li><strong>People decide;</strong> no candidate becomes official through AI alone.</li>
        </ul>
      </div>
    </section>
  </div>
  <script>
    import '@/scripts/working-group-join';
    import '@/scripts/working-group-campaign';
  </script>
</Layout>
