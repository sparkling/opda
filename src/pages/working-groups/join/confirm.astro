---
import PublicWorkingGroupLayout from '@/layouts/PublicWorkingGroupLayout.astro';
import '@/styles/working-group-join.css';
---

<PublicWorkingGroupLayout
  title="Confirm your email"
  description="Confirm the email address used for your OPDA working-group expression of interest."
  current="confirm"
>
  <div class="wg-page">
    <section class="wg-section wg-confirm" aria-labelledby="confirm-title">
      <p class="wg-eyebrow">Email verification</p>
      <h1 id="confirm-title">Confirm your email address</h1>
      <p class="wg-lead">
        Select the button below to confirm the address used for your working-group expression of
        interest. Opening this page alone does not confirm anything.
      </p>

      <div class="wg-confirm-card">
        <div id="confirmation-ready">
          <h2>Ready to confirm</h2>
          <p>
            After confirmation, your registration enters OPDA's human review queue. Verification
            is not acceptance and does not automatically create Teams or SharePoint access.
          </p>
          <form id="confirmation-form">
            <button class="btn" type="submit">Confirm my email</button>
          </form>
        </div>

        <div id="confirmation-success" tabindex="-1" hidden>
          <h2>Email confirmed</h2>
          <p>
            Thank you. OPDA can now review your expression of interest. If your registration is
            accepted, working-group onboarding and access will be sent separately.
          </p>
          <a class="btn btn--ghost" href="/working-groups/join">Return to working-group recruitment</a>
        </div>

        <div id="confirmation-invalid" role="alert" tabindex="-1" hidden>
          <h2>This link cannot be used</h2>
          <p>
            The confirmation link may be incomplete, expired or already used. Register again or
            email <a href="mailto:smartdata@openpropdata.org.uk">smartdata@openpropdata.org.uk</a>
            if you need help.
          </p>
          <a class="btn btn--ghost" href="/working-groups/join">Register again</a>
        </div>

        <p id="confirmation-status" class="wg-form-status" aria-live="polite"></p>
      </div>
    </section>
  </div>

  <script>
    import '@/scripts/working-group-confirm';
  </script>
</PublicWorkingGroupLayout>
