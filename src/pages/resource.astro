---
import Layout from '@/layouts/Layout.astro';
// Council-session manifest (generated by generate-council.mjs). Emitted below as a
// JSON island so the client script can drive folder listings for council/* paths.
import councilManifest from '@/data/council-manifest.json';
---
<Layout
  title="Resource"
  description="Unified viewer for any file in the OPDA Knowledge Base. Accepts ?path=… and renders the resource inline within the site chrome."
>
<span id="res-breadcrumb" aria-hidden="true"></span>
      <h1 id="res-title">Loading…</h1>

      <dl class="res-meta">
        <dt>Path</dt>           <dd><code id="res-path">—</code></dd>
        <dt>Type</dt>           <dd id="res-type">—</dd>
        <dt>Rendered as</dt>    <dd id="res-rendered">—</dd>
      </dl>

      <div class="res-actions">
        <a id="res-open" href="#" target="_blank" rel="noopener">Open original ↗</a>
        <a id="res-download" href="#" download>Download</a>
      </div>

      <div id="res-body">
        <div class="muted">Loading…</div>
      </div>

<script type="application/json" id="council-manifest" set:html={JSON.stringify(councilManifest)}></script>

<script>
  import { marked } from 'marked';

  // Resource viewer — resolves ?path=… to a fetchable URL and renders it.
  //
  // Path resolution (ADR-0054): source/ is served two different ways.
  //   • DEV  — astro.config.mjs's serveProjectRoots Vite plugin exposes the
  //            archive at /source/… , so source/a/b.pdf → /source/a/b.pdf.
  //   • PROD — source/ is NOT in dist/. Its mirror lives in the public S3
  //            bucket, served by CloudFront under /resources/* with the leading
  //            "source/" stripped (the bucket mirrors source/ at its root). So
  //            source/a/b.pdf → /resources/a/b.pdf. This is why all the existing
  //            /resource?path=source/… links work in prod with no rewrite.
  // Non-source paths (e.g. docs/…) are served from the site root as-is in both.
  function resolveResourceUrl(p) {
    if (p.startsWith('source/')) {
      return import.meta.env.PROD
        ? '/resources/' + p.slice('source/'.length)  // prod: S3-mirror, strip prefix
        : '/' + p;                                    // dev: Vite plugin at /source/…
    }
    return '/' + p.replace(/^\/+/, '');               // other roots: served as-is
  }

  // Extension → render strategy. Covers every type present in the S3 archive
  // plus common siblings, so the viewer degrades gracefully for anything.
  const IMAGE  = new Set(['png','jpg','jpeg','webp','gif','avif','bmp','ico','svg']);
  const VIDEO  = new Set(['mp4','webm','mov','m4v','ogv']);
  const AUDIO  = new Set(['mp3','wav','ogg','oga','m4a','flac','aac']);
  const FRAME  = new Set(['pdf','html','htm']);                 // browser renders natively
  const OFFICE = new Set(['docx','xlsx','pptx','doc','xls','ppt']); // Office Online preview
  const TEXT   = new Set(['txt','md','markdown','mdx','ttl','rdf','n3','nt','nq','trig',
    'json','jsonld','geojson','xml','yaml','yml','toml','ini','env','cfg','conf','properties',
    'csv','tsv','js','mjs','cjs','jsx','ts','tsx','css','scss','less','sh','bash','zsh','py',
    'rb','sql','log','patch','diff','vtt','srt','gitignore','nvmrc','prettierrc','firebaserc',
    'editorconfig','iml','graphql','gql','map']);
  const TEXT_MAX = 2 * 1024 * 1024; // 2 MB cap for inline text fetch
  const MARKDOWN = new Set(['md', 'markdown', 'mdx']); // rendered via marked, not <pre>

  // Council-session manifest (JSON island emitted by resource.astro). A flat array
  // of { path, name, type:'file'|'dir', ext, size }; drives folder listings for
  // council/* directory paths (direct children = path-prefix + one extra segment).
  const COUNCIL_MANIFEST = (() => {
    try { return JSON.parse(document.getElementById('council-manifest')?.textContent || '[]'); }
    catch { return []; }
  })();
  const manifestByPath = new Map(COUNCIL_MANIFEST.map((e) => [e.path, e]));

  const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

  function fmtSize(n) {
    if (!Number.isFinite(n)) return '';
    if (n < 1024) return n + ' B';
    if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
    return (n / 1048576).toFixed(1) + ' MB';
  }

  function downloadCard(body, url, name, ext, reason) {
    body.innerHTML =
      '<div class="res-binary">' +
      '<p><strong>' + esc(name) + '</strong>' + (ext ? ' <code>.' + esc(ext) + '</code>' : '') + '</p>' +
      '<p class="muted">' + esc(reason || 'This file type can’t be previewed inline.') + '</p>' +
      '<p><a class="res-folder-up" href="' + url + '" download>Download</a> ' +
      '<a class="res-folder-up" href="' + url + '" target="_blank" rel="noopener">Open in new tab ↗</a></p>' +
      '</div>';
  }

  function csvTable(text, sep) {
    // Minimal CSV/TSV parse with quoted-field support.
    const rows = []; let row = [], field = '', q = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (q) {
        if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (c === '"') q = false;
        else field += c;
      } else if (c === '"') q = true;
      else if (c === sep) { row.push(field); field = ''; }
      else if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
      else if (c !== '\r') field += c;
    }
    if (field.length || row.length) { row.push(field); rows.push(row); }
    if (!rows.length) return '<div class="res-binary muted">Empty file.</div>';
    const head = rows[0], bodyRows = rows.slice(1);
    return '<div class="res-csv-wrap" role="region" aria-label="Data table" tabindex="0"><table><thead><tr>' +
      head.map((h) => '<th>' + esc(h) + '</th>').join('') + '</tr></thead><tbody>' +
      bodyRows.map((r) => '<tr>' + head.map((_, i) => '<td>' + esc(r[i] ?? '') + '</td>').join('') + '</tr>').join('') +
      '</tbody></table></div>';
  }

  // ── Folder support (council/* paths, via the manifest) ──────────────────────
  // A path is a directory when the manifest holds it as type 'dir', when any
  // manifest entry sits under it (path + '/' prefix), or when it ends with '/'.
  function isFolderPath(path) {
    const clean = path.replace(/\/+$/, '');
    if (path.endsWith('/')) return true;
    const self = manifestByPath.get(clean);
    if (self && self.type === 'dir') return true;
    const prefix = clean + '/';
    for (const e of COUNCIL_MANIFEST) if (e.path.startsWith(prefix)) return true;
    return false;
  }

  // Direct children of `dir`: manifest entries one segment deeper than `dir`.
  function directChildren(dir) {
    const clean = dir.replace(/\/+$/, '');
    const prefix = clean + '/';
    const depth = clean.split('/').length;
    const kids = [];
    for (const e of COUNCIL_MANIFEST) {
      if (!e.path.startsWith(prefix)) continue;
      if (e.path.split('/').length !== depth + 1) continue; // direct child only
      kids.push(e);
    }
    // Sub-folders first, then files; each alphabetical by name.
    kids.sort((a, b) => {
      if (a.type !== b.type) return a.type === 'dir' ? -1 : 1;
      return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;
    });
    return kids;
  }

  function crumbs(path) {
    const clean = path.replace(/\/+$/, '');
    const segs = clean.split('/');
    let acc = '';
    const parts = segs.map((seg, i) => {
      acc = acc ? acc + '/' + seg : seg;
      if (i === segs.length - 1) return '<span>' + esc(seg) + '</span>';
      return '<a href="/resource?path=' + encodeURIComponent(acc) + '">' + esc(seg) + '</a>';
    });
    return parts.join('<span class="sep">/</span>');
  }

  function renderFolder(body, path) {
    const clean = path.replace(/\/+$/, '');
    const segs = clean.split('/');
    const parentPath = segs.slice(0, -1).join('/');
    const kids = directChildren(clean);
    const up = segs.length > 1
      ? '<a class="res-folder-up" href="/resource?path=' + encodeURIComponent(parentPath) + '">↑ Up to ' + esc(segs[segs.length - 2]) + '</a>'
      : '';
    const rows = kids.length
      ? kids.map((e) => {
          const isDir = e.type === 'dir';
          const label = esc(e.name) + (isDir ? '/' : '');
          const kind = isDir ? 'folder' : (e.ext ? '.' + esc(e.ext) : 'file');
          const size = isDir ? '' : fmtSize(e.size);
          return '<tr><td><a href="/resource?path=' + encodeURIComponent(e.path) + '">' +
            (isDir ? '📁 ' : '📄 ') + label + '</a></td><td>' + kind + '</td><td>' + size + '</td></tr>';
        }).join('')
      : '<tr><td colspan="3" class="muted">Empty folder.</td></tr>';
    body.innerHTML =
      '<div class="res-folder-head">' +
      '<div class="res-folder-crumbs">' + crumbs(clean) + '</div>' + up +
      '</div>' +
      '<div class="res-folder-table-wrap" role="region" aria-label="Folder contents" tabindex="0"><table class="res-folder-table"><thead><tr>' +
      '<th>Name</th><th>Type</th><th>Size</th></tr></thead><tbody>' +
      rows + '</tbody></table></div>' +
      '<p class="muted tiny">' + kids.length + ' item' + (kids.length === 1 ? '' : 's') + '</p>';
  }

  async function renderMarkdown(body, url) {
    let res;
    try { res = await fetch(url); } catch { return false; }
    if (!res.ok) return false;
    const len = Number(res.headers.get('content-length'));
    if (Number.isFinite(len) && len > TEXT_MAX) return false;
    const text = await res.text();
    if (text.length > TEXT_MAX) return false;
    // Council docs are trusted internal content; render GFM to HTML.
    body.innerHTML = '<div class="res-prose-wrap">' + marked.parse(text, { gfm: true }) + '</div>';
    return true;
  }

  async function renderText(body, url, ext) {
    let res;
    try { res = await fetch(url); } catch { return false; }
    if (!res.ok) return false;
    const len = Number(res.headers.get('content-length'));
    if (Number.isFinite(len) && len > TEXT_MAX) return false; // too big → caller falls back to download
    const text = await res.text();
    if (text.length > TEXT_MAX) return false;
    if (ext === 'csv' || ext === 'tsv') { body.innerHTML = csvTable(text, ext === 'tsv' ? '\t' : ','); return true; }
    let out = text;
    if (ext === 'json' || ext === 'jsonld' || ext === 'geojson') {
      try { out = JSON.stringify(JSON.parse(text), null, 2); } catch { /* show raw */ }
    }
    body.innerHTML = '<div class="res-code-wrap"><pre><code>' + esc(out) + '</code></pre></div>';
    return true;
  }

  async function renderResource() {
    const $ = (id) => document.getElementById(id);
    const body = $('res-body');
    if (!body) return; // not the resource page

    const raw = new URLSearchParams(window.location.search).get('path') || '';
    const path = raw.replace(/^\/+/, '').replace(/\.\.(?:\/|$)/g, ''); // strip leading / and any ..
    const modeLabel = $('res-mode-label');

    if (!path) {
      if (modeLabel) modeLabel.textContent = 'no path';
      $('res-title').textContent = 'No resource selected';
      $('res-path').textContent = '—';
      body.innerHTML = '<div class="res-error">Add <code>?path=…</code> to the URL, '
        + 'e.g. <code>?path=source/INVENTORY.md</code>.</div>';
      return;
    }

    const url = resolveResourceUrl(path);
    const name = path.replace(/\/$/, '').split('/').pop() || path;
    const ext = (name.includes('.') ? name.split('.').pop() : '').toLowerCase();

    if (modeLabel) modeLabel.textContent = import.meta.env.PROD ? 'resources' : 'dev source';
    $('res-title').textContent = name;
    $('res-path').textContent = path;
    $('res-type').textContent = ext ? '.' + ext : '—';

    const open = $('res-open'), dl = $('res-download');
    if (open) open.setAttribute('href', url);
    if (dl)   dl.setAttribute('href', url);

    const setRendered = (s) => { const e = $('res-rendered'); if (e) e.textContent = s; };
    body.innerHTML = '<div class="muted">Loading…</div>';

    // 0. Folder listing — directory paths (council/* via the manifest, or any
    //    path ending in "/"). Renders direct children with links into the viewer.
    if (isFolderPath(path)) {
      const clean = path.replace(/\/+$/, '');
      const folderName = clean.split('/').pop() || clean;
      setRendered('folder');
      $('res-title').textContent = folderName;
      $('res-type').textContent = 'folder';
      if (open) open.removeAttribute('href');
      if (dl) dl.removeAttribute('href');
      renderFolder(body, clean);
      return;
    }

    // 1. Images
    if (IMAGE.has(ext)) {
      setRendered('image');
      body.innerHTML = '<div class="res-image-wrap"><img src="' + url + '" alt="' + esc(name) + '" /></div>';
      return;
    }
    // 2. Video / audio
    if (VIDEO.has(ext)) {
      setRendered('video');
      body.innerHTML = '<div class="res-frame-wrap"><video class="res-frame" controls src="' + url + '"></video></div>';
      return;
    }
    if (AUDIO.has(ext)) {
      setRendered('audio');
      body.innerHTML = '<div class="res-binary"><audio controls src="' + url + '" style="width:100%"></audio></div>';
      return;
    }
    // 3. PDF / HTML — native iframe
    if (FRAME.has(ext)) {
      setRendered(ext === 'pdf' ? 'PDF frame' : 'HTML frame');
      const frame = document.createElement('iframe');
      frame.className = 'res-frame'; frame.src = url; frame.setAttribute('title', name);
      const wrap = document.createElement('div'); wrap.className = 'res-frame-wrap'; wrap.appendChild(frame);
      body.innerHTML = ''; body.appendChild(wrap);
      return;
    }
    // 4. Office (docx/xlsx/pptx) — Microsoft Office Online viewer. Needs a public
    //    URL, which only exists in prod (/resources/* is ungated); in dev the file
    //    isn't publicly reachable, so fall back to download.
    if (OFFICE.has(ext)) {
      if (import.meta.env.PROD) {
        setRendered('Office Online preview');
        const abs = location.origin + url;
        const src = 'https://view.officeapps.live.com/op/view.aspx?src=' + encodeURIComponent(abs);
        body.innerHTML = '<div class="res-frame-wrap"><iframe class="res-frame" src="' + src +
          '" title="' + esc(name) + '"></iframe></div>' +
          '<p class="muted tiny">Preview rendered by Microsoft Office Online. Use Download for the original.</p>';
      } else {
        setRendered('download (preview in prod)');
        downloadCard(body, url, name, ext, 'Office preview needs the public production URL — download to open locally.');
      }
      return;
    }
    // 5a. Markdown — render to HTML via marked (trusted internal content, e.g.
    //     council docs). On failure, fall through to the raw-text <pre> path below.
    if (MARKDOWN.has(ext)) {
      setRendered('markdown');
      const ok = await renderMarkdown(body, url);
      if (ok) return;
      // else fall through to plain-text rendering
    }
    // 5. Text / code / data — fetch + render (pre, or table for CSV/TSV)
    if (TEXT.has(ext) || !ext) {
      setRendered(ext === 'csv' || ext === 'tsv' ? 'table' : 'text');
      const ok = await renderText(body, url, ext);
      if (!ok) { setRendered('download'); downloadCard(body, url, name, ext, 'File is too large or unavailable to preview inline.'); }
      return;
    }
    // 6. Everything else (eml, msg, zip, binaries…) — download only
    setRendered('download');
    downloadCard(body, url, name, ext, 'This file type can’t be previewed in the browser.');
  }

  // Run on first load and after each view-transition navigation (ClientRouter).
  document.addEventListener('astro:page-load', renderResource);
</script>
</Layout>

<style is:global>
  .res-meta { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-4); margin: var(--space-3) 0 var(--space-5); padding: var(--space-3) var(--space-4); font-size: var(--text-sm); color: var(--color-text); background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: 0; }
  .res-meta dt, .res-folder-crumbs, .res-jsoncrack-status { color: var(--color-text-muted); }
  .res-meta dt { font-weight: 600; margin: 0; } .res-meta dd { margin: 0; } .res-meta dd code { word-break: break-all; }
  .res-actions, .res-folder-head { display: flex; flex-wrap: wrap; gap: var(--space-3); } .res-actions { margin: 0 0 var(--space-4); } .res-folder-head { align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
  .res-actions a, .res-folder-up { display: inline-flex; align-items: center; min-height: var(--target-min); padding: var(--space-2) var(--space-4); font: 600 var(--text-sm)/1 var(--font-sans); text-decoration: none; color: var(--brand-ink); background: var(--brand-yellow); border: 1px solid var(--brand-yellow); border-radius: var(--radius-md); }
  .res-actions a:hover, .res-folder-up:hover { color: var(--brand-ink); background: var(--brand-yellow-active); text-decoration: none; }
  .res-frame-wrap, .res-jsoncrack-wrap { overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: 0; }
  .res-frame, .res-jsoncrack-wrap iframe { display: block; width: 100%; height: 80vh; border: 0; background: var(--color-surface); }
  .res-image-wrap, .res-binary { padding: var(--space-5); color: var(--color-text-muted); background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: 0; }
  .res-image-wrap { text-align: center; } .res-image-wrap img { max-width: 100%; height: auto; border-radius: 0; }
  .res-error, .res-load-error { padding: var(--space-4) var(--space-5); color: var(--color-status-warning); background: var(--color-status-warning-surface); border: 1px solid var(--color-status-warning); border-radius: 0; font-size: var(--text-sm); }
  .res-error code, .res-load-error code, .res-jsoncrack-status code, .res-prose-wrap code { padding: 1px var(--space-2); color: var(--color-code-inline); background: var(--color-code-inline-surface); border-radius: var(--radius-sm); }
  .res-json-modes { display: inline-flex; overflow: hidden; margin: 0 0 var(--space-3); background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: 0; }
  .res-json-modes button { min-height: var(--target-min); padding: var(--space-2) var(--space-4); color: var(--color-text); background: transparent; border: 0; border-right: 1px solid var(--color-border-strong); font: 600 var(--text-sm)/1 var(--font-sans); cursor: pointer; }
  .res-json-modes button:last-child { border-right: 0; } .res-json-modes button.active { color: var(--brand-ink); background: var(--brand-yellow); } .res-json-modes button:not(.active):hover { background: var(--color-action-subtle-hover); }
  .res-jsoncrack-status { padding: var(--space-3) var(--space-4); background: var(--color-surface-alt); border-bottom: 1px solid var(--color-border); font-size: var(--text-sm); }
  .res-folder-crumbs { margin-bottom: var(--space-2); font-size: var(--text-sm); word-break: break-all; } .res-folder-crumbs a { color: inherit; } .res-folder-crumbs a:hover { color: var(--color-link-hover); } .res-folder-crumbs .sep { margin: 0 var(--space-2); color: var(--color-text-muted); }
  .res-prose-wrap { overflow-x: visible; padding: var(--space-5) var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0; }
  .res-prose-wrap > :first-child { margin-top: 0; } .res-prose-wrap > :last-child { margin-bottom: 0; } .res-prose-wrap h1, .res-prose-wrap h2 { margin-top: var(--space-5); } .res-prose-wrap h3 { margin-top: var(--space-4); }
  .res-prose-wrap pre, .res-code-wrap pre { overflow: auto; font: var(--code); line-height: var(--leading-normal); } .res-prose-wrap pre { padding: var(--space-3) var(--space-4); background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: 0; } .res-prose-wrap pre code, .res-code-wrap code { padding: 0; background: transparent; }
  .res-prose-wrap table, .res-csv-wrap table, .res-folder-table { width: 100%; max-width: 100%; min-width: 0; table-layout: auto; border-collapse: collapse; font-size: var(--text-sm); } .res-prose-wrap table { margin: var(--space-3) 0; } .res-prose-wrap th, .res-prose-wrap td, .res-csv-wrap th, .res-csv-wrap td, .res-folder-table th, .res-folder-table td { min-width: 0; padding: var(--space-2) var(--space-3); text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; word-break: normal; white-space: normal; } .res-prose-wrap th, .res-csv-wrap th, .res-folder-table th { color: var(--color-table-header-text); background: var(--color-table-header-surface); font-weight: 600; }
  .res-prose-wrap blockquote { margin: var(--space-3) 0; padding: var(--space-2) var(--space-4); color: var(--color-text-muted); background: var(--color-surface-alt); border-left: 4px solid var(--brand-yellow); }
  .res-code-wrap { overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: 0; } .res-code-wrap pre { max-height: 80vh; margin: 0; padding: var(--space-4) var(--space-5); } .res-code-wrap code { color: var(--color-text); font-family: var(--font-mono); }
  .res-csv-wrap, .res-folder-table-wrap { overflow-x: hidden; overflow-y: auto; max-height: 80vh; background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: 0; } .res-csv-wrap th { position: sticky; top: 0; z-index: 1; white-space: normal; } .res-csv-wrap tbody tr:nth-child(even) td, .res-folder-table tbody tr:hover td { background: var(--color-surface-alt); }
  .res-prose-wrap :is(col, th, td), .res-csv-wrap :is(col, th, td), .res-folder-table :is(col, th, td) { width: auto !important; }
  .res-folder-table td { vertical-align: middle; } .res-folder-table tbody tr:last-child td { border-bottom: 0; } .res-folder-table a { color: var(--color-text); text-decoration: none; } .res-folder-table a:hover { color: var(--color-link-hover); text-decoration: underline; }
  .res-actions a:focus-visible, .res-folder-up:focus-visible, .res-json-modes button:focus-visible, .res-csv-wrap:focus-visible, .res-folder-table-wrap:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; box-shadow: 0 0 0 2px var(--color-focus-contrast); }
  @media (max-width: 34rem) { .res-meta { grid-template-columns: 1fr; } .res-prose-wrap { padding: var(--space-4); } }
</style>
