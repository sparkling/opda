---
/**
 * ODR detail page — ADR-0024. Renders the ODR markdown through the SAME Astro
 * content-collection pipeline as the manual (render(entry) → <Content/>), so
 * ODR pages inherit identical .prose styling and theme-aware diagrams. Replaces
 * the earlier marked + set:html path (generate-odr-html.mjs).
 */
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { ODR_REGISTRY } from '@/lib/odr-pages.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('odr');
  return entries.map((entry) => {
    // Capture the 4-digit number AND any letter suffix (e.g. 0008d), so spawned
    // ODRs like ODR-0008d get their own page id (odr-0008d) and don't collide
    // with their parent (odr-0008) in getStaticPaths.
    const num = (String(entry.id).match(/(\d{4}[a-z]?)/) || [])[1] || '';
    const meta = ODR_REGISTRY.find((o) => o.number === num)
      || { id: `odr-${num}`, number: num, title: '', kind: '', status: '' };
    return { params: { id: meta.id }, props: { entry, odr: meta } };
  });
}

const { entry, odr } = Astro.props;
const { Content } = await render(entry);
const data = entry.data || {};
const dateStr = data.date instanceof Date ? data.date.toISOString().slice(0, 10) : (data.date || '');
const kind = odr.kind || data.kind || '';
const status = odr.status || data.status || '';
---
<Layout
  title={`ODR-${odr.number} — ${odr.title}`}
  breadcrumbTitle={`ODR-${odr.number}`}
  hideBreadcrumbs={true}
  description={`Ontology Decision Record ${odr.number}: ${odr.title} (${kind}, ${status})`}
  proseClass="prose wide odr-detail"
  search={{ type: 'decision', collection: 'odr', status, identifier: `ODR-${odr.number}`, title: odr.title, date: dateStr, context: kind }}
>
  <Content />
  <footer class="odr-footer">
    <p>
      <a href="/modelling/odr">← Back to ODR Corpus</a>
      &ensp;|&ensp;
      {odr.source && <a href={`/decisions/odr/${odr.source}`} download>Download Markdown source</a>}
    </p>
    <p class="muted">
      This record's status, scope and dated amendments identify its current authority.
      Historical decisions retain their recorded context; later corrections remain auditable in Git history.
    </p>
  </footer>
</Layout>
