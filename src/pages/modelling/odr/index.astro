---
/**
 * All local ODRs, using metadata regenerated from canonical Markdown at setup.
 */
import Layout from '@/layouts/Layout.astro';
import { ODR_REGISTRY } from '@/lib/odr-pages.mjs';

const kindPillClass = {
  methodology:  'pill--brand',
  pattern:      'pill--info',
  mapping:      'pill--info',
  architecture: 'pill--warn',
  programme:    'pill--warn',
};

const statusPillClass = {
  accepted: 'pill--ok',
  proposed: 'pill--warn',
  rejected: 'pill--error',
};
---
<Layout
  title="ODR Corpus"
  description={`${ODR_REGISTRY.length} Ontology Decision Records — the reasoning and scope behind OPDA's modelling approach.`}
>
  <h1>ODR Corpus</h1>
  <p class="lead">
    The <strong>Ontology Decision Records (ODRs)</strong> are the Linked Data
    Council's historical deliberations and OPDA's current local modelling decisions —
    the <em>why</em> behind the approach. Each record identifies its own scope and
    authority, with the options considered, chosen outcome and consequences.
  </p>
  <p>
    {ODR_REGISTRY.length} records in total — every one is a live page rendered from its markdown.
    Records marked <em>✓ diagrams</em> have been enriched with illustrative Mermaid
    diagrams per <a href="/development/inputs/pdtf-schema/schema-derived-ontology/lineage-provenance-and-verification/historical-modelling">ADR-0024</a>; the rest render as text until
    their enrichment wave lands.
  </p>

  <table>
    <thead>
      <tr>
        <th>No.</th>
        <th>Title</th>
        <th>Kind</th>
        <th>Status</th>
        <th>Page</th>
      </tr>
    </thead>
    <tbody>
      {ODR_REGISTRY.map((odr) => (
        <tr>
          <td><code>{odr.number}</code></td>
          <td><a href={`/modelling/odr/${odr.id}`}>{odr.title}</a></td>
          <td><span class={`pill ${kindPillClass[odr.kind] ?? 'pill--brand'}`}>{odr.kind}</span></td>
          <td><span class={`pill ${statusPillClass[odr.status] ?? ''}`}>{odr.status}</span></td>
          <td>
            <a href={`/modelling/odr/${odr.id}`}>view</a>
            {odr.enriched && <span class="muted tiny"> · ✓ diagrams</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>About ODRs</h2>
  <p>
    An ODR is one of two kinds of decision:
  </p>
  <ul>
    <li>
      An <strong>ontological commitment</strong> (<code>kind: pattern</code> or <code>mapping</code>) —
      a declaration about what kinds of entities the domain contains, what their identity
      criteria are, what Roles or Phases they pass through.
    </li>
    <li>
      An <strong>artefact-engineering decision</strong> (<code>kind: architecture</code>,
      <code>methodology</code>, or <code>programme</code>) — a decision about how to structure,
      name, govern, sequence, or process the artefacts that encode the ontology.
    </li>
  </ul>
  <p>
    Current ODRs follow the project's decision-record conventions: explicit status,
    context, alternatives, consequences and confirmation. Authorised corrections are
    recorded with an updated date and amendment history. Historical records retain
    their original context and policy; new records make their scope and relationships explicit.
  </p>

  <h2>Methodology</h2>
  <p>
    All ODRs are ratified by the <strong>Linked Data Council</strong> — a simulated panel
    of 9 named linked-data and ontology authorities whose published positions are used
    to evaluate modelling decisions from multiple perspectives. See
    <a href="/modelling/odr/odr-0001">ODR-0001</a> for the full methodology.
  </p>
</Layout>
