---
import Layout from '@/layouts/Layout.astro';

const pathways = [
  { number: '01', className: 'strategy', href: '/strategy', title: 'Strategy',
    description: 'Why connected property data matters, how the programme is sequenced and where the work is heading.',
    topics: ['Programme roadmap', 'UK policy context', 'Smart Data alignment'] },
  { number: '02', className: 'governance', href: '/governance', title: 'Governance',
    description: 'Who has authority, how evidence becomes a decision and how standards move through review and adoption.',
    topics: ['Decision rights', 'Standards lifecycle', 'Conformance'] },
  { number: '03', className: 'modelling', href: '/model', title: 'Explore the model',
    description: 'Move from shared concepts to linked definitions, relationships, constraints and machine-readable views.',
    topics: ['Glossary and dictionary', 'Ontology and shapes', 'Schema and mappings'] },
  { number: '04', className: 'implementation', href: '/implementation', title: 'Build with it',
    description: 'Implementation guidance for composing schemas, validating payloads and connecting data through JSON-LD.',
    topics: ['Quickstart', 'Validation', 'Developer guidance'] },
  { number: '05', className: 'engagement', href: '/engagement', title: 'Join the work',
    description: 'Working groups, meeting records, transcripts and the evidence people contribute to the programme.',
    topics: ['Working groups', 'Meetings', 'Transcripts'] },
  { number: '06', className: 'adoption', href: '/adoption', title: 'Adoption',
    description: 'Member implementations, pilots and the routes by which shared property data becomes operational.',
    topics: ['Member work', 'Pilots', 'Ecosystem adoption'] },
  { number: '07', className: 'library', href: '/library', title: 'Evidence library',
    description: 'Documents, recordings, repositories and external references held with their source and context.',
    topics: ['Source archive', 'Reading list', 'Resource inventory'] },
  { number: '08', className: 'reference', href: '/design-system', title: 'Design system',
    description: 'The brand, interaction and accessibility contract used across this knowledge base.',
    topics: ['Foundations', 'Components', 'Implementation'] },
];
---
<Layout
  title="OPDA Knowledge Base"
  description="Evidence-led strategy, governance, semantic models and implementation guidance for connected UK property data."
  wrapArticle={false}
  hideSidebar={true}
  hideBreadcrumbs={true}
  hideFooter={true}
  hideComments={true}
  mainClass="app-main--home"
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="eyebrow">Open Property Data Association</p>
          <h1 id="home-title">One shared language for property data.</h1>
          <p class="lede">
            Follow the evidence from strategy and governance through a connected
            semantic model to practical implementation.
          </p>
          <div class="home-hero__actions">
            <a class="btn" href="/model">Explore the model</a>
            <a class="btn btn--outline-dark" href="/implementation">Start implementing</a>
          </div>
        </div>
        <div class="home-hero__index" aria-hidden="true">
          <strong>01</strong>
          <span>Knowledge, governance and implementation in one source-grounded reference.</span>
        </div>
      </div>
    </section>

    <div class="home-source-strip" aria-label="Knowledge-base qualities">
      <div class="home-source-strip__inner">
        <span class="home-source-strip__item"><strong>Evidence classified</strong></span>
        <span class="home-source-strip__item"><strong>Standards status visible</strong></span>
        <span class="home-source-strip__item"><strong>Machine-readable views linked</strong></span>
      </div>
    </div>

    <section class="home-section" aria-labelledby="explore-title">
      <header class="home-section__head">
        <p class="overline">Explore the work</p>
        <h2 id="explore-title">From shared intent to working data</h2>
        <p>Choose the view that matches the question you need to answer.</p>
      </header>
      <div class="home-sections">
        {pathways.map((pathway) => (
          <a class={`home-section-card ${pathway.className}`} href={pathway.href}>
            <span class="section-number">{pathway.number}</span>
            <h3>{pathway.title}</h3>
            <p>{pathway.description}</p>
            <ul class="topics" aria-label={`${pathway.title} includes`}>
              {pathway.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <span class="home-section-card__cta">Open section</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-status" aria-labelledby="status-title">
      <div class="home-status__frame">
        <header class="home-status__head">
          <h2 id="status-title">Know what you are looking at</h2>
          <a href="/governance/standards-lifecycle">How status works</a>
        </header>
        <div class="home-status__grid">
          <article class="home-status__item">
            <span class="pill pill--success">✓ Current baseline</span>
            <strong>Implemented knowledge</strong>
            <p>Documentation of the current schema-derived implementation.</p>
            <span class="provenance-chip">Source · committed corpus</span>
          </article>
          <article class="home-status__item">
            <span class="pill pill--warn">◇ Review candidate</span>
            <strong>Property Pack V2</strong>
            <p>A separate, visibly non-normative surface for human review.</p>
            <span class="provenance-chip">Status · not adopted</span>
          </article>
          <article class="home-status__item">
            <span class="pill pill--info">i Evidence trail</span>
            <strong>Decisions and sources</strong>
            <p>Architecture and ontology decisions retain context and consequences.</p>
            <span class="provenance-chip">Trace · ADR and ODR</span>
          </article>
        </div>
      </div>
    </section>

    <footer class="home-footer">
      <img src="/ui/brand/opda-wordmark-white.svg" alt="Open Property Data Association" width="149" height="42" />
      <a href="/strategy/project-roadmap">Project roadmap</a>
      <a href="/glossary">Glossary</a>
      <a href="/design-system">Design system</a>
      <a href="https://github.com/Property-Data-Trust-Framework" rel="noopener">GitHub</a>
    </footer>
  </div>
</Layout>
