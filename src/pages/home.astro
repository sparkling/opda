---
import Layout from '@/layouts/Layout.astro';

const pathways = [
  { number: '01', className: 'development', href: '/spdtf-2', title: 'Review developing SPDTF work',
    description: 'Follow the domain-led, evidence-up method and review SPDTF 2.0 work in development.',
    topics: ['Development method', 'Semantic modelling', 'Interoperability'] },
  { number: '02', className: 'working-groups', href: '/spdtf-2/working-groups', title: 'Join or visit a working group',
    description: 'Find the group workspace, contribution routes and recorded questions, evidence and dispositions.',
    topics: ['Group charters', 'Participation', 'Review records'] },
  { number: '03', className: 'pdtf-1', href: '/pdtf-1', title: 'Implement PDTF 1.0',
    description: 'Use the published PDTF 1.0 schemas, validation guidance and derived implementation material.',
    topics: ['Schemas', 'Validation', 'Implementation guidance'] },
  { number: '04', className: 'governance', href: '/governance', title: 'Check authority and maturity',
    description: 'See who may decide, what has been reviewed and how lifecycle and status are recorded.',
    topics: ['Decision rights', 'Lifecycle', 'Conformance'] },
  { number: '05', className: 'resources', href: '/resources', title: 'Find a term, source or decision',
    description: 'Trace definitions, source records and decisions with their provenance and context.',
    topics: ['Glossary and dictionary', 'Source registry', 'ADR and ODR records'] },
  { number: '06', className: 'programme', href: '/programme', title: 'Understand the continuation from PDTF 1.0 into SPDTF 2.0',
    description: 'Understand what carries forward from the published implementation and what changes in development.',
    topics: ['Programme context', 'PDTF 1.0 evidence', 'SPDTF 2.0 direction'] },
];
---
<Layout
  title="OPDA Knowledge Base"
  description="Evidence-led strategy, governance, semantic models and implementation guidance for connected UK property data."
  wrapArticle={false}
  hideSidebar={true}
  hideBreadcrumbs={true}
  hideFooter={true}
  hideComments={true}
  mainClass="app-main--home"
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="eyebrow">Open Property Data Association</p>
          <h1 id="home-title">One shared language for property data.</h1>
          <p class="lede">
            Follow the continuation from PDTF 1.0 into SPDTF 2.0 development,
            from attributed evidence and governance to practical implementation.
          </p>
          <div class="home-hero__actions">
            <a class="btn" href="/spdtf-2">Review developing SPDTF work</a>
            <a class="btn btn--outline-dark" href="/pdtf-1">Implement PDTF 1.0</a>
          </div>
        </div>
        <div class="home-hero__index" aria-hidden="true">
          <strong>01</strong>
          <span>PDTF 1.0 remains findable while SPDTF 2.0 develops through evidence and review.</span>
        </div>
      </div>
    </section>

    <div class="home-source-strip" aria-label="Knowledge-base qualities">
      <div class="home-source-strip__inner">
        <span class="home-source-strip__item"><strong>Evidence classified</strong></span>
        <span class="home-source-strip__item"><strong>Standards status visible</strong></span>
        <span class="home-source-strip__item"><strong>Machine-readable views linked</strong></span>
      </div>
    </div>

    <section class="home-section" aria-labelledby="explore-title">
      <header class="home-section__head">
        <p class="overline">Find your way in</p>
        <h2 id="explore-title">Six paths through the programme</h2>
        <p>Choose the task or authority question you need to answer.</p>
      </header>
      <div class="home-sections">
        {pathways.map((pathway) => (
          <a class={`home-section-card ${pathway.className}`} href={pathway.href}>
            <span class="section-number">{pathway.number}</span>
            <h3>{pathway.title}</h3>
            <p>{pathway.description}</p>
            <ul class="topics" aria-label={`${pathway.title} includes`}>
              {pathway.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <span class="home-section-card__cta">Open pathway</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-status" aria-labelledby="status-title">
      <div class="home-status__frame">
        <header class="home-status__head">
          <h2 id="status-title">Know what you are looking at</h2>
          <a href="/governance/standards-lifecycle">How status works</a>
        </header>
        <div class="home-status__grid">
          <article class="home-status__item">
            <span class="pill pill--success">✓ Published implementation</span>
            <strong>PDTF 1.0</strong>
            <p>The published schema implementation and derived semantic corpus, with each artefact retaining its own status.</p>
            <span class="provenance-chip">Work area · PDTF 1.0</span>
          </article>
          <article class="home-status__item">
            <span class="pill pill--warn">◇ Review candidate</span>
            <strong>SPDTF 2.0 development input</strong>
            <p>Machine-generated Property Pack pre-draft: structured and reviewable, but non-normative and not working-group reviewed.</p>
            <span class="provenance-chip">Status · no approval recorded</span>
          </article>
          <article class="home-status__item">
            <span class="pill pill--info">i Evidence trail</span>
            <strong>Decisions and sources</strong>
            <p>Architecture and ontology decisions retain context and consequences.</p>
            <span class="provenance-chip">Trace · ADR and ODR</span>
          </article>
        </div>
      </div>
    </section>

    <footer class="home-footer">
      <img src="/ui/brand/opda-wordmark-white.svg" alt="Open Property Data Association" width="149" height="42" />
      <a href="/programme">Programme</a>
      <a href="/glossary">Glossary</a>
      <a href="/design-system">Design system</a>
      <a href="https://github.com/Property-Data-Trust-Framework" rel="noopener">GitHub</a>
    </footer>
  </div>
</Layout>
