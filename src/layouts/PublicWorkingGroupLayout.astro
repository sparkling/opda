---
interface Props {
  title: string;
  description: string;
  current?: 'join' | 'privacy';
  socialImage?: string;
}

const { title, description, current, socialImage } = Astro.props;
const pageTitle = `${title} | OPDA`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site ?? Astro.url.origin)
  : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#131224" />
    <script is:inline>
      (function () {
        try {
          var theme = new URLSearchParams(location.search).get('theme');
          if (theme !== 'light' && theme !== 'dark') theme = localStorage.getItem('opda-theme');
          document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⌂</text></svg>" />
    <link rel="stylesheet" href="/ui/design-system.css" />
    <title>{pageTitle}</title>
  </head>
  <body class="public-working-groups">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="wg-public-header">
      <div class="wg-public-header__inner">
        <a class="wg-public-brand" href="https://openpropdata.org.uk/" aria-label="Open Property Data Association home">
          <img src="/ui/brand/opda-wordmark-white.svg" alt="Open Property Data Association" width="149" height="42" />
          <span>Smart Property Data Trust Framework</span>
        </a>
        <nav aria-label="Working group recruitment">
          <a href="/working-groups/join" aria-current={current === 'join' ? 'page' : undefined}>Join a working group</a>
          <a href="/working-groups/join/privacy" aria-current={current === 'privacy' ? 'page' : undefined}>Privacy</a>
          <button class="wg-theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="wg-public-footer">
      <div class="wg-public-footer__inner">
        <p><strong>Open Property Data Association</strong><br />Developing open, interoperable property data standards.</p>
        <nav aria-label="Footer">
          <a href="/working-groups/join/privacy">Working-group privacy notice</a>
          <a href="https://openpropdata.org.uk/privacy-policy/">General privacy policy</a>
          <a href="mailto:smartdata@openpropdata.org.uk">smartdata@openpropdata.org.uk</a>
        </nav>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.wg-theme-toggle');
      const syncThemeToggle = () => {
        if (!toggle) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
        toggle.setAttribute('aria-pressed', String(dark));
        toggle.setAttribute('aria-label', label);
        toggle.title = label;
      };
      syncThemeToggle();
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('opda-theme', next); } catch {}
        syncThemeToggle();
      });
    </script>
  </body>
</html>

<style is:global>
  .public-working-groups {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .public-working-groups main {
    flex: 1;
  }

  .skip-link {
    position: fixed;
    inset: var(--space-3) auto auto var(--space-3);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-text-strong);
    color: var(--color-surface);
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .wg-public-header {
    background: var(--brand-deep);
    border-bottom: 4px solid var(--brand-yellow);
  }

  .wg-public-header__inner,
  .wg-public-footer__inner {
    width: min(var(--content-max), calc(100% - 2rem));
    margin: 0 auto;
  }

  .wg-public-header__inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .wg-public-brand {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--target-min);
    color: var(--brand-white);
    text-decoration: none;
  }

  .wg-public-brand:hover {
    color: var(--brand-white);
    text-decoration: none;
  }

  .wg-public-brand img {
    display: block;
    width: 9.3125rem;
    height: auto;
  }

  .wg-public-brand span {
    color: var(--on-dark-muted);
    font-size: var(--text-sm);
  }

  .wg-public-header nav,
  .wg-public-footer nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .wg-public-header nav a {
    min-height: var(--target-min);
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-3);
    color: var(--on-dark-muted);
    font-weight: 600;
  }

  .wg-public-header nav a:hover,
  .wg-public-header nav a[aria-current='page'] {
    color: var(--brand-white);
  }

  .wg-public-header nav a[aria-current='page'] {
    box-shadow: inset 0 -4px 0 var(--brand-yellow);
  }

  .wg-theme-toggle {
    display: inline-grid;
    width: var(--target-min);
    height: var(--target-min);
    place-items: center;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--brand-white);
    cursor: pointer;
  }

  .wg-theme-toggle:hover {
    background: rgb(255 255 255 / 8%);
  }

  .wg-public-footer {
    margin-top: var(--space-10);
    border-top: 4px solid var(--brand-yellow);
    background: var(--brand-deep);
  }

  .wg-public-footer__inner {
    padding-block: var(--space-7);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .wg-public-footer p {
    max-width: 36ch;
    margin: 0;
    color: var(--on-dark-muted);
    font-size: var(--text-sm);
  }

  .wg-public-footer nav {
    align-items: flex-end;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wg-public-footer a { color: var(--brand-white); }

  @media (max-width: 44rem) {
    .wg-public-header__inner,
    .wg-public-footer__inner {
      align-items: flex-start;
      flex-direction: column;
      padding-block: var(--space-4);
    }

    .wg-public-header nav {
      width: 100%;
      justify-content: space-between;
    }

    .wg-public-footer nav {
      align-items: flex-start;
    }

    .wg-public-brand span {
      max-width: 20ch;
    }
  }

  @media (forced-colors: active) {
    .wg-public-header,
    .wg-public-footer {
      border-color: CanvasText;
    }
    .wg-public-header,
    .wg-public-footer { background: Canvas; color: CanvasText; }
    .wg-public-header :is(a, button), .wg-public-footer a { color: LinkText; }
    .wg-public-header nav a[aria-current='page'] { box-shadow: inset 0 -4px 0 Highlight; }
  }
</style>
