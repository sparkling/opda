---
import Layout from '@/layouts/Layout.astro';
import Callout from '@/components/Callout.astro';
import PageIllustration from '@/components/modelling/PageIllustration.astro';
import '@/styles/modelling/learning.css';
import '@/styles/modelling/field-guide.css';

interface Props {
  title: string;
  description: string;
  claim?: 'guide' | 'method' | 'example';
  proseClass?: string;
}
const {
  title,
  description,
  claim = 'guide',
  proseClass = 'prose wide modelling-document',
} = Astro.props;
const claims = {
  method: {
    label: 'Required modelling method',
    body: 'Examples do not establish candidate implementation.',
    tone: 'method' as const,
  },
  example: {
    label: 'Illustrative case',
    body: 'No real property, person or transaction.',
    tone: 'information' as const,
  },
};
const scopeNote = claim === 'guide' ? null : claims[claim];
---

<Layout title={title} description={description} proseClass={proseClass}>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
  <PageIllustration />
  {scopeNote && (
    <Callout title={scopeNote.label} tone={scopeNote.tone}>
      <p>{scopeNote.body}</p>
    </Callout>
  )}
  <slot />
</Layout>
