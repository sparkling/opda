---
import Layout from '@/layouts/Layout.astro';
import '@/styles/modelling/learning.css';

interface Props {
  title: string;
  description: string;
  claim?: 'guide' | 'method' | 'example';
  proseClass?: string;
}
const {
  title,
  description,
  claim = 'guide',
  proseClass = 'prose wide modelling-document',
} = Astro.props;
const claims = {
  method: {
    label: 'Required modelling method',
    body: 'Examples do not establish candidate implementation.',
    tone: 'warn',
  },
  example: {
    label: 'Illustrative case',
    body: 'No real property, person or transaction.',
    tone: 'note',
  },
};
const scopeNote = claim === 'guide' ? null : claims[claim];
---

<Layout title={title} description={description} proseClass={proseClass}>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
  {scopeNote && (
    <aside class={`callout callout--${scopeNote.tone}`}>
      <p class="callout__label">{scopeNote.label}</p>
      <p>{scopeNote.body}</p>
    </aside>
  )}
  <slot />
</Layout>
