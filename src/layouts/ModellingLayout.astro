---
import Layout from '@/layouts/Layout.astro';
import '@/styles/modelling/learning.css';

interface Props {
  title: string;
  description: string;
  claim?: 'guide' | 'method' | 'example';
  proseClass?: string;
}
const {
  title,
  description,
  claim = 'guide',
  proseClass = 'prose wide modelling-document',
} = Astro.props;
const claims = {
  method: 'Required modelling method · examples do not establish candidate implementation',
  example: 'Illustrative case · no real property, person or transaction',
};
const scopeNote = claim === 'guide' ? null : claims[claim];
---

<Layout title={title} description={description} proseClass={proseClass}>
  <h1>{title}</h1>
  <div class="callout callout--key">
    <p>{description}</p>
  </div>
  {scopeNote && <p class="modelling-standing">{scopeNote}</p>}
  <slot />
</Layout>
