---
/**
 * OPDA Knowledge Base — page shell.
 *
 * Composes Header + Sidebar + main content + PageFooter + SiteFooter at build time.
 * Derives section / active state / prev-next from Astro.url.pathname via
 * src/lib/site.ts. No runtime chrome injection; FOUC-free.
 *
 * Per-page interactivity (theme toggle, sidebar collapse, tree folder
 * toggle, mobile menu, TOC observer, Mermaid) ships as small client
 * scripts loaded at the bottom of the body.
 *
 * Astro's <ClientRouter /> enables view transitions for smooth
 * page-to-page navigation (docs/adr/0003 idiomatic Astro refactor).
 */
import { ClientRouter } from 'astro:transitions';
import FontPreloads from '@/components/FontPreloads.astro';
import { responsiveArtwork, ARTWORK_SIZES } from '@/lib/responsive-artwork.mjs';
// Global GraphDiagram island styling — needed on every page because the
// site-wide bare-.mermaid adoption (adoptBareMermaid) has no component to carry
// scoped styles. Also serves the <GraphDiagram> component.
import '../styles/graph-diagram.css';
import '../styles/editorial-content.css';
import Header from '@/components/Header.astro';
import Sidebar from '@/components/Sidebar.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageFooter from '@/components/PageFooter.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Comments from '@/components/Comments.astro';
import { getNavigationSection } from '@/lib/site-navigation';
import { assetVersion } from '@/lib/asset-version.mjs';
import { designSystemVersion } from '@/lib/design-system-version.mjs';
import {
  AUTHORITY_BY_DESTINATION,
  IA_STATUS_REGISTRY_VERSION,
  getRouteDisposition,
  getRouteStatus,
} from '@/lib/site-ia.mjs';
import { searchMetaEntries } from '@/lib/site-search-model.mjs';
import { DEFAULT_HEADER_PALETTE, HEADER_PALETTE_IDS } from '@/lib/header-palettes';
import { DEFAULT_HEADER_ICON, HEADER_ICON_IDS } from '@/lib/header-icons';

const cssV = await designSystemVersion();
const twV = assetVersion('/ui/tailwind.built.css');
const clientV = assetVersion('/ui/client.js');

interface Props {
  /** Page title — used as <title> (suffix " · OPDA Knowledge Base" added unless already present). */
  title: string;
  /** <meta name="description"> contents. */
  description?: string;
  /** Prose width class. Default 'prose wide'; pass 'prose' for narrow reading width. */
  proseClass?: string;
  /** Keep machine-generated reference content on its existing typography. */
  generatedContent?: boolean;
  /** Allow TailwindPlus enhancement when its UI is present. Default true. */
  tailwindPlus?: boolean;
  /** Wrap the slot in `<article class={proseClass}>`. Default true. */
  wrapArticle?: boolean;
  /** Hide the sidebar (e.g. for the home page or single-page sections). */
  hideSidebar?: boolean;
  /** Keep the page aligned with a section content rail without rendering its navigation. */
  reserveNavigationRail?: boolean;
  /** Suppress the generated on-page contents rail for application-style pages. */
  hideTableOfContents?: boolean;
  /** Preserve the shared contents-rail track without rendering its contents. */
  reserveTableOfContentsRail?: boolean;
  /** Hide the breadcrumbs (e.g. on section roots). */
  hideBreadcrumbs?: boolean;
  /** Plain current-page label when the document title contains qualifiers. */
  breadcrumbTitle?: string;
  /** Hide the prev/next page footer. */
  hideFooter?: boolean;
  /** Hide the Artalk comments section (e.g. on /404, /design-system). */
  hideComments?: boolean;
  /** Optional class added to the main region for page-level compositions. */
  mainClass?: string;
  /** Keep the global destinations visible without marking one current. */
  suppressActiveDestination?: boolean;
  /** Search facets for the build-time indexer (site-search-model.mjs); route defaults apply when omitted. */
  search?: Record<string, string | readonly string[] | undefined>;
  /** Above-the-fold artwork; preload only the selected theme, before CSS. */
  priorityImage?: { lightSrc: string; darkSrc?: string };
}

const {
  title,
  description,
  proseClass = 'prose wide',
  generatedContent = false,
  tailwindPlus = true,
  wrapArticle = true,
  hideSidebar = false,
  reserveNavigationRail = false,
  hideTableOfContents = false,
  reserveTableOfContentsRail = false,
  hideBreadcrumbs = false,
  breadcrumbTitle = title,
  hideFooter = false,
  hideComments = false,
  mainClass = '',
  suppressActiveDestination = false,
  search,
  priorityImage = null,
} = Astro.props;

const responsivePriorityImage = priorityImage ? { ...priorityImage,
  lightSrcset: await responsiveArtwork(priorityImage.lightSrc, { enabled: import.meta.env.PROD }),
  darkSrcset: await responsiveArtwork(priorityImage.darkSrc, { enabled: import.meta.env.PROD }),
  sizes: ARTWORK_SIZES,
} : null;

const fullTitle = /knowledge base/i.test(title)
  ? title
  : `${title} · OPDA Knowledge Base`;

const navigationSection = getNavigationSection(Astro.url.pathname);
const sectionAttr = navigationSection?.key ?? '';
const hasSidebarSlot = Astro.slots.has('sidebar');
const showSidebar = !hideSidebar && (hasSidebarSlot || !!navigationSection);
// Retired URLs can still reach Astro during a dev-server navigation before the
// redirect layer responds. Keep the shared shell renderable in that boundary
// state; the route remains retired and is not reintroduced into the IA.
const routeStatus = getRouteStatus(Astro.url.pathname) ?? AUTHORITY_BY_DESTINATION.resources;
const routeDisposition = getRouteDisposition(Astro.url.pathname);
const searchAliases = routeDisposition?.search?.historicalAliases ?? [];
const searchMeta = searchMetaEntries(search);
---
<!doctype html>
<html
  lang="en"
  class="app-document"
  data-section={sectionAttr}
  data-ia-status-version={IA_STATUS_REGISTRY_VERSION}
  data-work-area={routeStatus.workArea}
  data-authority={routeStatus.authority}
  data-maturity={routeStatus.maturity}
  data-content-version={routeStatus.version}
  data-provenance={routeStatus.provenance}
  data-page-elements={tailwindPlus ? 'auto' : 'disabled'}
>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* The shared framework heading uses the display face on every KB page. */}
  <FontPreloads display />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <meta name="opda:status-registry-version" content={IA_STATUS_REGISTRY_VERSION} />
  <meta name="opda:work-area" content={routeStatus.workArea} />
  <meta name="opda:authority" content={routeStatus.authority} />
  <meta name="opda:maturity" content={routeStatus.maturity} />
  <meta name="opda:version" content={routeStatus.version} />
  <meta name="opda:provenance" content={routeStatus.provenance} />
  {searchAliases.map((alias) => <meta name="opda:search-alias" content={alias} />)}
  {searchMeta.map(([name, content]) => <meta name={name} content={content} />)}
  {/* Pre-paint themes: apply light/dark and the temporary header palette before
      first render to avoid FOUC. Petrol is the palette default.
      Light/dark reads ?theme=, then localStorage, and falls back to light.
      data-astro-rerun makes it re-execute on every view transition; without
      that flag the new <html> would render without data-theme on navigation,
      flashing back to the default. */}
  <script
    is:inline
    data-astro-rerun
    data-opda-theme-bootstrap
    define:vars={{
      defaultHeaderPalette: DEFAULT_HEADER_PALETTE,
      headerPaletteIds: HEADER_PALETTE_IDS,
      defaultHeaderIcon: DEFAULT_HEADER_ICON,
      headerIconIds: HEADER_ICON_IDS,
      priorityImage: responsivePriorityImage,
    }}
  >
    (function () {
      try {
        var t = new URLSearchParams(location.search).get('theme');
        if (t !== 'light' && t !== 'dark') {
          t = localStorage.getItem('opda-theme');
        }
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);

        var p = localStorage.getItem('opda-header-palette');
        if (!headerPaletteIds.includes(p)) p = defaultHeaderPalette;
        document.documentElement.setAttribute('data-header-palette', p);

        var i = localStorage.getItem('opda-header-icon');
        if (!headerIconIds.includes(i)) i = defaultHeaderIcon;
        document.documentElement.setAttribute('data-header-icon', i);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
        document.documentElement.setAttribute('data-header-palette', defaultHeaderPalette);
        document.documentElement.setAttribute('data-header-icon', defaultHeaderIcon);
      }
      // A paired image has no speculative fallback src. Discover its one
      // selected URL here, without waiting for stylesheets or body scripts.
      if (priorityImage) {
        var source = document.documentElement.getAttribute('data-theme') === 'dark'
          ? priorityImage.darkSrc || priorityImage.lightSrc : priorityImage.lightSrc;
        var preload = document.querySelector('link[data-opda-priority-image]');
        if (!preload) {
          preload = document.createElement('link');
          preload.rel = 'preload';
          preload.as = 'image';
          preload.fetchPriority = 'high';
          preload.dataset.opdaPriorityImage = '';
          preload.imageSrcset = document.documentElement.getAttribute('data-theme') === 'dark'
            ? priorityImage.darkSrcset || priorityImage.lightSrcset || '' : priorityImage.lightSrcset || '';
          preload.imageSizes = priorityImage.sizes || '';
          preload.href = source;
          document.head.appendChild(preload);
        } else {
          preload.imageSrcset = document.documentElement.getAttribute('data-theme') === 'dark'
            ? priorityImage.darkSrcset || priorityImage.lightSrcset || '' : priorityImage.lightSrcset || '';
          preload.imageSizes = priorityImage.sizes || '';
          preload.href = source;
        }
      }
    })();
  </script>

  <link rel="stylesheet" href={`/ui/design-system.css?v=${cssV}`} />
  <link rel="stylesheet" href={`/ui/tailwind.built.css?v=${twV}`} />

  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div id="app">
    <Header
      showSidebar={showSidebar}
      alignWithNavigationRail={showSidebar || reserveNavigationRail}
      suppressActiveDestination={suppressActiveDestination}
    />
    <div class={`app-body rail-state-restoring${showSidebar ? '' : ' no-sidebar'}${reserveNavigationRail && !showSidebar ? ' reserve-navigation-rail' : ''}${reserveTableOfContentsRail ? ' reserve-toc-rail' : ''}`}>
      <script is:inline data-astro-rerun>
        (function () {
          var body = document.currentScript && document.currentScript.parentElement;
          if (!body) return;
          try {
            body.classList.toggle('sidebar-collapsed', localStorage.getItem('opda-sidebar-collapsed') === '1');
            body.classList.toggle('toc-collapsed', localStorage.getItem('opda-toc-collapsed') === '1');
          } catch (e) {}
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { body.classList.remove('rail-state-restoring'); });
          });
        })();
      </script>
      {showSidebar && (hasSidebarSlot ? <slot name="sidebar" /> : <Sidebar />)}
      <main class={`app-main${mainClass ? ` ${mainClass}` : ''}${!wrapArticle && !generatedContent ? ' editorial-content' : ''}`} id="main-content" tabindex="-1">
        {!hideBreadcrumbs && <Breadcrumbs currentPageTitle={breadcrumbTitle} />}
        {wrapArticle ? (
          <article class:list={[proseClass, { 'editorial-content': !generatedContent }]} data-disable-toc={hideTableOfContents ? 'true' : undefined}>
            <slot />
            {!hideFooter && <PageFooter />}
          </article>
        ) : (
          <>
            <slot />
            {!hideFooter && <PageFooter />}
          </>
        )}
        {!hideComments && <Comments />}
      </main>
    </div>
    <SiteFooter />
  </div>

  <script is:inline defer src={`/ui/client.js?v=${clientV}`}></script>
  <script>
    // Narrative pages need neither the custom-element package nor the diagram
    // engine. Load each only for its actual DOM, including view transitions and
    // dynamically inserted diagrams using the existing OPDA bridge.
    import { initialisePageFeatures } from '../scripts/page-features.mjs';
    initialisePageFeatures();
  </script>
  <slot name="scripts" />
</body>
</html>
