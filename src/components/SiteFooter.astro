---
import BrandHeading from '@/components/BrandHeading.astro';
import AudienceTracking from '@/components/AudienceTracking.astro';
import { audienceTracking, validAccounts } from '../lib/audience-tracking.mjs';
const trackingReady = audienceTracking.providerSettingsVerified && validAccounts(audienceTracking);
---
<footer class="public-footer">
  <p class="public-footer__credit">
    <span>Developed by <a href="https://sparklingideas.co.uk/">Sparkling Ideas</a></span>
    <span>Your expert in semantic modelling and agentic engineering</span>
  </p>
  <a class="public-footer__brand" href="https://openpropdata.org.uk/" rel="noopener">
    <BrandHeading scale="compact" />
  </a>
  <nav class="public-footer__links" aria-label="Footer">
    <a href="/join/privacy">Privacy</a>
    <a href="/accessibility">Accessibility</a>
    {trackingReady && <AudienceTracking />}
  </nav>
</footer>
