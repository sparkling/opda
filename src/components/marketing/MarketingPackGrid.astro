---
import { marketingPacks } from '@/data/marketing/packs.mjs';
import DestinationCards from '@/components/ia/DestinationCards.astro';
interface Props { anchor?: string; }
const { anchor } = Astro.props;
const fragment = anchor ? `#${encodeURIComponent(anchor)}` : '';
---
<DestinationCards cards={marketingPacks.map((pack) => ({
  url: `/marketing/packs/${pack.id}${fragment}`,
  title: pack.label,
  audience: pack.campaignStatus === 'existing-group' ? 'Existing working group' : pack.campaignStatus === 'current-wave' ? 'Current recruitment wave' : 'For a mixed audience',
  description: pack.scope,
  action: 'Open campaign pack',
}))} />
