---
import MarketingCopy from './MarketingCopy.astro';
import Button from '@/components/Button.astro';
import ActionGroup from '@/components/ActionGroup.astro';
import { isMarketingPreviewPath } from '@/data/marketing/previews.mjs';

interface Props {
  id: string;
  title: string;
  preview: string;
  text?: string;
  plainText?: boolean;
  textDownload?: string;
  emailDownload?: string;
  rows?: number;
}
const { id, title, preview, text = '', plainText = true, textDownload, emailDownload, rows = 12 } = Astro.props;
if (!isMarketingPreviewPath(preview)) {
  throw new Error('Marketing previews must be local generated HTML assets');
}
---
<div class="marketing-material" data-marketing-material>
  <div class="marketing-email-preview">
    <iframe src={preview} title={title} data-email-preview loading="lazy" sandbox="allow-same-origin allow-top-navigation-by-user-activation"></iframe>
  </div>
  <ActionGroup>
    <slot name="actions" />
    {emailDownload && <Button href={emailDownload} download>Download email with embedded images · EML<span class="visually-hidden">: {title}</span></Button>}
    <Button variant="ghost" href={preview} download>Download rich HTML<span class="visually-hidden">: {title}</span></Button>
    <Button variant="ghost" href={preview}>Open full preview<span class="visually-hidden">: {title}</span></Button>
  </ActionGroup>
  {plainText && <MarketingCopy id={id} title={title} text={text} download={textDownload} rows={rows} />}
</div>
