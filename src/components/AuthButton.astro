---
/**
 * Cognito participant sign-in / user-menu button — slotted into the header.
 *
 * Renders as a "Sign in" button when signed out and an avatar + dropdown
 * (Profile, Log out) when signed in. State is reconciled in the browser
 * on page-load and periodically while a signed-in page is visible.
 */
---
<div class="auth-button" data-auth-button>
  <button
    class="auth-button__signin btn btn--compact"
    type="button"
    id="auth-login-btn"
    hidden
  >
    Sign in
  </button>

  <div class="auth-button__user" id="auth-user-menu" hidden>
    <button
      class="auth-button__user-trigger"
      type="button"
      id="auth-user-trigger"
      aria-haspopup="menu"
      aria-expanded="false"
    >
      <span class="auth-button__avatar" id="auth-user-avatar"></span>
      <span class="auth-button__email" id="auth-user-email"></span>
      <svg class="auth-button__chevron" viewBox="0 0 24 24" width="14" height="14"
           fill="none" stroke="currentColor" stroke-width="2.25"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
    <div class="auth-button__dropdown" id="auth-user-dropdown" role="menu" hidden>
      <div class="auth-button__dropdown-header" id="auth-user-full"></div>
      <button class="auth-button__dropdown-item" id="auth-logout-btn" type="button" role="menuitem">
        Log out
      </button>
    </div>
  </div>
</div>

<script>
  import { createSessionWatch, readSessionIdentity } from '../scripts/auth-session-watch.mjs';

  // The path-scoped session service (ADR-0084) owns the opaque participant
  // session and exposes it same-origin: /_auth/me (identity), /_auth/login
  // (starts the PKCE flow), and /_auth/logout (revokes the session + ends provider
  // SSO). The development gate protects content separately; this button reflects
  // current eligibility and a 401 shows "Sign in".
  //
  // On the dev server there is no session service, so /_auth/* 404s. Rather than leave
  // "Sign in" pointing at a dead route, a dev-only mock lets you flip into a
  // fake local session, keyed on localStorage['opda-dev-auth']. Every mock
  // branch is guarded by import.meta.env.DEV inline — Vite replaces it with
  // `false` in production builds, so each block collapses to nothing and no
  // mock code (not even the identity object) reaches live.

  function gateIdentity(signal) {
    if (import.meta.env.DEV) {
      return window.localStorage.getItem('opda-dev-auth') === '1'
        ? { email: 'dev@localhost', name: 'Local Dev', picture: '' } : null;
    }
    return readSessionIdentity({ signal });
  }

  function renderIdentity(id) {
    const loginBtn = document.getElementById('auth-login-btn');
    const userMenu = document.getElementById('auth-user-menu');
    const userEmail = document.getElementById('auth-user-email');
    const userFull = document.getElementById('auth-user-full');
    const userAvatar = document.getElementById('auth-user-avatar');
    if (!loginBtn || !userMenu) return;

    const root = document.querySelector('[data-auth-button]');
    if (root) root.dataset.authState = id ? 'signed-in' : 'signed-out';
    loginBtn.disabled = false;
    loginBtn.textContent = 'Sign in';
    if (userAvatar) { userAvatar.textContent = ''; userAvatar.style.backgroundImage = ''; }
    if (id) {
      const display = id.name || id.email || 'Account';
      if (userEmail) userEmail.textContent = display;
      if (userFull) userFull.textContent = id.email || display;
      if (userAvatar && id.picture) {
        userAvatar.style.backgroundImage = `url(${JSON.stringify(id.picture)})`;
      } else if (userAvatar) {
        userAvatar.textContent = display.slice(0, 1).toUpperCase();
      }
      loginBtn.hidden = true;
      userMenu.hidden = false;
    } else {
      loginBtn.hidden = false;
      userMenu.hidden = true;
      if (userEmail) userEmail.textContent = '';
      if (userFull) userFull.textContent = '';
      closeDropdown();
      try { window.localStorage.removeItem('ArtalkUser'); } catch { /* Storage may be disabled. */ }
    }
  }

  function closeDropdown() {
    const dropdown = document.getElementById('auth-user-dropdown');
    if (dropdown) dropdown.hidden = true;
    document.getElementById('auth-user-trigger')?.setAttribute('aria-expanded', 'false');
  }

  const watcher = createSessionWatch({ readIdentity: gateIdentity, onIdentity: renderIdentity,
    onUnavailable(id) {
      // Keep a previously confirmed view during a transient failure. Without any
      // successful check, show a neutral unavailable control, not a logout claim.
      if (id !== undefined) renderIdentity(id);
      else {
        const button = document.getElementById('auth-login-btn');
        if (button) { button.hidden = false; button.disabled = true; button.textContent = 'Sign-in unavailable'; }
      }
      const root = document.querySelector('[data-auth-button]');
      if (root) root.dataset.authState = 'unavailable';
    },
    isVisible: () => document.visibilityState === 'visible',
  });
  let observedRoot;
  let leaving = false;

  function bind() {
    const loginBtn = document.getElementById('auth-login-btn');
    const logoutBtn = document.getElementById('auth-logout-btn');
    const trigger = document.getElementById('auth-user-trigger');
    const dropdown = document.getElementById('auth-user-dropdown');

    if (loginBtn && !loginBtn.dataset.bound) {
      loginBtn.dataset.bound = '1';
      loginBtn.addEventListener('click', () => {
        if (import.meta.env.DEV) {
          // No session service on the dev server — fake a local session instead of
          // 404ing on /_auth/login. Stripped from production builds.
          window.localStorage.setItem('opda-dev-auth', '1');
          watcher.stop(); void watcher.start();
          return;
        }
        leaving = true; watcher.stop();
        const ret = window.location.pathname + window.location.search;
        window.location.href = '/_auth/login?return=' + encodeURIComponent(ret);
      });
    }

    if (logoutBtn && !logoutBtn.dataset.bound) {
      logoutBtn.dataset.bound = '1';
      logoutBtn.addEventListener('click', () => {
        // Clear the cached Artalk SSO JWT so the Comments widget can't reuse it,
        // then let the session service revoke its session and end Cognito SSO.
        leaving = true; watcher.stop(); renderIdentity(null);
        if (import.meta.env.DEV) {
          // Tear down the mock local session; no gate to call. Stripped from prod.
          window.localStorage.removeItem('opda-dev-auth');
          leaving = false; void watcher.start();
          return;
        }
        window.location.href = '/_auth/logout';
      });
    }

    if (trigger && dropdown && !trigger.dataset.bound) {
      trigger.dataset.bound = '1';
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = dropdown.hidden;
        dropdown.hidden = !open;
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
  }

  function init() {
    const root = document.querySelector('[data-auth-button]');
    if (!root || root === observedRoot) return;
    observedRoot = root; leaving = false;
    bind();
    void watcher.start();
  }

  // One listener set for this bundled module, not one per new header element.
  document.addEventListener('click', (event) => {
    const dropdown = document.getElementById('auth-user-dropdown');
    const trigger = document.getElementById('auth-user-trigger');
    if (dropdown && !dropdown.hidden && !dropdown.contains(event.target) && event.target !== trigger) closeDropdown();
  });
  window.addEventListener('focus', () => { if (!leaving) void watcher.refresh(); });
  window.addEventListener('pageshow', (event) => {
    // Initial init already checks eligibility. Only BFCache restoration needs
    // a fresh check here, even when that first request finished before load.
    if (!event.persisted) return;
    leaving = false; if (observedRoot) void watcher.start();
  });
  window.addEventListener('pagehide', () => watcher.pause());
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') watcher.pause();
    else if (!leaving && observedRoot) void watcher.start();
  });
  document.addEventListener('astro:before-swap', () => { watcher.pause(); observedRoot = undefined; });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  // Re-init after Astro view transitions
  document.addEventListener('astro:page-load', init);
</script>
