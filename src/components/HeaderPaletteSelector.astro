---
import {
  DEFAULT_HEADER_PALETTE,
  FIXED_DARK_OPDA,
  HEADER_PALETTES,
} from '@/lib/header-palettes';
import HeaderIdentityPreview from '@/components/HeaderIdentityPreview.astro';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const inputName = embedded ? 'header-palette-embedded' : 'header-palette';
const pageSize = 4;
const pageCount = Math.ceil(HEADER_PALETTES.length / pageSize);

const previewStyle = (palette: (typeof HEADER_PALETTES)[number]) => [
  `--preview-opda-light:${palette.light[0]}`,
  `--preview-mark-a-light:${palette.light[1]}`,
  `--preview-framework-light:${palette.light[2]}`,
  `--preview-opda-dark:${FIXED_DARK_OPDA}`,
  `--preview-mark-a-dark:${palette.dark[0]}`,
  `--preview-framework-dark:${palette.dark[1]}`,
].join(';');
---

<div class:list={['header-preview-control', 'header-preview-control--palette', { 'header-preview-control--embedded': embedded }]}>
  <button type="button" class="header-preview-control__step header-preview-control__step--previous" aria-label="Previous header theme" title="Previous header theme" data-header-palette-previous>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  <details class="header-preview-selector" data-header-palette-selector data-header-palette-page-size={pageSize}>
    <summary>
      <span class="header-preview-selector__summary-label">Theme</span>
      <strong data-header-palette-current>Petrol</strong>
    </summary>
    <div class="header-preview-selector__flyout">
      <fieldset>
        <legend>Header colour theme</legend>
        {Astro.slots.has('companion') && (
          <div class="header-preview-selector__companion"><slot name="companion" /></div>
        )}
        <p>Select a card to preview the complete paired identity.</p>
        <div class="header-preview-selector__options">
          {HEADER_PALETTES.map((palette, index) => (
            <label
              class="header-preview-selector__card"
              data-header-palette-option={palette.id}
              data-header-palette-page={Math.floor(index / pageSize) + 1}
              hidden={index >= pageSize}
              style={previewStyle(palette)}
            >
              <input
                type="radio"
                name={inputName}
                value={palette.id}
                checked={palette.id === DEFAULT_HEADER_PALETTE}
                data-palette-name={palette.name}
                data-header-palette-input
              />
              <span class="header-preview-selector__card-title"><b>{palette.number}</b> {palette.name}</span>
              <span class="header-preview-selector__card-previews">
                <span class="header-preview-selector__card-preview header-preview-selector__card-preview--light">
                  <HeaderIdentityPreview />
                </span>
                <span class="header-preview-selector__card-preview header-preview-selector__card-preview--dark">
                  <HeaderIdentityPreview />
                </span>
              </span>
            </label>
          ))}
        </div>
        <nav class="header-preview-selector__pagination" aria-label="Theme pages" hidden={pageCount <= 1} data-header-palette-pagination>
          <button type="button" aria-label="Previous theme page" data-header-palette-page-previous disabled={pageCount <= 1}>Previous</button>
          <output aria-live="polite"><span data-header-palette-page-current>1</span> / {pageCount}</output>
          <button type="button" aria-label="Next theme page" data-header-palette-page-next>Next</button>
        </nav>
      </fieldset>
    </div>
  </details>
  <button type="button" class="header-preview-control__step header-preview-control__step--next" aria-label="Next header theme" title="Next header theme" data-header-palette-next>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
  </button>
</div>
