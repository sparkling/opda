---
import { workingGroupContexts } from '@/data/working-group-campaign';
import {
  newsletterConsentText,
  newsletterPrivacyNoticeVersion,
} from '@/data/newsletter-subscription';

interface Props {
  mode: 'dialog' | 'page';
}

const { mode } = Astro.props;
const prefix = `newsletter-${mode}`;
---
<div class={`newsletter-form-region newsletter-form-region--${mode}`} data-newsletter-region>
  <form
    class="newsletter-form"
    method="post"
    action="/api/newsletter-subscription"
    data-newsletter-form
    data-privacy-notice-version={newsletterPrivacyNoticeVersion}
    novalidate
  >
    <div class="newsletter-error-summary" role="alert" tabindex="-1" data-newsletter-errors hidden>
      <h2>Check the information you entered</h2>
      <ul></ul>
    </div>

    <fieldset class="newsletter-form__section">
      <legend>About you</legend>
      <p>Fields marked <span aria-hidden="true">*</span> are required.</p>
      <div class="newsletter-fields">
        <div class="newsletter-field">
          <label for={`${prefix}-full-name`}>Full name <span aria-hidden="true">*</span></label>
          <input class="db-input" id={`${prefix}-full-name`} name="fullName" type="text" autocomplete="name" minlength="2" maxlength="100" aria-describedby={`${prefix}-full-name-error`} required />
          <p class="newsletter-field__error" id={`${prefix}-full-name-error`} data-error-for="fullName"></p>
        </div>
        <div class="newsletter-field">
          <label for={`${prefix}-email`}>Organisational email address <span aria-hidden="true">*</span></label>
          <input class="db-input" id={`${prefix}-email`} name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" aria-describedby={`${prefix}-email-hint ${prefix}-email-error`} required />
          <p class="newsletter-field__hint" id={`${prefix}-email-hint`}>We use this address to send your updates.</p>
          <p class="newsletter-field__error" id={`${prefix}-email-error`} data-error-for="email"></p>
        </div>
        <div class="newsletter-field">
          <label for={`${prefix}-organisation`}>Organisation <span aria-hidden="true">*</span></label>
          <input class="db-input" id={`${prefix}-organisation`} name="organisation" type="text" autocomplete="organization" minlength="2" maxlength="150" aria-describedby={`${prefix}-organisation-error`} required />
          <p class="newsletter-field__error" id={`${prefix}-organisation-error`} data-error-for="organisation"></p>
        </div>
        <div class="newsletter-field">
          <label for={`${prefix}-role`}>Role or area of expertise <span aria-hidden="true">*</span></label>
          <input class="db-input" id={`${prefix}-role`} name="role" type="text" autocomplete="organization-title" minlength="2" maxlength="120" aria-describedby={`${prefix}-role-error`} required />
          <p class="newsletter-field__error" id={`${prefix}-role-error`} data-error-for="role"></p>
        </div>
      </div>
    </fieldset>

    <fieldset class="newsletter-form__section" aria-describedby={`${prefix}-groups-hint ${prefix}-groups-error`} data-newsletter-group>
      <legend>Which working groups interest you?</legend>
      <p id={`${prefix}-groups-hint`}>Select one or more. <span aria-hidden="true">*</span></p>
      <div class="newsletter-choices">
        {workingGroupContexts.map((context) => (
          <label class="newsletter-choice">
            <input id={`${prefix}-${context.value}`} type="checkbox" name="workingGroups" value={context.value} />
            <span><strong>{context.label}</strong><span>{context.scope}</span></span>
          </label>
        ))}
      </div>
      <p class="newsletter-field__error" id={`${prefix}-groups-error`} data-error-for="workingGroups"></p>
    </fieldset>

    <label class="newsletter-consent">
      <input id={`${prefix}-consent`} name="consent" type="checkbox" value="true" aria-describedby={`${prefix}-consent-error`} required />
      <span>{newsletterConsentText} <span aria-hidden="true">*</span></span>
    </label>
    <p class="newsletter-field__error" id={`${prefix}-consent-error`} data-error-for="consent"></p>

    <p class="newsletter-form__privacy">Read the <a href="/subscribe/privacy">newsletter privacy notice</a>. Subscription is separate from working-group registration.</p>
    <div class="newsletter-honeypot" aria-hidden="true">
      <label for={`${prefix}-website`}>Leave this field empty</label>
      <input id={`${prefix}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input name="startedAt" type="hidden" data-newsletter-started-at />
    <input name="privacyNoticeVersion" type="hidden" value={newsletterPrivacyNoticeVersion} />
    <input name="source" type="hidden" value={mode} />

    <div class="newsletter-form__actions">
      <button class="btn" type="submit">Subscribe</button>
      {mode === 'dialog' && <button class="btn btn--ghost" type="button" data-newsletter-cancel>Cancel</button>}
    </div>
    <p class="newsletter-form__status" aria-live="polite" data-newsletter-status></p>
  </form>

  <section class="newsletter-success" tabindex="-1" data-newsletter-success hidden>
    <p class="overline">Subscription received</p>
    <h2>Thank you for subscribing</h2>
    <p>We will send occasional OPDA updates about the framework, working groups and events.</p>
    {mode === 'dialog' && <button class="btn" type="button" data-newsletter-done>Done</button>}
  </section>
</div>

<script>
  import '@/scripts/newsletter-subscription';
</script>
