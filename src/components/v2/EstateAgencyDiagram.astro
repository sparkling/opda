---
import GraphDiagram from '@/components/GraphDiagram.astro';
import { buildEstateAgencyMermaidDiagram } from '@/lib/estate-agency-editorial-diagram.mjs';
import '@/styles/estate-agency-diagram.css';

const diagram = buildEstateAgencyMermaidDiagram();
---

<GraphDiagram
  source={diagram.source}
  links={diagram.links}
  profile="opda-diagram-design"
  provenance={diagram.provenance}
  minHeight="620px"
  caption="Estate agency candidate model. Mermaid 11.16.0 with ELK 0.2.2 preserves the source graph and layout; Diagram Design 2.4 with the OPDA profile supplies the visual and accessibility treatment. All 19 candidate resources remain linked, three standards remain unlinked references, and no cardinalities are inferred."
/>
