---
const pages = [
  ['why-ontologies', 'Why ontologies'],
  ['semantic-package', 'Six-part semantic package'],
  ['bounded-contexts', 'Bounded contexts and common boundary'],
  ['coverage', 'Coverage crosswalk'],
  ['standards', 'Standards, vocabularies and frameworks'],
  ['evidence-and-mappings', 'Evidence, provenance and mappings'],
  ['validation', 'Validation, conformance and projections'],
];
const current = Astro.url.pathname.split('/').filter(Boolean).at(-1);
---

<nav class="ia-journey" aria-label="Ontology journey">
  <p class="overline">Ontologies and semantic modelling</p>
  <ol>
    {pages.map(([slug, label], index) => (
      <li>
        <a href={`/spdtf-2/ontologies/${slug}`} aria-current={current === slug ? 'page' : undefined}>
          <span>{String(index + 1).padStart(2, '0')}</span>{label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .ia-journey { margin: 1.25rem 0 2rem; padding: 1rem 1.1rem; border: 1px solid var(--color-border, #d6d9de); border-radius: 0.35rem; background: var(--color-surface-subtle, #f5f7f8); }
  .ia-journey .overline { margin: 0 0 0.65rem; }
  .ia-journey ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem 0.75rem; margin: 0; padding: 0; list-style: none; }
  .ia-journey a { display: block; padding: 0.35rem 0.45rem; border-radius: 0.2rem; color: inherit; font-size: 0.88rem; text-decoration: none; }
  .ia-journey a:hover, .ia-journey a:focus-visible, .ia-journey a[aria-current='page'] { background: var(--color-surface-raised, #fff); color: var(--color-brand, #135f75); }
  .ia-journey a:focus-visible { outline: 3px solid var(--color-focus, #a94600); outline-offset: 2px; }
  .ia-journey a span { display: inline-block; width: 2rem; color: var(--color-text-muted, #5b6470); font-size: 0.72rem; font-weight: 700; }
  @media (max-width: 800px) { .ia-journey ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .ia-journey ol { grid-template-columns: 1fr; } }
</style>
