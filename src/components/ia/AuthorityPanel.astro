---
import { AUTHORITY_BY_DESTINATION, getRouteStatus } from '@/lib/site-ia.mjs';

type Destination = keyof typeof AUTHORITY_BY_DESTINATION;

interface Props {
  destination: Destination;
  label?: string;
  path?: string;
}

const { destination, label = 'Authority and status', path = Astro.url.pathname } = Astro.props;
const authority = getRouteStatus(path) ?? AUTHORITY_BY_DESTINATION[destination];
if (!authority) throw new Error(`Unknown information-architecture destination: ${destination}`);

const fields = [
  ['workArea', 'Work area', authority.workArea],
  ['authority', 'Authority', authority.authority],
  ['maturity', 'Maturity', authority.maturity],
  ['version', 'Version', authority.version],
  ['provenance', 'Provenance', authority.provenance],
] as const;
---

<aside class="ia-authority" data-ia-status={destination} aria-label={label}>
  <div class="ia-authority__heading">
    <p class="overline">{label}</p>
    <p class="ia-authority__note">Read the words; colour is only a visual cue.</p>
  </div>
  <dl class="ia-authority__grid">
    {fields.map(([key, name, value]) => (
      <div class="ia-authority__field" data-ia-field={key}>
        <dt>{name}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .ia-authority {
    margin: 1.5rem 0 2rem;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--brand-yellow);
    border-radius: 0;
    background: var(--color-surface-alt);
  }

  .ia-authority__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }

  .ia-authority__heading .overline { margin: 0; }

  .ia-authority__note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .ia-authority__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .ia-authority__field {
    min-width: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .ia-authority dt {
    color: var(--color-text-muted);
    font: 700 var(--text-xs) / 1.3 var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ia-authority dd {
    margin: var(--space-2) 0 0;
    color: var(--color-text);
    font: var(--text-sm) / 1.45 var(--font-sans);
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .ia-authority__heading { display: block; }
    .ia-authority__note { margin-top: var(--space-2); }
    .ia-authority__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .ia-authority__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ia-authority * { transition-duration: 0ms !important; }
  }

  @media (forced-colors: active) {
    .ia-authority { border-color: CanvasText; border-left-color: Highlight; background: Canvas; }
    .ia-authority__field { border-top-color: CanvasText; }
  }
</style>
