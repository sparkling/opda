---
interface Props {
  href: string;
  title: string;
  description: string;
  eyebrow?: string;
}

const { href, title, description, eyebrow = 'Explore' } = Astro.props;
---

<a class="card ia-gateway-card" href={href}>
  <span class="ia-gateway-card__eyebrow">{eyebrow}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="ia-gateway-card__link">Open page <span aria-hidden="true">→</span></span>
</a>

<style>
  .ia-gateway-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-surface-card);
    color: inherit;
    text-decoration: none;
    min-block-size: 44px;
    transition: none;
  }

  .ia-gateway-card:hover { border-color: var(--color-border-strong); }

  .ia-gateway-card:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; box-shadow: 0 0 0 4px var(--color-focus-contrast); }
  .ia-gateway-card__eyebrow { color: var(--color-link); font: 700 var(--text-xs) / 1.3 var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase; }
  .ia-gateway-card h3 { margin: var(--space-2) 0 var(--space-3); }
  .ia-gateway-card p { margin: 0; color: var(--color-text-muted); line-height: 1.5; }
  .ia-gateway-card__link { margin-top: auto; padding-top: var(--space-5); color: var(--color-link); font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .ia-gateway-card { transition: none; }
  }

  @media (forced-colors: active) {
    .ia-gateway-card { border-color: CanvasText; background: Canvas; }
    .ia-gateway-card:hover, .ia-gateway-card:focus-visible { border-color: Highlight; }
  }
</style>
