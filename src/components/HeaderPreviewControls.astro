---
import HeaderPaletteSelector from '@/components/HeaderPaletteSelector.astro';
import HeaderIconSelector from '@/components/HeaderIconSelector.astro';
import HeaderTuningSelector from '@/components/HeaderTuningSelector.astro';
import type { HeaderIconId } from '@/lib/header-icons';
import type { HeaderPaletteId } from '@/lib/header-palettes';

interface Props {
  showScaleControl?: boolean;
  controlId?: string;
  identityId?: string;
  initialScale?: number;
  initialSpaceAbove?: number;
  initialLineGap?: number;
  initialSpaceBelow?: number;
  initialOpdaScale?: number;
  initialUtilitySpaceAbove?: number;
  initialIcon?: HeaderIconId;
  initialPalette?: HeaderPaletteId;
  showUtilitySpacingControl?: boolean;
}

const {
  showScaleControl = false,
  controlId = 'header-preview-selectors',
  identityId = 'home-campaign-identity',
  initialScale = 24,
  initialSpaceAbove = 0,
  initialLineGap = 8,
  initialSpaceBelow = 0,
  initialOpdaScale = 100,
  initialUtilitySpaceAbove = 0,
  initialIcon,
  initialPalette,
  showUtilitySpacingControl = false,
} = Astro.props;

---

<div class="header-preview-controls" data-header-preview-controls data-icon-selection="persistent" hidden>
  <div class="header-preview-controls__drawer" id={controlId}>
    <div class="header-preview-controls__selectors">
      {showScaleControl && (
        <HeaderTuningSelector
          identityId={identityId}
          initialScale={initialScale}
          initialSpaceAbove={initialSpaceAbove}
          initialLineGap={initialLineGap}
          initialSpaceBelow={initialSpaceBelow}
          initialOpdaScale={initialOpdaScale}
          initialUtilitySpaceAbove={initialUtilitySpaceAbove}
          showUtilitySpacingControl={showUtilitySpacingControl}
        />
      )}
      <HeaderIconSelector initialIcon={initialIcon}>
        <Fragment slot="companion">
          {showScaleControl && (
            <HeaderTuningSelector
              identityId={identityId}
              initialScale={initialScale}
              initialSpaceAbove={initialSpaceAbove}
              initialLineGap={initialLineGap}
              initialSpaceBelow={initialSpaceBelow}
              initialOpdaScale={initialOpdaScale}
              initialUtilitySpaceAbove={initialUtilitySpaceAbove}
              showUtilitySpacingControl={showUtilitySpacingControl}
            />
          )}
          <HeaderPaletteSelector embedded initialPalette={initialPalette} />
        </Fragment>
      </HeaderIconSelector>
      <HeaderPaletteSelector initialPalette={initialPalette}>
        <Fragment slot="companion">
          {showScaleControl && (
            <HeaderTuningSelector
              identityId={identityId}
              initialScale={initialScale}
              initialSpaceAbove={initialSpaceAbove}
              initialLineGap={initialLineGap}
              initialSpaceBelow={initialSpaceBelow}
              initialOpdaScale={initialOpdaScale}
              initialUtilitySpaceAbove={initialUtilitySpaceAbove}
              showUtilitySpacingControl={showUtilitySpacingControl}
            />
          )}
          <HeaderIconSelector embedded initialIcon={initialIcon} />
        </Fragment>
      </HeaderPaletteSelector>
    </div>
  </div>
  <button
    type="button"
    class="header-preview-controls__toggle"
    aria-controls={controlId}
    aria-expanded="true"
    aria-label="Hide design selectors"
    title="Hide design selectors"
    data-header-preview-toggle
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g class="header-preview-controls__toggle-icon header-preview-controls__toggle-icon--hide">
        <polyline points="5 6 11 12 5 18" />
        <polyline points="11 6 17 12 11 18" />
      </g>
      <g class="header-preview-controls__toggle-icon header-preview-controls__toggle-icon--show">
        <polyline points="13 6 7 12 13 18" />
        <polyline points="19 6 13 12 19 18" />
      </g>
    </svg>
  </button>
</div>
