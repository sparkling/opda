---
/**
 * Explicit authoring component for the site-wide Mermaid viewer. Bare Mermaid
 * from Diagram, Markdown and generated pages is adopted into the same shell.
 */
import { graphDiagramShellHtml } from '@/lib/graph-diagram-shell';

interface Props {
  /** Mermaid source. If omitted, the default slot's text is used. */
  source?: string;
  caption?: string;
  /** Static min-height for the diagram box (e.g. "520px"). */
  minHeight?: string;
}

const { source, caption, minHeight } = Astro.props;
const configJson = JSON.stringify({ mode: 'static', source: source ?? '' }).replace(/</g, '\\u003c');
const slotSource = source ? '' : await Astro.slots.render('default');
const shellHtml = graphDiagramShellHtml(slotSource);
---

<figure
  class="graph-diagram-wrapper"
  data-node-interaction="interactive"
  style={minHeight ? `--gd-min-height:${minHeight}` : undefined}
>
  <script type="application/json" class="gd-config" set:html={configJson} />
  <Fragment set:html={shellHtml} />
  {caption && <figcaption class="gd-caption" set:html={caption} />}
  <slot name="legend" />
</figure>
