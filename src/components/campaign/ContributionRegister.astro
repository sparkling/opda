---
import type { ContributionOption } from '@/data/working-group-campaign';

interface Props {
  options: ContributionOption[];
}

const { options } = Astro.props;
---

<div class="contribution-register-container">
  <dl class="contribution-register">
    {options.map((option) => (
      <div class="contribution-register__entry">
        <dt>{option.label}</dt>
        <dd>{option.description}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  /* Six definitions in three colour-keyed pairs. Hue is a grouping key from the
     categorical palette (violet, teal, magenta in palette order); never a status. */
  .contribution-register-container {
    min-width: 0;
    container: contributions / inline-size;
  }

  .contribution-register {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) 0;
    margin: 0;
    padding: 0;
  }

  .contribution-register__entry {
    --register-hue: var(--color-data-1);
    display: grid;
    grid-template-areas:
      'marker term'
      '. description';
    grid-template-columns: 0.75rem minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    align-content: start;
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--register-hue);
  }

  .contribution-register__entry:nth-child(6n + 3),
  .contribution-register__entry:nth-child(6n + 4) { --register-hue: var(--color-data-3); }
  .contribution-register__entry:nth-child(6n + 5),
  .contribution-register__entry:nth-child(6n + 6) { --register-hue: var(--color-data-4); }

  :global(:root[data-theme='dark']) .contribution-register__entry { --register-hue: var(--color-data-1-dark); }
  :global(:root[data-theme='dark']) .contribution-register__entry:nth-child(6n + 3),
  :global(:root[data-theme='dark']) .contribution-register__entry:nth-child(6n + 4) { --register-hue: var(--color-data-3-dark); }
  :global(:root[data-theme='dark']) .contribution-register__entry:nth-child(6n + 5),
  :global(:root[data-theme='dark']) .contribution-register__entry:nth-child(6n + 6) { --register-hue: var(--color-data-4-dark); }

  /* The right-hand entry shares its pair's panel; the divider is the left entry's border. */
  .contribution-register__entry:nth-child(even) { border-left: 0; }

  .contribution-register__entry::before {
    content: '';
    grid-area: marker;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.4375rem; /* optical: centres the square on the H4 cap height */
    background: var(--register-hue);
  }

  .contribution-register__entry dt {
    grid-area: term;
    margin: 0;
    color: var(--color-text-strong);
    font: var(--h4);
    text-align: start;
  }

  .contribution-register__entry dd {
    grid-area: description;
    margin: 0;
    color: var(--color-text-muted);
    font: 400 var(--text-sm) / 1.375rem var(--font-sans);
    text-align: start;
    hyphens: none;
  }

  /* Narrow track: entries stack and each pair stays one panel with a 1px inner rule. */
  @container contributions (max-width: 40rem) {
    .contribution-register { row-gap: 0; }
    .contribution-register__entry { grid-column: 1 / -1; }
    .contribution-register__entry:nth-child(odd) { border-bottom: 0; }
    .contribution-register__entry:nth-child(odd):not(:first-child) { margin-top: var(--space-3); }
    .contribution-register__entry:nth-child(even) {
      border-top: 1px solid var(--color-border);
      border-left: 1px solid var(--color-border);
    }
  }

  @media (forced-colors: active) {
    .contribution-register__entry { background: Canvas; border-color: CanvasText; }
    .contribution-register__entry::before { background: CanvasText; }
    .contribution-register__entry :is(dt, dd) { color: CanvasText; }
  }
</style>
