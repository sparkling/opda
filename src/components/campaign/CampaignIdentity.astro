---
import BrandHeading from '@/components/BrandHeading.astro';
import FrameworkHeading from '@/components/FrameworkHeading.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import {
  CAMPAIGN_HEADER_DEFAULTS,
  getCampaignIdentityStyle,
  getCampaignThemeToggleStyle,
  type CampaignHeaderConfiguration,
} from '@/lib/campaign-header-config';

interface Props {
  identityId: string;
  themeToggleId: string;
  showOpdaLink?: boolean;
  headingHref?: string;
  configuration?: CampaignHeaderConfiguration;
}

const {
  identityId,
  themeToggleId,
  showOpdaLink = false,
  headingHref,
  configuration = CAMPAIGN_HEADER_DEFAULTS,
} = Astro.props;
const identityStyle = getCampaignIdentityStyle(configuration);
const themeToggleStyle = getCampaignThemeToggleStyle(configuration);
---
<header class="wg-campaign-hero__header">
  <div class="wg-campaign-identity" id={identityId} style={identityStyle}>
    <div class="wg-campaign-identity__opda-row">
      <BrandHeading href={headingHref} />
    </div>
    <span id={themeToggleId} class="wg-campaign-identity__theme-controls" style={themeToggleStyle}>
      {showOpdaLink && (
        <a class="wg-campaign-identity__opda-link" href="/" aria-label="Home" title="Home">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
        </a>
      )}
      <ThemeToggle id={`${themeToggleId}-button`} />
    </span>
    <FrameworkHeading scale="display" href={headingHref} />
    <div class="wg-campaign-identity__configuration"><slot name="controls" /></div>
  </div>
</header>
