---
import BrandHeading from '@/components/BrandHeading.astro';
import FrameworkHeading from '@/components/FrameworkHeading.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import {
  campaignIdentityStyle,
  campaignThemeToggleStyle,
} from '@/lib/campaign-header-config';

interface Props {
  identityId: string;
  themeToggleId: string;
  showOpdaLink?: boolean;
}

const { identityId, themeToggleId, showOpdaLink = false } = Astro.props;
---
<header class="wg-campaign-hero__header">
  <div class="wg-campaign-identity" id={identityId} style={campaignIdentityStyle}>
    <div class="wg-campaign-identity__opda-row">
      <BrandHeading variant="paired" />
      <span id={themeToggleId} class="wg-campaign-identity__theme-controls" style={campaignThemeToggleStyle}>
        {showOpdaLink && <a class="wg-campaign-identity__opda-link" href="/">OPDA</a>}
        <ThemeToggle id={`${themeToggleId}-button`} />
      </span>
    </div>
    <FrameworkHeading scale="display" />
  </div>
</header>
