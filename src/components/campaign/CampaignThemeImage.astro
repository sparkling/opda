---
import { responsiveArtwork, ARTWORK_SIZES } from '@/lib/responsive-artwork.mjs';
interface Props {
  lightSrc: string;
  darkSrc?: string;
  alt?: string;
  className?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
}

const {
  lightSrc,
  darkSrc,
  alt = '',
  className,
  loading = 'lazy',
  fetchpriority,
  width,
  height,
} = Astro.props;
const lightSrcset = await responsiveArtwork(lightSrc, { enabled: import.meta.env.PROD });
const darkSrcset = await responsiveArtwork(darkSrc, { enabled: import.meta.env.PROD });
const imageSizes = loading === 'lazy' ? `auto, ${ARTWORK_SIZES}` : ARTWORK_SIZES;
---

<img
  class={className}
  src={darkSrc ? undefined : lightSrc}
  srcset={darkSrc ? undefined : lightSrcset}
  sizes={imageSizes}
  data-campaign-srcset-light={darkSrc ? lightSrcset : undefined}
  data-campaign-srcset-dark={darkSrcset}
  data-campaign-image-light={darkSrc ? lightSrc : undefined}
  data-campaign-image-dark={darkSrc}
  alt={alt}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  width={width}
  height={height}
  style={width && height ? `aspect-ratio: ${width} / ${height}` : undefined}
/>

{darkSrc && <>
  {/* Select before deferred modules run. An unconditional light src starts an
      unnecessary download on dark pages, even when it is replaced immediately. */}
  <script is:inline data-astro-rerun data-campaign-image-bootstrap>
    (() => {
      const image = document.currentScript?.previousElementSibling;
      if (!image?.matches('img[data-campaign-image-dark]')) return;
      const source = document.documentElement.dataset.theme === 'dark'
        ? image.dataset.campaignImageDark : image.dataset.campaignImageLight;
      const srcset = document.documentElement.dataset.theme === 'dark'
        ? image.dataset.campaignSrcsetDark : image.dataset.campaignSrcsetLight;
      if (srcset) image.setAttribute('srcset', srcset);
      if (source && image.getAttribute('src') !== source) image.setAttribute('src', source);
    })();
  </script>
  <noscript>
    <style is:inline>img[data-campaign-image-dark] { display: none; }</style>
    <img class={className} src={lightSrc} srcset={lightSrcset} sizes={imageSizes} alt={alt} loading={loading} fetchpriority={fetchpriority}
      decoding="async" width={width} height={height}
      style={width && height ? `aspect-ratio: ${width} / ${height}` : undefined} />
  </noscript>
</>}

<script>
  const selectCampaignImages = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    document.querySelectorAll<HTMLImageElement>('img[data-campaign-image-dark]').forEach((image) => {
      const source = dark ? image.dataset.campaignImageDark : image.dataset.campaignImageLight;
      const srcset = dark ? image.dataset.campaignSrcsetDark : image.dataset.campaignSrcsetLight;
      if (srcset && image.getAttribute('srcset') !== srcset) image.srcset = srcset;
      if (source && image.getAttribute('src') !== source) image.src = source;
    });
  };

  new MutationObserver(selectCampaignImages).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  document.addEventListener('astro:page-load', selectCampaignImages);
  selectCampaignImages();
</script>
