---
interface Props {
  lightSrc: string;
  darkSrc?: string;
  alt?: string;
  className?: string;
  loading?: 'eager' | 'lazy';
  width?: number;
  height?: number;
}

const {
  lightSrc,
  darkSrc,
  alt = '',
  className,
  loading = 'lazy',
  width,
  height,
} = Astro.props;
---

<img
  class={className}
  src={lightSrc}
  data-campaign-image-light={darkSrc ? lightSrc : undefined}
  data-campaign-image-dark={darkSrc}
  alt={alt}
  loading={loading}
  decoding="async"
  width={width}
  height={height}
/>

<script>
  const selectCampaignImages = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    document.querySelectorAll<HTMLImageElement>('img[data-campaign-image-dark]').forEach((image) => {
      const source = dark ? image.dataset.campaignImageDark : image.dataset.campaignImageLight;
      if (source && image.getAttribute('src') !== source) image.src = source;
    });
  };

  new MutationObserver(selectCampaignImages).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  document.addEventListener('astro:page-load', selectCampaignImages);
  selectCampaignImages();
</script>
