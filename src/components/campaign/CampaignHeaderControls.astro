---
import HeaderPreviewControls from '@/components/HeaderPreviewControls.astro';
import { CAMPAIGN_HEADER_DEFAULTS } from '@/lib/campaign-header-config';

interface Props {
  controlId: string;
  identityId: string;
  positionTargetId: string;
  themeToggleTargetId: string;
}

const { controlId, identityId, positionTargetId, themeToggleTargetId } = Astro.props;
---
<HeaderPreviewControls
  showScaleControl
  {controlId}
  {identityId}
  {positionTargetId}
  {themeToggleTargetId}
  initialScale={CAMPAIGN_HEADER_DEFAULTS.scale}
  initialOpdaScale={CAMPAIGN_HEADER_DEFAULTS.opdaScale}
  initialSpaceAbove={CAMPAIGN_HEADER_DEFAULTS.spaceAbove}
  initialLineGap={CAMPAIGN_HEADER_DEFAULTS.lineGap}
  initialSpaceBelow={CAMPAIGN_HEADER_DEFAULTS.spaceBelow}
  initialPositionX={CAMPAIGN_HEADER_DEFAULTS.panelPositionX}
  initialPositionY={CAMPAIGN_HEADER_DEFAULTS.panelPositionY}
  initialPanelWidth={CAMPAIGN_HEADER_DEFAULTS.panelWidth}
  initialThemeTogglePosition={CAMPAIGN_HEADER_DEFAULTS.themeTogglePositionY}
  initialIcon={CAMPAIGN_HEADER_DEFAULTS.icon}
  initialPalette={CAMPAIGN_HEADER_DEFAULTS.palette}
/>
