---
import type { WorkingGroupContext } from '@/data/working-group-campaign';

interface Props {
  contexts: WorkingGroupContext[];
}

const { contexts } = Astro.props;
---
<div class="constellation" data-context-constellation>
  <div class="constellation__stage" aria-hidden="true">
    <svg class="constellation__connections" viewBox="0 0 1000 650" role="presentation">
      <defs>
        <marker id="constellation-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>
      <g class="constellation__shared-lines">
        <path d="M500 325 L190 130" />
        <path d="M500 325 L500 90" />
        <path d="M500 325 L810 130" />
        <path d="M500 325 L190 520" />
        <path d="M500 325 L500 560" />
        <path d="M500 325 L810 520" />
      </g>
    </svg>
    <div class="constellation__common">
      <span>Common boundary</span>
      <strong>Shared identifiers and provenance</strong>
      <small>Only where meaning is genuinely common</small>
    </div>
    {contexts.map((context, index) => (
      <span class={`constellation__orbit constellation__orbit--${index + 1}`}>
        <small>{context.label}</small>
        <strong>{context.localTerm}</strong>
      </span>
    ))}
  </div>

  <div class="constellation__controls" role="list" aria-label="Property-domain perspectives">
    {contexts.map((context, index) => (
      <button
        type="button"
        role="listitem"
        class="constellation__trigger"
        aria-pressed={index === 0 ? 'true' : 'false'}
        aria-controls={`context-panel-${context.value}`}
        data-context-trigger={context.value}
      >
        <span>{String(index + 1).padStart(2, '0')}</span>
        {context.label}
      </button>
    ))}
  </div>

  <div class="constellation__panels" aria-live="polite">
    {contexts.map((context) => (
      <article
        id={`context-panel-${context.value}`}
        class="constellation__panel"
        data-context-panel={context.value}
      >
        <div>
          <p class="wg-eyebrow">{context.label} lens</p>
          <h3>{context.localTerm}</h3>
          <p class="constellation__definition">{context.definition}</p>
        </div>
        <div>
          <h4>{context.heading}</h4>
          <p>{context.explanation}</p>
          <p class="constellation__scope"><strong>Working-group scope:</strong> {context.scope}</p>
          <a class="constellation__choose" href="#register" data-context-register={context.value}>
            Add {context.label} to my registration
          </a>
        </div>
      </article>
    ))}
  </div>

  <aside class="constellation__mapping" aria-labelledby="mapping-example-title">
    <div>
      <p class="wg-eyebrow">Illustrative comparison · not an approved SPDTF mapping</p>
      <h3 id="mapping-example-title">Mappings connect concepts—not working groups</h3>
      <p>
        The common boundary does not route every relationship. When two contextual concepts need
        comparison, a separately reviewed SKOS mapping can record that relationship.
      </p>
    </div>
    <div class="constellation__mapping-example" aria-label="Illustrative, non-authoritative concept comparison">
      <span>Listing</span>
      <span class="constellation__predicate"><code>skos:closeMatch?</code><br />candidate only</span>
      <span>Mortgage security</span>
    </div>
  </aside>
  <p class="constellation__status" data-context-status aria-live="polite"></p>
</div>
