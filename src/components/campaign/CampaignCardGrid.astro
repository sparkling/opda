---
import type { CampaignCard } from '@/data/working-group-campaign';

interface Props {
  cards: CampaignCard[];
  columns?: 3 | 4;
  ordered?: boolean;
  label?: string;
}

const { cards, columns = 4, ordered = false, label } = Astro.props;
const Container = ordered ? 'ol' : 'div';
const Item = ordered ? 'li' : 'article';
---

<Container class="campaign-card-grid" style={`--campaign-card-columns: ${columns}`} aria-label={label}>
  {cards.map((card) => (
    <Item class:list={['campaign-card', { 'campaign-card--linked': Boolean(card.href) }]}>
      {card.eyebrow && <p class="campaign-card__eyebrow">{card.eyebrow}</p>}
      <h3>{card.title}</h3>
      {card.image && (
        <img
          class="campaign-card__image"
          src={card.image}
          data-campaign-image-light={card.darkImage ? card.image : undefined}
          data-campaign-image-dark={card.darkImage}
          alt=""
          width="1200"
          height="300"
          loading="lazy"
          decoding="async"
        />
      )}
      {(card.paragraphs ?? (card.description ? [card.description] : [])).map((paragraph) => (
        <p class="campaign-card__description">{paragraph}</p>
      ))}
      {card.href && (
        <a class="campaign-card__link" href={card.href} data-context-register={card.registerContext}>
          <span class="visually-hidden">Register interest in {card.title}</span>
        </a>
      )}
    </Item>
  ))}
</Container>

<script>
  // Follow the site's selected mode, including manual overrides of the OS theme.
  // One observer serves every card grid; it never retains detached page elements.
  const selectCampaignImages = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    document.querySelectorAll<HTMLImageElement>('img[data-campaign-image-dark]').forEach((image) => {
      const source = dark ? image.dataset.campaignImageDark : image.dataset.campaignImageLight;
      if (source && image.getAttribute('src') !== source) image.src = source;
    });
  };

  new MutationObserver(selectCampaignImages).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  document.addEventListener('astro:page-load', selectCampaignImages);
  selectCampaignImages();
</script>

<style>
  .campaign-card-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(var(--campaign-card-columns), minmax(0, 1fr));
    gap: var(--space-4);
    margin: clamp(var(--space-8), 4vw, var(--space-10)) 0 0;
    padding: 0;
    list-style: none;
  }

  .campaign-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--brand-yellow);
  }

  .campaign-card__eyebrow {
    margin: 0;
    color: var(--campaign-section-accent);
    font: 700 var(--text-xs) / 1.3 var(--font-sans);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .campaign-card h3 { margin: 0; color: var(--color-text-strong); font: var(--h3); }
  .campaign-card__description { margin: 0; color: var(--color-text-muted); line-height: 1.6; text-align: start; hyphens: none; }
  .campaign-card--linked h3 { font-size: 1.5rem; line-height: 1.3; }
  .campaign-card--linked .campaign-card__description { text-align: justify; text-align-last: start; hyphens: auto; }

  .campaign-card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 1;
    object-fit: cover;
    object-position: 50% 65%;
    margin: 0;
  }

  .campaign-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .campaign-card__link:focus-visible { outline-offset: -4px; }
  .campaign-card:has(a):hover,
  .campaign-card:focus-within { border-color: var(--color-link); }

  @media (max-width: 72rem) {
    .campaign-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 48rem) {
    .campaign-card-grid { grid-template-columns: 1fr; }
  }
  @media (forced-colors: active) {
    .campaign-card { background: Canvas; border-color: CanvasText; }
    .campaign-card :is(h3, p) { color: CanvasText; }
  }
</style>
