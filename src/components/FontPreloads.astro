---
/** Discover only the Latin faces needed by the page's initial viewport. */
interface Props { display?: boolean; reading?: boolean; }
const { display = false, reading = true } = Astro.props;
---
<link rel="preload" href="/ui/fonts/SourceSans3-Variable-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
{reading && <link rel="preload" href="/ui/fonts/AtkinsonHyperlegibleNext-Variable-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />}
{display && <link rel="preload" href="/ui/fonts/RobotoSlab-Variable-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />}
