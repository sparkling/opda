---
/** Discover interface and paragraph faces before the blocking CSS response. */
interface Props { display?: boolean; }
const { display = false } = Astro.props;
---
<link rel="preload" href="/ui/fonts/SourceSans3-Variable-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/ui/fonts/AtkinsonHyperlegibleNext-Variable-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
{display && <link rel="preload" href="/ui/fonts/RobotoSlab-Variable-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />}
