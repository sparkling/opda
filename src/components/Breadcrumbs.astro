---
/**
 * Breadcrumbs — global owner → Section → Group → Page chain. The existing
 * section/group/page chain remains the stable local navigation contract; the
 * global owner adds context only when it has a different label.
 */
import { findPage, normalizeUrl } from '@/lib/site';
import { getActiveDestination, getDestination } from '@/lib/site-ia.mjs';

const path = normalizeUrl(Astro.url.pathname);
const found = findPage(path);
const isSectionRoot = found && !found.item;
const destination = getDestination(getActiveDestination(path));
const showGlobalOwner = Boolean(destination && (!found || destination.title !== found.section.title));
---
{(found || destination) && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    {showGlobalOwner && destination && <a href={destination.url}>{destination.title}</a>}
    {showGlobalOwner && found && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
    {found && <a href={`/${found.section.key}`}>{found.section.title}</a>}
    {found && !isSectionRoot && found.group && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
    {found && !isSectionRoot && found.group && <span class="breadcrumb-group">{found.group.heading}</span>}
    {found && !isSectionRoot && found.item && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
    {found && !isSectionRoot && found.item && <span class="breadcrumb-current" aria-current="page">{found.item.title}</span>}
  </nav>
)}
