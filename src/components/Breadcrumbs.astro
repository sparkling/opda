---
/**
 * Breadcrumbs — navigable ancestors below the global destination. The
 * horizontal navigation already names that destination, while the H1 names
 * the current page, so neither is repeated in this trail.
 */
import { normalizeUrl } from '@/lib/site';
import { findNavigationPage } from '@/lib/site-navigation';
import { getActiveDestination, getDestination } from '@/lib/site-ia.mjs';

interface Breadcrumb {
  label: string;
  href?: string;
  current?: boolean;
}
interface Props {
  currentPageTitle: string;
}

const { currentPageTitle } = Astro.props;

const path = normalizeUrl(Astro.url.pathname);
const found = findNavigationPage(path);
const destination = getDestination(getActiveDestination(path));
const destinationLanding = Boolean(destination && path === normalizeUrl(destination.url));

const breadcrumbs: Breadcrumb[] = [];

if (!destinationLanding) {
  if (found) {
    const groupPath = normalizeUrl(found.group.url);
    const groupIsDestination = groupPath === normalizeUrl(destination?.url ?? '');
    const groupIsCurrent = groupPath === path;
    const overviewParentsDestinationChildren = groupIsDestination
      && found.group.heading === 'Overview'
      && found.trail.length > 0;
    if (!groupIsDestination || overviewParentsDestinationChildren) {
      breadcrumbs.push(groupIsCurrent
        ? { label: found.group.heading, current: true }
        : { label: found.group.heading, href: found.group.url });
    }
    found.trail.forEach((item, index) => {
      const exact = normalizeUrl(item.url) === path;
      const last = index === found.trail.length - 1;
      breadcrumbs.push(exact
        ? { label: item.title, current: true }
        : { label: item.title, href: item.url });
      if (last && !exact) breadcrumbs.push({ label: currentPageTitle, current: true });
    });
    if (!found.trail.length && !groupIsCurrent) {
      breadcrumbs.push({ label: currentPageTitle, current: true });
    }
  } else {
    breadcrumbs.push({ label: currentPageTitle, current: true });
  }
}

// The H1 names the current page. Breadcrumbs retain only navigable ancestors
// below the global destination, avoiding both repeated shell context and a
// duplicate, non-actionable terminal item immediately above the title.
const ancestors = breadcrumbs.slice(0, -1).filter(
  (breadcrumb): breadcrumb is Breadcrumb & { href: string } => Boolean(breadcrumb.href),
);
---
{ancestors.length > 0 && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list">
      {ancestors.map((breadcrumb, index) => (
        <li>
          {index > 0 && (
            <svg class="breadcrumb-sep" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
              <path d="m7 4 6 6-6 6"></path>
            </svg>
          )}
          <a href={breadcrumb.href}>{breadcrumb.label}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
