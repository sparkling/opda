---
import { createPageMetadata, serialiseStructuredData, SITE_NAME } from '@/lib/page-seo.mjs';

interface Props {
  title: string;
  description?: string;
  contentHtml?: string;
  socialImage?: string;
  breadcrumbs?: { name: string; url: string }[];
  robots?: string;
  canonical?: string | null;
}

const metadata = createPageMetadata({ ...Astro.props, url: Astro.url, site: Astro.site });
---
<title>{metadata.title}</title>
<meta name="description" content={metadata.description} />
{metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
{metadata.robots && <meta name="robots" content={metadata.robots} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={metadata.title} />
<meta property="og:description" content={metadata.description} />
{metadata.canonical && <meta property="og:url" content={metadata.canonical} />}
{metadata.image && <meta property="og:image" content={metadata.image} />}
{metadata.imageAlt && <meta property="og:image:alt" content={metadata.imageAlt} />}
<meta name="twitter:card" content={metadata.image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={metadata.title} />
<meta name="twitter:description" content={metadata.description} />
{metadata.image && <meta name="twitter:image" content={metadata.image} />}
{metadata.imageAlt && <meta name="twitter:image:alt" content={metadata.imageAlt} />}
{metadata.structuredData.map((data) => <script is:inline type="application/ld+json" set:html={serialiseStructuredData(data)} />)}
