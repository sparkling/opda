---
/**
 * Recursive sidebar item — renders either a leaf link or a linked folder.
 * Folders containing the active page render open; navigating to another
 * folder reveals that branch without a separate disclosure control.
 */
import type { Item } from '@/lib/site';
import { normalizeUrl } from '@/lib/site';
import { PDTF1_ROUTES } from '@/lib/pdtf1-routes.mjs';
// eslint-disable-next-line @typescript-eslint/no-unused-vars
import Self from './SidebarItem.astro';

interface Props {
  item: Item;
  activePath: string;
  currentPath: string;
  containsActive: (item: Item) => boolean;
}

const { item, activePath, currentPath, containsActive } = Astro.props;
const isLeaf = !item.children;
const itemPath = normalizeUrl(item.url);
const isActive = itemPath === activePath;
const isCurrentPage = isActive && itemPath === currentPath;
const isOpen = !isLeaf && containsActive(item);
const namedPdtfGroupId = new Map<string, string>([
  [`${PDTF1_ROUTES.original}/schema`, 'section-nav-group-pdtf-schema-schema'],
  [`${PDTF1_ROUTES.original}/implementation`, 'section-nav-group-pdtf-schema-implementation'],
  [`${PDTF1_ROUTES.original}/adoption`, 'section-nav-group-pdtf-schema-usage'],
  [PDTF1_ROUTES.historicalModelling, 'section-nav-group-pdtf-schema-modelling'],
  [PDTF1_ROUTES.modelViews, 'section-nav-group-pdtf-schema-model'],
  [PDTF1_ROUTES.schemaVerification, 'section-nav-group-pdtf-schema-mapping'],
]).get(itemPath);
const childrenId = namedPdtfGroupId
  ?? `section-nav-${itemPath.replace(/[^a-z0-9]+/giu, '-').replace(/^-|-$/gu, '')}`;
---
{isLeaf ? (
  <li class="tree-leaf">
    <a
      href={item.url}
      class={isActive ? 'active' : undefined}
      aria-current={isCurrentPage ? 'page' : undefined}
    >{item.title}</a>
  </li>
) : (
  <li class={`tree-folder${isOpen ? ' is-open' : ''}${isActive ? ' is-active-page' : ''}`}>
    <div class="tree-folder-row">
      <a
        href={item.url}
        class={`tree-folder-link${isActive ? ' active' : ''}`}
        aria-current={isCurrentPage ? 'page' : undefined}
      >{item.title}</a>
    </div>
    <ul class="tree-children" id={childrenId}>
      {item.children?.map(child => (
        <Self item={child} activePath={activePath} currentPath={currentPath} containsActive={containsActive} />
      ))}
    </ul>
  </li>
)}
