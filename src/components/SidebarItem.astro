---
/**
 * Recursive sidebar item — renders either a leaf <a> or a folder with
 * collapsible children. Folders default to open if they contain the
 * active page (computed by containsActive prop).
 */
import type { Item } from '@/lib/site';
import { normalizeUrl } from '@/lib/site';
// eslint-disable-next-line @typescript-eslint/no-unused-vars
import Self from './SidebarItem.astro';

interface Props {
  item: Item;
  activePath: string;
  containsActive: (item: Item) => boolean;
}

const { item, activePath, containsActive } = Astro.props;
const isLeaf = !item.children;
const itemPath = normalizeUrl(item.url);
const isActive = itemPath === activePath;
const isOpen = !isLeaf && containsActive(item);
const legacyPdtfGroupId = new Map([
  '/schema', '/implementation', '/adoption', '/modelling', '/model', '/mapping',
].map((url) => [url, `section-nav-group-pdtf-1-${url.slice(1)}`])).get(itemPath);
const childrenId = legacyPdtfGroupId
  ?? `section-nav-${itemPath.replace(/[^a-z0-9]+/giu, '-').replace(/^-|-$/gu, '')}`;
---
{isLeaf ? (
  <li class="tree-leaf">
    <a
      href={item.url}
      class={isActive ? 'active' : undefined}
      aria-current={isActive ? 'page' : undefined}
    >{item.title}</a>
  </li>
) : (
  <li class={`tree-folder${isOpen ? ' is-open' : ''}${isActive ? ' is-active-page' : ''}`}>
    <div class="tree-folder-row">
      <button
        type="button"
        class="tree-toggle"
        aria-expanded={isOpen ? 'true' : 'false'}
        aria-controls={childrenId}
        aria-label={`${isOpen ? 'Collapse' : 'Expand'} ${item.title}`}
        data-label={item.title}
      >
        <svg class="tree-caret" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.25" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
      <a
        href={item.url}
        class={`tree-folder-link${isActive ? ' active' : ''}`}
        aria-current={isActive ? 'page' : undefined}
      >{item.title}</a>
    </div>
    <ul class="tree-children" id={childrenId}>
      {item.children?.map(child => (
        <Self item={child} activePath={activePath} containsActive={containsActive} />
      ))}
    </ul>
  </li>
)}
