---
/**
 * Progressively enhanced quick search.
 *
 * The trigger remains an ordinary /search link until this controller is bound.
 * The rich /search route remains the canonical, no-JavaScript search interface.
 * Both surfaces rank through the same shared index and describe results with
 * the same vocabulary (site-search.mjs); this dialog only shows fewer fields.
 */
---
<dialog id="site-search-dialog" class="site-search-dialog" aria-label="Search documentation" data-site-search-dialog>
  <div class="site-search-dialog__shell">
    <form class="site-search-dialog__form" action="/search" method="get" role="search" data-site-search-dialog-form>
      <label class="visually-hidden" for="site-search-dialog-input">Search documentation</label>
      <input
        id="site-search-dialog-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Search documentation"
        aria-describedby="site-search-dialog-status"
        aria-controls="site-search-dialog-results"
        aria-autocomplete="list"
        aria-expanded="false"
        role="combobox"
        data-site-search-input
      />
      <p id="site-search-dialog-status" class="visually-hidden" aria-live="polite" aria-atomic="true" data-site-search-status>Start typing to search.</p>
    </form>

    <div class="site-search-dialog__result-region">
      <ol id="site-search-dialog-results" class="site-search-dialog__results" role="listbox" aria-label="Search results" data-site-search-results></ol>
      <p class="site-search-dialog__empty" hidden data-site-search-empty>No page matches this search.</p>
    </div>

    <footer class="site-search-dialog__footer">
      <a href="/search" data-site-search-full>Open full search</a>
    </footer>
  </div>
</dialog>

<script>
  type SearchRecord = {
    title: string;
    url: string;
    type: string;
  };

  type SearchDependencies = {
    searchSite: (query: string) => Promise<SearchRecord[]>;
    describeRecord: (record: SearchRecord) => { eyebrow: string };
  };

  const QUICK_LIMIT = 12;

  const editable = (target: EventTarget | null) => target instanceof HTMLElement
    && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/u.test(target.tagName));

  const pluralise = (count: number) => `${count.toLocaleString('en-GB')} ${count === 1 ? 'result' : 'results'}`;

  function initialiseSiteSearchDialog() {
    const dialog = document.querySelector('[data-site-search-dialog]');
    const triggers = Array.from(document.querySelectorAll('[data-site-search-trigger]'));
    if (!(dialog instanceof HTMLDialogElement) || !triggers.length) return;
    if (dialog.dataset.searchDialogBound === 'true') return;

    const form = dialog.querySelector('[data-site-search-dialog-form]');
    const input = dialog.querySelector('[data-site-search-input]');
    const results = dialog.querySelector('[data-site-search-results]');
    const status = dialog.querySelector('[data-site-search-status]');
    const empty = dialog.querySelector('[data-site-search-empty]');
    const fullSearch = dialog.querySelector('[data-site-search-full]');
    if (!(form instanceof HTMLFormElement)
      || !(input instanceof HTMLInputElement)
      || !(results instanceof HTMLOListElement)
      || !(status instanceof HTMLElement)
      || !(empty instanceof HTMLElement)
      || !(fullSearch instanceof HTMLAnchorElement)) return;

    let dependencies: Promise<SearchDependencies> | undefined;
    let matches: SearchRecord[] = [];
    let activeIndex = -1;
    let returnFocus: HTMLElement | null = null;

    function loadDependencies() {
      dependencies ??= import('@/lib/site-search.mjs').then((search) => ({
        searchSite: search.searchSite,
        describeRecord: search.describeRecord,
      }));
      return dependencies;
    }

    function searchUrl(query: string) {
      const url = new URL('/search', window.location.origin);
      if (query) url.searchParams.set('q', query);
      return `${url.pathname}${url.search}`;
    }

    function updateFullSearchLink(total = 0) {
      fullSearch.href = searchUrl(input.value.trim());
      fullSearch.textContent = total > QUICK_LIMIT ? `See all ${pluralise(total)}` : 'Open full search';
    }

    function setActive(index: number) {
      activeIndex = index < 0 || index >= matches.length ? -1 : index;
      const options = Array.from(results.querySelectorAll<HTMLElement>('[role="option"]'));
      options.forEach((option, optionIndex) => {
        const selected = optionIndex === activeIndex;
        option.setAttribute('aria-selected', String(selected));
        option.toggleAttribute('data-active', selected);
      });
      if (activeIndex >= 0) {
        const activeOption = options[activeIndex];
        input.setAttribute('aria-activedescendant', activeOption.id);
        activeOption.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    function clearResults(message: string) {
      matches = [];
      activeIndex = -1;
      results.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      empty.hidden = true;
      status.textContent = message;
    }

    function render(deps: SearchDependencies, ranked: SearchRecord[]) {
      matches = ranked.slice(0, QUICK_LIMIT);
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');
      results.replaceChildren();
      const fragment = document.createDocumentFragment();
      matches.forEach((record, index) => {
        const item = document.createElement('li');
        item.id = `site-search-dialog-result-${index}`;
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', 'false');

        const link = document.createElement('a');
        link.href = record.url;
        link.className = 'site-search-dialog__result';
        link.tabIndex = -1;
        const category = document.createElement('span');
        category.className = 'site-search-dialog__result-category';
        category.textContent = deps.describeRecord(record).eyebrow;
        const title = document.createElement('strong');
        title.textContent = record.title;
        link.append(category, title);
        item.append(link);
        fragment.append(item);
      });
      results.append(fragment);
      input.setAttribute('aria-expanded', String(matches.length > 0));
      empty.hidden = ranked.length !== 0;
      updateFullSearchLink(ranked.length);
      status.textContent = ranked.length
        ? `${pluralise(ranked.length)} available${ranked.length > QUICK_LIMIT ? `; showing the first ${QUICK_LIMIT}` : ''}.`
        : 'No page matches this search.';
    }

    async function search() {
      const query = input.value.trim();
      updateFullSearchLink();
      if (!query) {
        clearResults('Start typing to search.');
        return;
      }
      status.textContent = 'Searching documentation…';
      try {
        const deps = await loadDependencies();
        if (!dialog.open || input.value.trim() !== query) return;
        render(deps, await deps.searchSite(query));
      } catch {
        clearResults("Search couldn't load. Use complete search instead.");
      }
    }

    function open(trigger?: HTMLElement) {
      returnFocus = trigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
      if (!dialog.open) dialog.showModal();
      input.focus();
      void search();
    }

    function followActive(event?: KeyboardEvent) {
      const match = matches[activeIndex];
      if (!match) return false;
      const openInNewTab = event?.metaKey || event?.ctrlKey;
      if (openInNewTab) window.open(match.url, '_blank', 'noopener');
      else window.location.assign(match.url);
      return true;
    }

    triggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLElement)) return;
      trigger.setAttribute('aria-haspopup', 'dialog');
      trigger.setAttribute('aria-controls', dialog.id);
      trigger.addEventListener('pointerenter', () => { void loadDependencies(); }, { once: true });
      trigger.addEventListener('focus', () => { void loadDependencies(); }, { once: true });
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open(trigger);
      });
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => returnFocus?.focus());
    results.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) dialog.close();
    });
    form.addEventListener('submit', (event) => {
      if (followActive()) {
        event.preventDefault();
        dialog.close();
      }
    });
    input.addEventListener('input', () => { void search(); });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'Enter' && followActive(event)) {
        event.preventDefault();
        dialog.close();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (dialog.open || editable(event.target)) return;
      if (event.key === '/' || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
        event.preventDefault();
        if (window.location.pathname === '/search') {
          const pageSearch = document.querySelector('#site-search');
          if (pageSearch instanceof HTMLInputElement) {
            pageSearch.focus();
            return;
          }
        }
        open();
      }
    });
    dialog.dataset.searchDialogBound = 'true';
  }

  document.addEventListener('astro:page-load', initialiseSiteSearchDialog);
  initialiseSiteSearchDialog();
</script>
