---
/**
 * Progressively enhanced quick search.
 *
 * The trigger remains an ordinary /search link until this controller is bound.
 * The rich /search route remains the canonical, no-JavaScript search interface.
 */
---
<dialog class="site-search-dialog" aria-labelledby="site-search-dialog-title" data-site-search-dialog>
  <div class="site-search-dialog__shell">
    <header class="site-search-dialog__header">
      <div>
        <p class="site-search-dialog__eyebrow">Documentation search</p>
        <h2 id="site-search-dialog-title">Search the documentation</h2>
      </div>
      <button type="button" class="site-search-dialog__close" aria-label="Close search" data-site-search-close>Cancel</button>
    </header>

    <form class="site-search-dialog__form" action="/search" method="get" role="search" data-site-search-dialog-form>
      <label for="site-search-dialog-input">Search by task, topic or name</label>
      <input
        id="site-search-dialog-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Try governance, mapping or working groups"
        aria-describedby="site-search-dialog-help site-search-dialog-status"
        aria-controls="site-search-dialog-results"
        aria-expanded="false"
        role="combobox"
        data-site-search-input
      />
      <p id="site-search-dialog-help" class="site-search-dialog__help">Use one or more words. Results match titles, summaries and alternative terms.</p>
      <p id="site-search-dialog-status" class="site-search-dialog__status" aria-live="polite" aria-atomic="true" data-site-search-status>Start typing to search.</p>
    </form>

    <ol id="site-search-dialog-results" class="site-search-dialog__results" role="listbox" aria-label="Search results" data-site-search-results></ol>
    <p class="site-search-dialog__empty" hidden data-site-search-empty>No indexed destination matches this search.</p>

    <footer class="site-search-dialog__footer">
      <a href="/search" data-site-search-full>Open complete search</a>
      <span class="site-search-dialog__keys" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> choose <kbd>↵</kbd> open <kbd>Esc</kbd> close</span>
    </footer>
  </div>
</dialog>

<script>
  type SearchRecord = {
    title: string;
    url: string;
    facet: string;
    destination: string;
  };

  type SearchDependencies = {
    searchEntries: (query: string) => SearchRecord[];
    GLOBAL_DESTINATIONS: Array<{ key: string; title: string }>;
    getRouteStatus: (url: string) => { workArea: string; authority: string; maturity: string };
  };

  const editable = (target: EventTarget | null) => target instanceof HTMLElement
    && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/u.test(target.tagName));

  const pluralise = (count: number) => `${count} ${count === 1 ? 'result' : 'results'}`;

  function initialiseSiteSearchDialog() {
    const dialog = document.querySelector('[data-site-search-dialog]');
    const triggers = Array.from(document.querySelectorAll('[data-site-search-trigger]'));
    if (!(dialog instanceof HTMLDialogElement) || !triggers.length) return;
    if (dialog.dataset.searchDialogBound === 'true') return;

    const form = dialog.querySelector('[data-site-search-dialog-form]');
    const input = dialog.querySelector('[data-site-search-input]');
    const results = dialog.querySelector('[data-site-search-results]');
    const status = dialog.querySelector('[data-site-search-status]');
    const empty = dialog.querySelector('[data-site-search-empty]');
    const fullSearch = dialog.querySelector('[data-site-search-full]');
    const close = dialog.querySelector('[data-site-search-close]');
    if (!(form instanceof HTMLFormElement)
      || !(input instanceof HTMLInputElement)
      || !(results instanceof HTMLOListElement)
      || !(status instanceof HTMLElement)
      || !(empty instanceof HTMLElement)
      || !(fullSearch instanceof HTMLAnchorElement)
      || !(close instanceof HTMLButtonElement)) return;

    let dependencies: Promise<SearchDependencies> | undefined;
    let matches: SearchRecord[] = [];
    let activeIndex = -1;
    let returnFocus: HTMLElement | null = null;

    function loadDependencies() {
      dependencies ??= Promise.all([
        import('@/lib/site-search.mjs'),
        import('@/lib/site-ia.mjs'),
      ]).then(([search, ia]) => ({
        searchEntries: search.searchEntries,
        GLOBAL_DESTINATIONS: ia.GLOBAL_DESTINATIONS,
        getRouteStatus: ia.getRouteStatus,
      }));
      return dependencies;
    }

    function searchUrl(query: string) {
      const url = new URL('/search', window.location.origin);
      if (query) url.searchParams.set('q', query);
      return `${url.pathname}${url.search}`;
    }

    function updateFullSearchLink() {
      fullSearch.href = searchUrl(input.value.trim());
    }

    function setActive(index: number) {
      activeIndex = index < 0 || index >= matches.length ? -1 : index;
      const options = Array.from(results.querySelectorAll<HTMLElement>('[role="option"]'));
      options.forEach((option, optionIndex) => {
        const selected = optionIndex === activeIndex;
        option.setAttribute('aria-selected', String(selected));
        option.toggleAttribute('data-active', selected);
      });
      if (activeIndex >= 0) {
        const activeOption = options[activeIndex];
        input.setAttribute('aria-activedescendant', activeOption.id);
        activeOption.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    function render(deps: SearchDependencies, ranked: SearchRecord[]) {
      matches = ranked;
      activeIndex = -1;
      results.replaceChildren();
      const destinations = new Map(deps.GLOBAL_DESTINATIONS.map(({ key, title }) => [key, title]));
      const fragment = document.createDocumentFragment();
      ranked.forEach((record, index) => {
        const item = document.createElement('li');
        item.id = `site-search-dialog-result-${index}`;
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', 'false');

        const link = document.createElement('a');
        link.href = record.url;
        link.className = 'site-search-dialog__result';
        const category = document.createElement('span');
        category.className = 'site-search-dialog__result-category';
        const destination = destinations.get(record.destination) ?? record.destination;
        category.textContent = record.facet === destination ? destination : `${destination} · ${record.facet}`;
        const title = document.createElement('strong');
        title.textContent = record.title;
        const metadata = document.createElement('span');
        metadata.className = 'site-search-dialog__result-metadata';
        const routeStatus = deps.getRouteStatus(record.url);
        metadata.textContent = `${routeStatus.workArea} · ${routeStatus.authority} · ${routeStatus.maturity}`;
        link.append(category, title, metadata);
        item.append(link);
        fragment.append(item);
      });
      results.append(fragment);
      input.setAttribute('aria-expanded', String(ranked.length > 0));
      empty.hidden = ranked.length !== 0;
      status.textContent = ranked.length ? `${pluralise(ranked.length)} available.` : 'No indexed destination matches this search.';
    }

    async function search() {
      const query = input.value.trim();
      updateFullSearchLink();
      if (!query) {
        matches = [];
        activeIndex = -1;
        results.replaceChildren();
        input.setAttribute('aria-expanded', 'false');
        empty.hidden = true;
        status.textContent = 'Start typing to search.';
        return;
      }
      status.textContent = 'Searching documentation…';
      try {
        const deps = await loadDependencies();
        if (!dialog.open) return;
        render(deps, deps.searchEntries(query));
      } catch {
        matches = [];
        results.replaceChildren();
        input.setAttribute('aria-expanded', 'false');
        empty.hidden = true;
        status.textContent = "Search couldn't load. Use complete search instead.";
      }
    }

    function open(trigger?: HTMLElement) {
      returnFocus = trigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
      if (!dialog.open) dialog.showModal();
      input.focus();
      void search();
    }

    function followActive(event?: KeyboardEvent) {
      const match = matches[activeIndex];
      if (!match) return false;
      const openInNewTab = event?.metaKey || event?.ctrlKey;
      if (openInNewTab) window.open(match.url, '_blank', 'noopener');
      else window.location.assign(match.url);
      return true;
    }

    triggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLElement)) return;
      trigger.addEventListener('pointerenter', () => { void loadDependencies(); }, { once: true });
      trigger.addEventListener('focus', () => { void loadDependencies(); }, { once: true });
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open(trigger);
      });
    });

    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => returnFocus?.focus());
    results.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) dialog.close();
    });
    form.addEventListener('submit', (event) => {
      if (followActive()) {
        event.preventDefault();
        dialog.close();
      }
    });
    input.addEventListener('input', () => { void search(); });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'Enter' && followActive(event)) {
        event.preventDefault();
        dialog.close();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (dialog.open || editable(event.target)) return;
      if (event.key === '/' || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
        event.preventDefault();
        if (window.location.pathname === '/search') {
          const pageSearch = document.querySelector('#site-search');
          if (pageSearch instanceof HTMLInputElement) {
            pageSearch.focus();
            return;
          }
        }
        open();
      }
    });
    dialog.dataset.searchDialogBound = 'true';
  }

  document.addEventListener('astro:page-load', initialiseSiteSearchDialog);
  initialiseSiteSearchDialog();
</script>
