---
import Layout from '@/layouts/Layout.astro';
import {
  candidateManifest,
  propertyPackLifecycleStatus,
  validationReport,
} from '@/lib/property-pack-model.mjs';
import '@/styles/property-pack.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  category?: string;
  /** Source-only hierarchy metadata; the shared breadcrumb renderer derives
   * the visible trail from the canonical site navigation. */
  crumbs?: Crumb[];
}

const {
  title,
  description,
} = Astro.props;
const technicalState = validationReport.status === 'pass'
  ? 'Technical candidate checks passed'
  : `Technical candidate checks: ${validationReport.status}`;
---
<Layout
  title={`${title} · Property Pack ontology · SPDTF`}
  breadcrumbTitle={title}
  description={description}
  proseClass="prose wide"
>
  <div class="v2-doc">
    <details class="v2-candidate-banner">
      <summary>
        <span class="pill pill--warn">Machine-proposed</span>
        <strong>{candidateManifest.candidate_version}</strong>
        <span>{candidateManifest.publication_status.replaceAll('-', ' ')}</span>
        <span class="v2-candidate-banner__label">Candidate status and evidence</span>
      </summary>
      <div class="v2-candidate-banner__content">
        <p>
          <strong>Property Pack ontology candidate · accelerated SPDTF component ·
          machine-generated · non-normative.</strong> The Technical Working Group
          determination is pending, later domain review has not occurred, and AI has no
          decision authority. This candidate is neither the whole SPDTF ontology nor
          an approved exchange contract.
        </p>
        <p>
          <strong>{technicalState}.</strong> This records machine checks, not semantic approval.
          <a href="/spdtf/property-pack/validation"> Review the evidence</a>.
        </p>
        <dl class="property-pack-status" aria-label="Property Pack lifecycle status">
          <div><dt>Source definition</dt><dd>{propertyPackLifecycleStatus.sourceDefinition}</dd></div>
          <div><dt>Ontology candidate</dt><dd>{propertyPackLifecycleStatus.ontologyCandidate}</dd></div>
          <div><dt>Technical determination</dt><dd>{propertyPackLifecycleStatus.technicalDetermination}</dd></div>
          <div><dt>Later domain review</dt><dd>{propertyPackLifecycleStatus.laterDomainReview}</dd></div>
          <div><dt>Implementation or release</dt><dd>{propertyPackLifecycleStatus.implementationRelease}</dd></div>
          <div><dt>External use or authority</dt><dd>{propertyPackLifecycleStatus.externalAuthority}</dd></div>
        </dl>
      </div>
    </details>

    <slot />
  </div>
  <slot name="scripts" slot="scripts" />
</Layout>
