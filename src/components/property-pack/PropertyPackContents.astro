---
interface Item {
  id: string;
  label: string;
  detail?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
<nav class="callout callout--note v2-contents" aria-label="On this page">
  <p class="callout__label">On this page</p>
  <ul>
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`}>{item.label}</a>
        {item.detail && <span> — {item.detail}</span>}
      </li>
    ))}
  </ul>
</nav>
