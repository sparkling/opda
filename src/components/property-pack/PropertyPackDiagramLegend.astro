---
interface Props {
  variant?: 'model' | 'boundary' | 'context' | 'work-package';
}
const { variant = 'model' } = Astro.props;
---
<div class="v2-diagram-legend" aria-label="Diagram legend">
  {variant === 'boundary' ? (
    <>
      <span><i class="v2-swatch v2-swatch--common"></i>Common boundary</span>
      <span><i class="v2-swatch v2-swatch--bounded"></i>Bounded context</span>
      <span><i class="v2-swatch v2-swatch--scheme"></i>Scheme context</span>
      <span><i class="v2-line v2-line--solid"></i>Shared elements supplied by the Common boundary</span>
    </>
  ) : variant === 'work-package' ? (
    <>
      <span><i class="v2-swatch v2-swatch--class"></i>Class reached by this work package</span>
      <span><i class="v2-swatch v2-swatch--cross-context"></i>One-hop attached class</span>
      <span><i class="v2-line v2-line--solid"></i>Object property within the work package</span>
      <span><i class="v2-line v2-line--dashed"></i>Incoming or outgoing object property</span>
    </>
  ) : variant === 'context' ? (
    <>
      <span><i class="v2-swatch v2-swatch--class"></i>Class in this semantic home</span>
      <span><i class="v2-swatch v2-swatch--cross-context"></i>Class owned by another semantic home</span>
      <span><i class="v2-line v2-line--solid"></i>Object-property relationship within this home</span>
      <span><i class="v2-line v2-line--dashed"></i>Cross-boundary relationship or subclass</span>
    </>
  ) : (
    <>
      <span><i class="v2-swatch v2-swatch--class"></i>Class</span>
      <span><i class="v2-line v2-line--solid"></i>Object property, labelled on the relationship</span>
      <span><i class="v2-line v2-line--dashed"></i>Subclass relationship</span>
    </>
  )}
</div>
