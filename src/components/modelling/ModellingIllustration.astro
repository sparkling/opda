---
import CampaignThemeImage from '../campaign/CampaignThemeImage.astro';

interface Props { kind: 'property-story' | 'modelling-workbench'; }
const { kind } = Astro.props;
const illustrations = {
  'property-story': {
    alt: 'Watercolour cutaway of a residential building with separate dwelling entrances, alongside inspection reports and a floor plan.',
    caption: 'A fictional property situation: the building, its dwellings and the reports about them need distinct descriptions.',
  },
  'modelling-workbench': {
    alt: 'Watercolour of practitioners examining building and dwelling studies, grouping vocabulary cards and comparing reports.',
    caption: 'Modelling makes professional distinctions explicit. The exact relationships and rules are explained in the examples below.',
  },
};
if (!Object.hasOwn(illustrations, kind)) throw new Error('Unknown modelling illustration');
const illustration = illustrations[kind];
const base = '/images/modelling/enrichment/' + kind;
---

<figure class="modelling-editorial">
  <CampaignThemeImage lightSrc={base + '-light.png'} darkSrc={base + '-dark.png'}
    alt={illustration.alt} width={2172} height={724} />
  <figcaption>{illustration.caption}</figcaption>
</figure>

<style>
  .modelling-editorial { margin: var(--space-6) 0; max-inline-size: 60rem; }
  .modelling-editorial :global(img) { display: block; inline-size: 100%; block-size: auto; }
  .modelling-editorial figcaption { margin-block-start: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
