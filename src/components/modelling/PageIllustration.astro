---
import CampaignThemeImage from '../campaign/CampaignThemeImage.astro';
import type { PageArtwork } from '@/lib/modelling-page-artwork';

interface Props { artwork: PageArtwork; }
const { artwork } = Astro.props;
---

<figure class="modelling-page-illustration" data-modelling-illustration={artwork.route}>
  <CampaignThemeImage lightSrc={artwork.light.file} darkSrc={artwork.dark.file}
    alt={artwork.alt} width={artwork.light.width} height={artwork.light.height}
    loading="eager" fetchpriority="high" />
</figure>

<style>
  .modelling-page-illustration {
    inline-size: 100%;
    max-inline-size: min(100%, var(--editorial-text-max, 64rem));
    margin-inline: 0 auto;
  }
  .modelling-page-illustration :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
