---
import { randomUUID } from 'node:crypto';
import VisualFrame from './VisualFrame.astro';
import VisualNode from './VisualNode.astro';
import VisualEdge from './VisualEdge.astro';

interface Props { kind: string; }
const { kind } = Astro.props;
const prefix = 'modelling-' + randomUUID();
const figures: Record<string, { title: string; description: string; eyebrow: string; takeaway: string[] }> = {
  'identity-map': {
    title: 'One situation, distinct identities',
    description: 'Harbour Court contains two dwellings; its title record and address description are separate resources, and sharing a location does not make them identical.',
    eyebrow: 'CONTAINMENT / DISTINCT IDENTITIES',
    takeaway: ['Containment means “contains”, not “is the same as”. The title and address remain separate.', 'A shared address helps locate descriptions; it is not an identity criterion.'],
  },
  'evidence-timeline': {
    title: 'An inspection is not a report version',
    description: 'An inspection on 12 August is described by a report issued on 14 August and corrected on 20 August; proportional dates distinguish the event from its document versions.',
    eyebrow: 'TIMELINE / AUGUST 2026',
    takeaway: ['The dates are proportional: two days to the first report, then six days to its correction.', 'A receiving system may record the correction later. Recording time is another clock.'],
  },
  'concept-layers': {
    title: 'A dwelling, a concept and a label',
    description: 'Flat 1 is classified using the concept flat, which has the preferred label “Flat” and the broader concept dwelling; classification is not physical containment or class inheritance.',
    eyebrow: 'RELATIONSHIPS / THREE DIFFERENT KINDS OF THING',
    takeaway: ['Changing a label does not replace the dwelling or the concept.', '“Broader” organises concepts. It does not mean “part of the building” or class inheritance.'],
  },
  'context-mapping-bridge': {
    title: 'Two levels of agreement',
    description: 'Surveying and transaction-assessment are neutral participants in a strategic agreement that references only the applicable qualified term-mapping records.',
    eyebrow: 'ARCHITECTURE / STRATEGIC AGREEMENT AND TERM MAPPING',
    takeaway: ['The participant lines assert no dependency direction.', 'A strategic agreement references particular applicable mappings, not an entire set by default.'],
  },
  'semantic-layers': {
    title: 'Four different questions for software',
    description: 'Assertions carry meaning, applicability hints describe intended use, constraints check supplied data and declared rules derive traceable facts; these are distinct jobs, not approval stages.',
    eyebrow: 'ARCHITECTURE / FOUR CONTRACTS, NOT FOUR STAGES',
    takeaway: ['RDF, RDFS and OWL keep their semantics even when a local reasoner is switched off.', 'Checks provide evidence; derivation adds facts. Neither establishes truth or human adoption.'],
  },
  'role-phase': {
    title: 'Participation is not a new person',
    description: 'One person can participate as seller in sale A and buyer in sale B at the same time without acquiring a different personal identity.',
    eyebrow: 'RELATIONSHIPS / ONE IDENTITY, TWO PARTICIPATIONS',
    takeaway: ['The roles can coexist because they are scoped to different transactions.', 'Class-level roleOf annotations do not, by themselves, encode these participation records.'],
  },
  'workflow-states': {
    title: 'A workflow state is not automatically a phase',
    description: 'An illustrative review record moves from draft through review to a recorded disposition; those workflow labels do not establish ontological phases or implementation status.',
    eyebrow: 'STATE MACHINE / A DIFFERENT SUBJECT: THE REVIEW RECORD',
    takeaway: ['This is an illustrative lifecycle, not a deployed review workflow.', 'A status label is not automatically phaseOf. Identity and phase criteria need separate analysis.'],
  },
  'mapping-gates': {
    title: 'A mapping can be refused',
    description: 'Compare meanings and identity criteria before selecting a correspondence; incompatible or unresolved identity stops equivalence, while a supported relation needs a qualified record.',
    eyebrow: 'DECISION FLOW / IDENTITY BEFORE EQUIVALENCE',
    takeaway: ['A failed or unresolved identity comparison stops an equivalence assertion.', 'Consider a weaker justified correspondence or record no mapping. Do not force equivalence.'],
  },
  'candidate-loop': {
    title: 'A question becomes a reviewable candidate',
    description: 'Questions and examples lead to explicit distinctions and checks; human review records a disposition, and a requested revision returns a changed candidate for further questions.',
    eyebrow: 'FLOWCHART / REVIEWABLE WORK, NOT AUTOMATIC APPROVAL',
    takeaway: ['Passing checks is evidence, not permission to adopt a standard.', 'Human review can accept, revise or decline; the return path represents requested revision.'],
  },
  'policy-boundaries': {
    title: 'Description is not enforcement',
    description: 'Sensitivity annotations inform human-governed policy, while application controls must enforce permitted use; descriptive labels alone do not authorise access.',
    eyebrow: 'ARCHITECTURE / DESCRIBE, DECIDE, ENFORCE',
    takeaway: ['A connected model does not make private evidence public.', 'Policy decisions and operational enforcement need their own authority and evidence.'],
  },
  'scope-map': {
    title: 'Eight concerns, one connected package',
    description: 'The eight selected concerns apply across one connected semantic package; each needs an explicit disposition, not a separate mandatory file or ontology.',
    eyebrow: 'SCOPE / EIGHT CROSS-CUTTING CONCERNS',
    takeaway: ['Lines mean “assess across this package”. They are not separate artefact-production pipelines.', 'Record each disposition: model here, reuse shared, boundary contribution or justified non-applicability.'],
  },
};
const keys = kind === 'role-phase' ? ['role-phase', 'workflow-states'] : [kind];
if (keys.some((key) => !Object.hasOwn(figures, key))) throw new Error('Unknown modelling diagram: ' + kind);
---

{keys.map((key) => {
  const id = prefix + '-' + key;
  return <VisualFrame id={id} {...figures[key]}>
    {key === 'identity-map' && <>
      <VisualEdge id={id} path="M480 192H648" arrow={false} dashed label="NOT SAME AS" box={[504, 160, 120]} />
      <path d="M592 184V200" class="mv-stop" />
      <rect x="40" y="120" width="440" height="344" rx="4" class="mv-containment" />
      <text x="64" y="152" class="mv-tag">BUILDING / CONTAINS TWO DWELLINGS</text>
      <text x="64" y="192" class="mv-title">Harbour Court</text>
      <text x="64" y="224" class="mv-note">One building, not one undifferentiated “property”.</text>
      <VisualNode x={64} y={272} width={176} height={144} tag="DWELLING" name="Flat 1" notes={['dwelling-1']} technical />
      <VisualNode x={280} y={272} width={176} height={144} tag="DWELLING" name="Flat 2" notes={['dwelling-2']} technical />
      <VisualNode x={648} y={120} width={272} height={144} tag="RECORD" name="Title record" notes={['Its own identity']} shape="document" tone="quiet" />
      <VisualNode x={648} y={320} width={272} height={144} tag="DESCRIPTION" name="Address" notes={['14 Orchard Road']} shape="document" tone="quiet" />
    </>}

    {key === 'evidence-timeline' && <>
      <path d="M96 292H864" class="mv-line" />
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((day) => <path d={'M' + (96 + day * 96) + ' 284V300'} class="mv-rule" />)}
      <path d="M96 184V288M288 296V364M864 184V284" class="mv-line" />
      <circle cx="96" cy="292" r="4" class="mv-dot" />
      <circle cx="288" cy="292" r="4" class="mv-dot" />
      <circle cx="864" cy="292" r="8" class="mv-accent" />
      {[[96, '12 AUG'], [288, '14 AUG'], [864, '20 AUG']].map(([x, label]) => <text x={x} y="332" text-anchor="middle" class="mv-technical">{label}</text>)}
      <text x="40" y="112" class="mv-tag">EVENT</text>
      <text x="40" y="144" class="mv-title">Inspection takes place</text>
      <text x="40" y="172" class="mv-note">What happened at the dwelling</text>
      <text x="224" y="392" class="mv-tag">DOCUMENT / FIRST ISSUE</text>
      <text x="224" y="424" class="mv-title">Report v1</text>
      <text x="224" y="452" class="mv-note">A description of that inspection</text>
      <text x="632" y="112" class="mv-tag">DOCUMENT / CORRECTION</text>
      <text x="632" y="144" class="mv-title">Report v2</text>
      <text x="632" y="172" class="mv-note">Corrects v1, not the past event</text>
    </>}

    {key === 'concept-layers' && <>
      <VisualEdge id={id} path="M240 196H376" label="CLASSIFIED AS" box={[252, 164, 112]} />
      <VisualEdge id={id} path="M584 196H744" label="PREF. LABEL" box={[604, 164, 120]} />
      <VisualEdge id={id} path="M480 276V360" label="BROADER" box={[488, 304, 112]} />
      <VisualNode x={40} y={116} width={200} height={160} tag="INDIVIDUAL" name="Flat 1" notes={['dwelling-1']} technical />
      <VisualNode x={376} y={116} width={208} height={160} tag="CONCEPT" name="Flat" notes={['Agreed meaning']} tone="focal" />
      <VisualNode x={744} y={116} width={176} height={160} tag="LABEL" name="“Flat”" notes={['English / @en']} technical tone="quiet" />
      <VisualNode x={376} y={360} width={208} height={112} tag="CONCEPT" name="Dwelling" notes={['Broader meaning']} />
    </>}

    {key === 'context-mapping-bridge' && <>
      <VisualEdge id={id} path="M256 184H392" arrow={false} label="PARTICIPANT" box={[272, 152, 104]} />
      <VisualEdge id={id} path="M568 184H704" arrow={false} label="PARTICIPANT" box={[584, 152, 104]} />
      <VisualEdge id={id} path="M480 248V352" label="REFERENCES" box={[488, 280, 128]} />
      <VisualNode x={40} y={104} width={216} height={144} tag="CONTEXT" name="Surveying" notes={['Owns its meanings']} />
      <VisualNode x={392} y={104} width={176} height={144} tag="STRATEGIC" name="Agreement" notes={['Obligations']} tone="focal" />
      <VisualNode x={704} y={104} width={216} height={144} tag="CONTEXT" name={['Transaction', 'assessment']} notes={['Owns its meanings']} />
      <text x="40" y="320" class="mv-tag">TERM LEVEL</text>
      <VisualNode x={280} y={352} width={400} height={128} tag="QUALIFIED MAPPING RECORD" name="Term correspondence" notes={['subject · predicate · object', 'versions · rationale · release']} technical shape="document" />
    </>}

    {key === 'semantic-layers' && <>
      <VisualEdge id={id} path="M328 184H600" arrow={false} label="DOCUMENTS USE" box={[400, 152, 128]} />
      <VisualEdge id={id} path="M144 256V304Q144 312 152 312H172Q180 312 180 320V356" label="CHECK" box={[192, 312, 80]} />
      <VisualEdge id={id} path="M272 256V280Q272 288 280 288H732Q740 288 740 296V356" label="DERIVE" box={[752, 312, 96]} />
      <VisualNode x={40} y={112} width={288} height={144} tag="ASSERTIONS / MEANING" name="What the graph says" notes={['RDF / RDFS', 'Bounded OWL profile']} technical tone="focal" />
      <VisualNode x={600} y={112} width={320} height={144} tag="APPLICABILITY / INTENDED USE" name="Where properties apply" notes={['Schema.org inclusion hints', 'Not validation constraints']} shape="document" />
      <VisualNode x={40} y={356} width={360} height={128} tag="CONSTRAINTS / SHACL PROFILE" name="Check supplied data" notes={['Conforms to the stated checks?', 'Not proof of truth']} />
      <VisualNode x={560} y={356} width={360} height={128} tag="DERIVATION / DECLARED RULES" name="Derive additional facts" notes={['Separate, traceable results', 'Not human adoption']} shape="document" />
    </>}

    {key === 'role-phase' && <>
      <VisualEdge id={id} path="M360 208H176Q168 208 168 216V336" label="PARTICIPATES" box={[40, 256, 112]} />
      <VisualEdge id={id} path="M600 208H784Q792 208 792 216V336" label="PARTICIPATES" box={[808, 256, 112]} />
      <VisualNode x={360} y={128} width={240} height={160} tag="PERSON / SAME IDENTITY" name="One person" notes={['person-1']} technical tone="focal" />
      <VisualNode x={40} y={336} width={256} height={128} tag="SALE A" name="Seller" notes={['A scoped participation']} />
      <VisualNode x={664} y={336} width={256} height={128} tag="SALE B" name="Buyer" notes={['Another participation']} />
    </>}

    {key === 'workflow-states' && <>
      <text x="40" y="128" class="mv-title">The record changes status.</text>
      <text x="40" y="164" class="mv-note">This says nothing, by itself, about the ontological phase of a person or property.</text>
      <VisualEdge id={id} path="M56 312H96" />
      <VisualEdge id={id} path="M296 312H384" label="REVIEW" box={[304, 280, 72]} />
      <VisualEdge id={id} path="M592 312H712" label="RECORD" box={[608, 280, 88]} />
      <circle cx="56" cy="312" r="4" class="mv-dot" />
      <VisualNode x={96} y={256} width={200} height={112} tag="REVIEW RECORD" name="Draft" shape="state" />
      <VisualNode x={384} y={256} width={208} height={112} tag="REVIEW RECORD" name="Under review" shape="state" tone="focal" />
      <VisualNode x={712} y={256} width={208} height={112} tag="REVIEW RECORD" name={['Recorded', 'disposition']} shape="state" />
    </>}

    {key === 'mapping-gates' && <>
      <VisualEdge id={id} path="M480 176V216" />
      <VisualEdge id={id} path="M600 288H712" label="YES" box={[632, 256, 64]} />
      <VisualEdge id={id} path="M480 360V420" label={['NO OR', 'UNRESOLVED']} box={[488, 368, 128]} />
      <VisualNode x={320} y={88} width={320} height={88} name="Compare meanings" notes={['More than a label match']} />
      <path d="M480 216 600 288 480 360 360 288Z" class="mv-decision" />
      <text x="480" y="280" text-anchor="middle" class="mv-label">Identity</text>
      <text x="480" y="304" text-anchor="middle" class="mv-label">compatible?</text>
      <VisualNode x={712} y={240} width={208} height={128} tag="SUPPORTED" name="Select relation" notes={['Then qualify', 'the record']} shape="document" />
      <VisualNode x={296} y={420} width={368} height={72} name="Do not assert equivalence" tone="quiet" />
    </>}

    {key === 'candidate-loop' && <>
      <VisualEdge id={id} path="M248 176H376" />
      <VisualEdge id={id} path="M584 176H712" />
      <VisualEdge id={id} path="M816 240V352" label="REVIEW" box={[828, 280, 80]} />
      <VisualEdge id={id} path="M712 420H584" label="DISPOSITION" box={[600, 388, 96]} />
      <VisualEdge id={id} path="M376 420H144Q136 420 136 412V240" dashed label="REVISE" box={[232, 388, 104]} />
      <VisualNode x={40} y={104} width={208} height={136} tag="01 / INPUT" name="A useful question" notes={['Practitioner + examples']} />
      <VisualNode x={376} y={104} width={208} height={136} tag="02 / DISTINCTIONS" name="Explicit meaning" notes={['Identity', 'Relationships']} />
      <VisualNode x={712} y={104} width={208} height={136} tag="03 / CHECKS" name="Challenge it" notes={['Profile + test cases', 'Counterexamples']} />
      <VisualNode x={712} y={352} width={208} height={136} tag="04 / HUMAN REVIEW" name="Record judgement" notes={['Accept, revise', 'or decline']} tone="focal" />
      <VisualNode x={376} y={352} width={208} height={136} tag="05 / REVISION" name={['Revised', 'candidate']} notes={['Open issues retained']} shape="document" />
    </>}

    {key === 'policy-boundaries' && <>
      <VisualEdge id={id} path="M272 236H352" label="INFORMS" box={[280, 204, 64]} />
      <VisualEdge id={id} path="M632 236H720" label="ENFORCE" box={[640, 204, 72]} />
      <VisualNode x={40} y={148} width={232} height={176} tag="MODEL ANNOTATION" name={['Describe', 'sensitivity']} notes={['DPV / local classes', 'Purpose + conditions']} shape="document" />
      <path d="M492 148 632 236 492 324 352 236Z" class="mv-decision" />
      <text x="492" y="128" text-anchor="middle" class="mv-tag">HUMAN-GOVERNED POLICY</text>
      <text x="492" y="228" text-anchor="middle" class="mv-label">Decide</text>
      <text x="492" y="252" text-anchor="middle" class="mv-label">permitted use</text>
      <VisualNode x={720} y={148} width={200} height={176} tag="APPLICATION" name={['Permit', 'or deny']} notes={['Enforce the policy', 'Record the outcome']} />
      <text x="40" y="424" class="mv-title">A label grants no access.</text>
      <text x="40" y="460" class="mv-note">The annotation describes information. The application must enforce the policy.</text>
    </>}

    {key === 'scope-map' && <>
      {[
        'M132 208V232Q132 240 140 240H320Q328 240 328 248V264',
        'M364 208V232Q364 240 372 240H400Q408 240 408 248V264',
        'M596 208V232Q596 240 588 240H560Q552 240 552 248V264',
        'M828 208V232Q828 240 820 240H640Q632 240 632 248V264',
        'M328 352V360Q328 368 320 368H140Q132 368 132 376V384',
        'M408 352V360Q408 368 400 368H372Q364 368 364 376V384',
        'M552 352V360Q552 368 560 368H588Q596 368 596 376V384',
        'M632 352V360Q632 368 640 368H820Q828 368 828 376V384',
      ].map((path) => <VisualEdge id={id} path={path} arrow={false} />)}
      {[
        [1, ['Domain', 'structure']], [2, ['Vocabulary', 'and taxonomy']],
        [5, ['Classification']], [7, ['Validation']],
        [8, ['Mappings']], [9, ['Provenance', 'and quality']],
        [10, ['Time and', 'history']], [11, ['Sensitivity', 'and access']],
      ].map(([number, name], index) => <VisualNode x={40 + (index % 4) * 232} y={index < 4 ? 96 : 384} width={184} height={112} tag={'CATEGORY ' + number} name={name as string[]} tone="quiet" />)}
      <VisualNode x={272} y={264} width={416} height={88} name="One connected package" notes={['Assess every concern; record its disposition.']} tone="focal" />
    </>}
  </VisualFrame>;
})}
