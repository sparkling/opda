---
/**
 * Temporary anonymous comment reader during the identity migration.
 * Member mutations are also blocked at CloudFront and the comments origin.
 * No Artalk widget is mounted: it would restore browser tokens and emit writes.
 */
import { getLegacyCommentKey } from '@/lib/site-route-migrations.mjs';
const commentPageKey = getLegacyCommentKey(Astro.url.pathname);
---
<section class="comments-section" aria-label="Comments" data-comment-page-key={commentPageKey}>
  <h2 class="comments-section__heading">Comments</h2>
  <p class="comments-section__notice">Comments are temporarily read-only while sign-in is upgraded.</p>
  <div id="opda-comments" class="comments-section__widget">
    <div id="opda-comments-list" class="comments-section__list"></div>
    <p id="opda-comments-status" role="status">Loading comments…</p>
    <button id="opda-comments-more" class="btn btn--compact" type="button" hidden>Load more comments</button>
  </div>
</section>

<script>
  let controller;
  let observedContainer;
  let observer;

  function clearLegacyCommentSession() {
    try { window.localStorage.removeItem('ArtalkUser'); } catch { /* Reading never uses storage. */ }
  }

  function stop() {
    controller?.abort();
    observer?.disconnect();
    controller = undefined;
    observer = undefined;
    observedContainer = undefined;
  }

  function commentElement(comment) {
    const article = document.createElement('article');
    article.className = 'comments-section__entry';
    article.id = 'atk-comment-' + comment.id;
    const header = document.createElement('header');
    const author = document.createElement('strong');
    author.textContent = typeof comment.nick === 'string' ? comment.nick.slice(0, 256) : 'Participant';
    header.append(author);
    const date = new Date(comment.date);
    if (Number.isFinite(date.getTime())) {
      const time = document.createElement('time');
      time.dateTime = date.toISOString();
      time.textContent = date.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
      header.append(time);
    }
    article.append(header);
    if (Number.isSafeInteger(comment.rid) && comment.rid > 0) {
      const reply = document.createElement('p');
      reply.className = 'comments-section__reply';
      reply.textContent = 'Reply to comment #' + comment.rid;
      article.append(reply);
    }
    const content = document.createElement('p');
    content.className = 'comments-section__content';
    // Raw text is intentional during migration; never execute returned HTML/Markdown.
    content.textContent = comment.content;
    article.append(content);
    return article;
  }

  function arm() {
    clearLegacyCommentSession();
    const container = document.getElementById('opda-comments');
    if (!container || observedContainer === container) return;
    stop();
    observedContainer = container;
    controller = new AbortController();
    const signal = controller.signal;
    const list = document.getElementById('opda-comments-list');
    const status = document.getElementById('opda-comments-status');
    const more = document.getElementById('opda-comments-more');
    if (!list || !status || !(more instanceof HTMLButtonElement)) return;
    const pageKey = document.querySelector('.comments-section')?.dataset.commentPageKey || window.location.pathname;
    let offset = 0;
    let busy = false;
    const seen = new Set();
    list.replaceChildren();
    more.hidden = true;

    async function load() {
      if (busy || signal.aborted) return;
      busy = true;
      more.disabled = true;
      status.textContent = 'Loading comments…';
      try {
        const target = new URL('/api/v2/comments', window.location.origin);
        target.search = new URLSearchParams({
          page_key: pageKey, site_name: 'OPDA', limit: '20', offset: String(offset),
          flat_mode: 'true', sort_by: 'date_asc',
        }).toString();
        const response = await fetch(target.toString(), {
          method: 'GET', credentials: 'omit', cache: 'no-store', redirect: 'error',
          headers: { accept: 'application/json' }, signal,
        });
        if (!response.ok) throw new Error('Comments unavailable');
        const body = await response.json();
        const data = body.data ?? body;
        if (!Array.isArray(data.comments) || data.comments.length > 50
          || !Number.isSafeInteger(data.count) || data.count < 0) throw new Error('Invalid comment response');
        if (signal.aborted) return;
        for (const comment of data.comments) {
          if (!Number.isSafeInteger(comment?.id) || comment.id < 1 || typeof comment.content !== 'string'
            || comment.content.length > 100000) throw new Error('Invalid comment');
        }
        for (const comment of data.comments) {
          if (seen.has(comment.id)) continue;
          seen.add(comment.id);
          list.append(commentElement(comment));
        }
        offset += data.comments.length;
        more.hidden = data.comments.length === 0 || offset >= data.count;
        more.textContent = 'Load more comments';
        status.textContent = seen.size === 0 ? 'No comments yet.' : '';
      } catch {
        if (signal.aborted) return;
        status.textContent = 'Comments are temporarily unavailable. Please try again.';
        more.textContent = 'Try again';
        more.hidden = false;
      } finally {
        busy = false;
        more.disabled = false;
      }
    }
    more.addEventListener('click', () => { void load(); });
    if (typeof IntersectionObserver === 'undefined') {
      void load();
    } else {
      observer = new IntersectionObserver((entries) => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer?.disconnect();
          observer = undefined;
          void load();
        }
      }, { rootMargin: '600px 0px' });
      observer.observe(container);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', arm);
  else arm();
  document.addEventListener('astro:page-load', arm);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  .comments-section__notice { margin-block: 1rem; }
  .comments-section__list :global(.comments-section__entry) { border-block-start: 1px solid var(--color-border); padding-block: 1rem; }
  .comments-section__list :global(header) { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; }
  .comments-section__list :global(time), .comments-section__list :global(.comments-section__reply) { font-size: 0.875rem; }
  .comments-section__list :global(.comments-section__content) { white-space: pre-wrap; overflow-wrap: anywhere; margin-block: 0.75rem 0; }
</style>
