---
/**
 * Member comments use the same opaque, HttpOnly session as the website.
 * No provider or Artalk bearer token is exposed to the browser.
 */
import { getLegacyCommentKey } from '@/lib/site-route-migrations.mjs';
const commentPageKey = getLegacyCommentKey(Astro.url.pathname);
---
<section id="comments" class="comments-section" aria-label="Comments" data-comment-page-key={commentPageKey}>
  <h2 class="comments-section__heading">Comments</h2>
  <div id="opda-comments" class="comments-section__widget">
    <div id="opda-comments-list" class="comments-section__list"></div>
    <p id="opda-comments-status" role="status">Loading comments…</p>
    <button id="opda-comments-more" class="btn btn--compact" type="button" hidden>Load more comments</button>
    <a id="opda-comments-sign-in" href={`/_auth/login?return=${encodeURIComponent(Astro.url.pathname + '#comments')}`} hidden>Sign in to post a comment</a>
    <form id="opda-comments-form" class="comments-section__form" hidden>
      <p id="opda-comments-author"></p>
      <p id="opda-comments-reply" hidden></p>
      <label for="opda-comments-content">Your comment</label>
      <textarea id="opda-comments-content" name="content" rows="5" maxlength="5000" required placeholder="Share a question, an observation or evidence that will help improve this page."></textarea>
      <div class="comments-section__actions">
        <button id="opda-comments-submit" class="btn btn--compact" type="submit">Post comment</button>
        <button id="opda-comments-cancel" class="btn btn--compact btn--ghost" type="button" hidden>Cancel reply</button>
      </div>
    </form>
  </div>
</section>

<script>
  let controller;
  let observedContainer;
  let observer;
  let pendingArm;
  let waitingForWindowLoad = false;

  function cancelPendingArm() {
    if (pendingArm !== undefined) {
      window.clearTimeout(pendingArm);
      pendingArm = undefined;
    }
    if (waitingForWindowLoad) {
      window.removeEventListener('load', afterWindowLoad);
      waitingForWindowLoad = false;
    }
  }

  function afterWindowLoad() {
    waitingForWindowLoad = false;
    scheduleArm();
  }

  function clearLegacyCommentSession() {
    try { window.localStorage.removeItem('ArtalkUser'); } catch { /* Reading never uses storage. */ }
  }

  function stop() {
    cancelPendingArm();
    controller?.abort();
    observer?.disconnect();
    controller = undefined;
    observer = undefined;
    observedContainer = undefined;
  }

  function commentElement(comment, onReply, signal) {
    const article = document.createElement('article');
    article.className = 'comments-section__entry';
    article.id = 'atk-comment-' + comment.id;
    const header = document.createElement('header');
    const author = document.createElement('strong');
    author.textContent = typeof comment.nick === 'string' ? comment.nick.slice(0, 256) : 'Participant';
    header.append(author);
    const date = new Date(comment.date);
    if (Number.isFinite(date.getTime())) {
      const time = document.createElement('time');
      time.dateTime = date.toISOString();
      time.textContent = date.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
      header.append(time);
    }
    article.append(header);
    if (Number.isSafeInteger(comment.rid) && comment.rid > 0) {
      const reply = document.createElement('p');
      reply.className = 'comments-section__reply';
      reply.textContent = 'Reply to comment #' + comment.rid;
      article.append(reply);
    }
    const content = document.createElement('p');
    content.className = 'comments-section__content';
    // Comments are plain text: never execute returned HTML/Markdown.
    content.textContent = comment.content;
    article.append(content);
    const reply = document.createElement('button');
    reply.type = 'button';
    reply.className = 'btn btn--compact btn--ghost';
    reply.textContent = 'Reply';
    reply.addEventListener('click', () => onReply(comment), { signal });
    article.append(reply);
    return article;
  }

  function arm() {
    clearLegacyCommentSession();
    const container = document.getElementById('opda-comments');
    if (!container || observedContainer === container) return;
    stop();
    observedContainer = container;
    controller = new AbortController();
    const signal = controller.signal;
    const list = document.getElementById('opda-comments-list');
    const status = document.getElementById('opda-comments-status');
    const more = document.getElementById('opda-comments-more');
    const form = document.getElementById('opda-comments-form');
    const content = document.getElementById('opda-comments-content');
    const submit = document.getElementById('opda-comments-submit');
    const author = document.getElementById('opda-comments-author');
    const replyLabel = document.getElementById('opda-comments-reply');
    const cancel = document.getElementById('opda-comments-cancel');
    const signIn = document.getElementById('opda-comments-sign-in');
    if (!list || !status || !more || !form || !content || !submit || !author || !replyLabel || !cancel || !signIn) return;
    const pageKey = document.querySelector('.comments-section')?.dataset.commentPageKey || window.location.pathname;
    let offset = 0;
    let busy = false;
    let posting = false;
    let replyId = 0;
    const seen = new Set();
    list.replaceChildren();
    more.hidden = true;
    form.hidden = true;
    signIn.hidden = true;

    function replyTo(comment) {
      if (form.hidden) { signIn.focus(); return; }
      replyId = comment.id;
      replyLabel.textContent = 'Replying to comment #' + comment.id + ' by ' + comment.nick;
      replyLabel.hidden = false;
      cancel.hidden = false;
      content.focus();
    }

    function cancelReply() {
      replyId = 0;
      replyLabel.hidden = true;
      cancel.hidden = true;
    }

    function denied() {
      form.hidden = true;
      signIn.hidden = false;
      status.textContent = 'Please sign in with an approved account to post comments.';
    }

    async function load() {
      if (busy || signal.aborted) return;
      busy = true;
      more.disabled = true;
      status.textContent = 'Loading comments…';
      try {
        const target = new URL('/api/v2/comments', window.location.origin);
        target.search = new URLSearchParams({
          page_key: pageKey, site_name: 'OPDA', limit: '20', offset: String(offset),
          flat_mode: 'true', sort_by: 'date_asc',
        }).toString();
        const response = await fetch(target.toString(), {
          method: 'GET', credentials: 'same-origin', cache: 'no-store', redirect: 'error',
          headers: { accept: 'application/json' }, signal,
        });
        if (response.status === 401 || response.status === 403) { denied(); return; }
        if (!response.ok) throw new Error('Comments unavailable');
        const body = await response.json();
        const data = body.data ?? body;
        if (!Array.isArray(data.comments) || data.comments.length > 50
          || !Number.isSafeInteger(data.count) || data.count < 0) throw new Error('Invalid comment response');
        if (signal.aborted) return;
        for (const comment of data.comments) {
          if (!Number.isSafeInteger(comment?.id) || comment.id < 1 || typeof comment.content !== 'string'
            || comment.content.length > 100000) throw new Error('Invalid comment');
        }
        for (const comment of data.comments) {
          if (seen.has(comment.id)) continue;
          seen.add(comment.id);
          list.append(commentElement(comment, replyTo, signal));
        }
        offset += data.comments.length;
        more.hidden = data.comments.length === 0 || offset >= data.count;
        more.textContent = 'Load more comments';
        status.textContent = seen.size === 0 ? 'No comments yet.' : '';
        const canPost = typeof data.viewer?.name === 'string' && !!data.viewer.name;
        author.textContent = canPost ? 'Commenting as ' + data.viewer.name : '';
        form.hidden = !canPost;
        signIn.hidden = canPost;
        return true;
      } catch {
        if (signal.aborted) return;
        status.textContent = 'Comments are temporarily unavailable. Please try again.';
        more.textContent = 'Try again';
        more.hidden = false;
      } finally {
        busy = false;
        more.disabled = false;
      }
    }
    more.addEventListener('click', () => { void load(); }, { signal });
    cancel.addEventListener('click', cancelReply, { signal });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const text = content.value.trim();
      if (posting || busy || !text || text.length > 5000 || signal.aborted) return;
      posting = true;
      submit.disabled = true;
      more.disabled = true;
      status.textContent = 'Posting your comment…';
      try {
        const response = await fetch('/api/v2/comments', {
          method: 'POST', credentials: 'same-origin', cache: 'no-store', redirect: 'error',
          headers: { accept: 'application/json', 'content-type': 'application/json' }, signal,
          body: JSON.stringify({ page_key: pageKey, content: text, rid: replyId }),
        });
        if (response.status === 401 || response.status === 403) { denied(); return; }
        if (!response.ok) throw new Error('Could not post');
        const result = await response.json();
        if (signal.aborted) return;
        const comment = result.data ?? result;
        if (!Number.isSafeInteger(comment.id) || comment.id < 1) throw new Error('Invalid response');
        content.value = '';
        cancelReply();
        list.replaceChildren(); seen.clear(); offset = 0;
        const refreshed = await load();
        if (!form.hidden && !signal.aborted) {
          status.textContent = (comment.is_pending ? 'Your comment has been submitted for review.' : 'Your comment has been posted.')
            + (refreshed ? '' : ' The list could not be refreshed; use Try again to reload it.');
        }
      } catch {
        if (!signal.aborted) status.textContent = 'Your comment could not be confirmed. Your text has been kept; check the discussion before trying again.';
      } finally {
        posting = false;
        submit.disabled = false;
        more.disabled = false;
      }
    }, { signal });
    if (typeof IntersectionObserver === 'undefined') {
      void load();
    } else {
      observer = new IntersectionObserver((entries) => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer?.disconnect();
          observer = undefined;
          void load();
        }
      }, { rootMargin: '600px 0px' });
      observer.observe(container);
    }
  }

  function scheduleArm() {
    if (document.readyState !== 'complete') {
      if (!waitingForWindowLoad) {
        waitingForWindowLoad = true;
        window.addEventListener('load', afterWindowLoad, { once: true });
      }
      return;
    }
    if (pendingArm !== undefined) return;
    pendingArm = window.setTimeout(() => {
      pendingArm = undefined;
      arm();
    }, 0);
  }

  scheduleArm();
  document.addEventListener('astro:page-load', scheduleArm);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  .comments-section__widget { max-width: 1024px; }
  .comments-section__form { margin-block-start: 2rem; }
  .comments-section__form label { display: block; margin-block: 0.75rem; font-weight: 600; }
  .comments-section__form textarea { box-sizing: border-box; display: block; width: 100%; resize: vertical; min-height: 8rem; padding: 1rem; color: var(--color-text); background: var(--color-bg); border: 1px solid var(--color-border); font: inherit; }
  .comments-section__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 1rem; }
  .comments-section__list :global(.comments-section__entry) { border-block-start: 1px solid var(--color-border); padding-block: 1rem; }
  .comments-section__list :global(header) { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; }
  .comments-section__list :global(time), .comments-section__list :global(.comments-section__reply) { font-size: 0.875rem; }
  .comments-section__list :global(.comments-section__content) { white-space: pre-wrap; overflow-wrap: anywhere; margin-block: 0.75rem 0; }
</style>
