---
/**
 * Section sidebar — left rail with active page tracking and nested folders.
 * Renders at build time. The active page is derived from Astro.url.pathname;
 * folders containing the active page render as open. Folder labels are links,
 * so hierarchy disclosure follows navigation rather than separate controls.
 *
 * Renders nothing for URLs not in any section (e.g. top-level pages like
 * /glossary, /design-system, or the home page).
 */
import type { Item } from '@/lib/site';
import { normalizeUrl } from '@/lib/site';
import { findNavigationPage, getNavigationSection } from '@/lib/site-navigation';
import { PDTF1_ROUTES } from '@/lib/pdtf1-routes.mjs';
import SidebarItem from './SidebarItem.astro';

const path = normalizeUrl(Astro.url.pathname);
const section = getNavigationSection(path);
const sectionKey = section?.key ?? null;
const match = findNavigationPage(path);
const activePath = normalizeUrl(match?.trail.at(-1)?.url ?? match?.group.url ?? '');

function containsActive(item: Item): boolean {
  const itemPath = normalizeUrl(item.url);
  if (itemPath === activePath) return true;
  if (item.children) return item.children.some(containsActive);
  return false;
}
---
{section && (
  <aside class="app-sidebar" id="app-sidebar">
    <button
      type="button"
      class="rail-collapse-toggle"
      id="sidebar-collapse"
      aria-controls="section-navigation"
      aria-expanded="true"
    >
      <span class="rail-collapse-toggle__label">In this section</span>
      <svg class="rail-collapse-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <g class="rail-glyph rail-glyph--toward-start">
          <polyline points="13 6 7 12 13 18"/>
          <polyline points="19 6 13 12 19 18"/>
        </g>
        <g class="rail-glyph rail-glyph--toward-end">
          <polyline points="5 6 11 12 5 18"/>
          <polyline points="11 6 17 12 11 18"/>
        </g>
      </svg>
    </button>

    <nav
      class="sidebar-nav"
      id="section-navigation"
      data-section={sectionKey}
      aria-label={`${section.title} section`}
    >
      {section.groups.map(group => {
        const isActiveLocation = normalizeUrl(group.url) === activePath;
        const isActivePage = isActiveLocation && activePath === path;
        const containsActivePage = isActiveLocation || group.items.some(containsActive);
        const hasChildren = group.items.length > 0;
        const defaultOpen = hasChildren && containsActivePage;
        const emphasizeFolders = section.key === 'spdtf' && group.url === PDTF1_ROUTES.inputRoot;
        const namedGroupId = group.url === PDTF1_ROUTES.inputRoot
          ? 'section-nav-group-spdtf-inputs'
          : null;
        const childrenId = namedGroupId ?? `section-nav-group-${section.key}-${group.url}`
          .replace(/[^a-z0-9]+/giu, '-').replace(/^-|-$/gu, '');
        const leafGroupId = hasChildren ? undefined : new Map([
          ['/modelling/adr', 'section-nav-governance-modelling-adr'],
          ['/modelling/odr', 'section-nav-governance-modelling-odr'],
        ]).get(group.url);
        return (
          <section
            class={`nav-group${hasChildren ? '' : ' nav-group--leaf'}${emphasizeFolders ? ' has-emphasized-folders' : ''}${defaultOpen ? ' is-open' : ''}`}
            data-group={group.heading}
            data-active={containsActivePage ? 'true' : undefined}
          >
            {hasChildren ? (
              <>
                <div class={`nav-group-row${isActivePage ? ' is-active-page' : ''}`}>
                  <a
                    class={`nav-group-link${isActiveLocation ? ' active' : ''}`}
                    href={group.url}
                    aria-current={isActivePage ? 'page' : undefined}
                  >{group.heading}</a>
                </div>
                <ul class="tree nav-group-items" id={childrenId}>
                  {group.items.map(item => (
                    <SidebarItem
                      item={item}
                      activePath={activePath}
                      currentPath={path}
                      containsActive={containsActive}
                      emphasized={emphasizeFolders}
                    />
                  ))}
                </ul>
              </>
            ) : (
              <a
                id={leafGroupId}
                class={`nav-group-leaf${isActiveLocation ? ' active' : ''}`}
                href={group.url}
                aria-current={isActivePage ? 'page' : undefined}
              >{group.heading}</a>
            )}
          </section>
        );
      })}
    </nav>
  </aside>
)}
