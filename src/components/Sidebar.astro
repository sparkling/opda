---
/**
 * Section sidebar — left rail with active page tracking and collapsible
 * nested folders. Renders at build time. The active page is derived from
 * Astro.url.pathname; folders containing the active page render as open.
 *
 * Renders nothing for URLs not in any section (e.g. top-level pages like
 * /glossary, /design-system, or the home page).
 */
import type { Item } from '@/lib/site';
import { normalizeUrl } from '@/lib/site';
import { findNavigationPage, getNavigationSection } from '@/lib/site-navigation';
import SidebarItem from './SidebarItem.astro';

const path = normalizeUrl(Astro.url.pathname);
const section = getNavigationSection(path);
const sectionKey = section?.key ?? null;
const activePath = normalizeUrl(findNavigationPage(path)?.trail.at(-1)?.url ?? '');

function containsActive(item: Item): boolean {
  const itemPath = normalizeUrl(item.url);
  if (itemPath === activePath) return true;
  if (item.children) return item.children.some(containsActive);
  return false;
}
---
{section && (
  <aside class="app-sidebar" id="app-sidebar">
    <button
      type="button"
      class="rail-collapse-toggle"
      id="sidebar-collapse"
      aria-controls="section-navigation"
      aria-expanded="true"
      aria-label="Collapse sidebar"
      title="Collapse sidebar"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    <nav
      class="sidebar-nav"
      id="section-navigation"
      data-section={sectionKey}
      aria-label={`${section.title} section`}
    >
      <p class="sidebar-section-title">{section.title}</p>
      {section.groups.map(group => {
        const containsActivePage = group.items.some(containsActive);
        const defaultOpen = group.heading === 'Overview' || containsActivePage;
        return (
          <details class="nav-group" open={defaultOpen} data-group={group.heading} data-active={containsActivePage ? 'true' : undefined}>
            <summary>
              <svg class="nav-group-caret" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.25" stroke-linecap="round"
                   stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
              <span class="nav-group-label">{group.heading}</span>
            </summary>
            <ul class="tree">
              {group.items.map(item => <SidebarItem item={item} activePath={activePath} containsActive={containsActive} />)}
            </ul>
          </details>
        );
      })}
    </nav>
  </aside>
)}

{/* Recursive item — defined inline via a fragment script-style approach.
    Astro doesn't let us define recursive components inline cleanly without
    a separate file, so we delegate to SidebarItem.astro. */}
<script>
  // Reserved — see SidebarItem.astro for the recursive rendering.
</script>
